{
	// 公式サイト本体（Astro ＋ EmDash）を動かす Cloudflare Worker。配備手順は docs/emdash.md を参照。
	// D1（内容）と R2（アップロードした画像・PDF）は、最初の `wrangler deploy` で名前どおりに作られる。
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tcta-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tcta-site"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "tcta-site-media"
		}
	],
	// 予約公開・バックアップ・保守を動かす定期実行
	"triggers": {
		"crons": ["* * * * *"]
	},
	// 配備しても公開ページのキャッシュを捨てない（内容の公開時には EmDash がタグで無効化する）
	"cache": { "enabled": true, "cross_version_cache": true }
	// 隔離実行のプラグイン（Workers Paid プラン）を使うときだけ:
	// "worker_loaders": [{ "binding": "LOADER" }]
}
