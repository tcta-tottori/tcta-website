{
  "name": "tcta-tournament",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p worker/tsconfig.json",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "test": "node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test:auth": "node --experimental-strip-types --no-warnings scripts/auth.test.mts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "kuromoji": "^0.1.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "^4.155.0"
  },
  "description": "鳥取市テニス協会 大会運営システム（Cloudflare 版）"
}
