# =============================================
# ビルド時に埋め込まれる環境変数のサンプル（Cloudflare 版）
# 何も設定しなくても動く。ローカルで変えたいときだけ .env にコピーして値を入れる。
# =============================================

# 観戦配信・端末同期の中継の接続先。
# 空なら、開いている URL と同じ Worker の wss://<ホスト>/ws（Durable Object）につなぐ。
# 以前の Render の中継サーバーを使いたいときだけ wss://xxx.onrender.com を入れる。
VITE_SYNC_SERVER_URL=

# HP掲載用の固定観戦ルームコード（空なら TCTA01）。
VITE_PUBLIC_ROOM=

# ヘッダー・フッターの「協会サイト」の行き先（空なら開発中の公式サイト）。
VITE_SITE_URL=

# 音声コール（Gemini TTS）の鍵は、ビルドに埋め込まず Worker の secret に入れる:
#   npx wrangler secret put GEMINI_API_KEY
