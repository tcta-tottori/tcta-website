---
import Base from '../layouts/Base.astro';
import ScheduleCalendar from '../components/ScheduleCalendar.astro';
import TournamentList from '../components/TournamentList.astro';
import { siteData } from '../lib/cms.js';
import { SCHEDULE_PDF } from '../data/events.js';

const { SCHEDULE, SCHEDULE_NEXT } = await siteData(Astro);

const title = "大会情報｜鳥取市テニス協会";
const description = "令和8年度（2026年度）に鳥取市テニス協会が主催・主管する全19大会の一覧。エントリー締切・会場・登録区分を掲載しています。";

// 絞り込みチップの件数。手で数えると日程の更新のたびにずれるので、データから出す。
const count = {
  all: SCHEDULE.length,
  open: SCHEDULE.filter((t) => t.status === 'open').length,
  done: SCHEDULE.filter((t) => t.status === 'done').length,
  upcoming: SCHEDULE.filter((t) => t.status !== 'done').length,
};
---

<Base
  title={title}
  description={description}
  navActive="tournaments"
  mobileNavActive="tournaments"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">TOURNAMENT</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">大会情報</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">Tournament</p>
          <h1 class="page-title">大会情報</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">令和8年度（2026年度）に鳥取市テニス協会が主催・主管する大会の一覧です。エントリー締切、会場、必要な登録区分をあわせて掲載しています。日程は天候等により変更になる場合があります。</p>
    </div>
  </section>

  <!-- ============ 大会一覧 ============ -->
  <section class="section" aria-labelledby="r8-title">
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Schedule R8</p>
            <h2 class="sec-head__title" id="r8-title">令和8年度 大会一覧</h2>
          </div>
        </div>
      </div>

      <p class="note mt-24">要項・ドロー・結果は、掲載ずみのものだけボタンが押せます。申込用紙は要項のページに載せています。大会名をタップすると、その大会のページで全部まとめて見られます。</p>

      {/* 絞り込み（左）と表示の切り替え（右）。灰色の帯（ページ上部）には入れず、一覧のすぐ上に置く。
          表示の切り替えはこのページの大会一覧すべてに効く（main.js の initViewSwitch。選んだ方を覚えておく） */}
      <div class="tl-tools rv">
        {/* 絞り込みは1つの枠に並べた切り替え（1行）。件数は名前の右に小さく */}
        <div class="seg" data-filter-group data-filter-target="#r8-list" role="group" aria-label="大会一覧の絞り込み">
          <button class="chip seg__btn is-active" type="button" data-filter="all" aria-pressed="true">すべて<span class="seg__n">{count.all}</span></button>
          <button class="chip seg__btn" type="button" data-filter="upcoming" aria-pressed="false">開催前<span class="seg__n">{count.upcoming}</span></button>
          <button class="chip seg__btn" type="button" data-filter="open" aria-pressed="false">受付中<span class="seg__n">{count.open}</span></button>
          <button class="chip seg__btn" type="button" data-filter="done" aria-pressed="false">終了<span class="seg__n">{count.done}</span></button>
        </div>
        {/* 表示の切り替えは絵だけ（文字は読み上げ用とマウスを載せたときの説明） */}
        <div class="view-switch" role="group" aria-label="表示の切り替え" data-view-switch>
          <button class="view-switch__btn is-active" type="button" data-view="rows" aria-pressed="true" aria-label="縮小表示（一覧表）" title="縮小表示">
            <span class="view-switch__ico view-switch__ico--rows" aria-hidden="true"></span>
          </button>
          <button class="view-switch__btn" type="button" data-view="cards" aria-pressed="false" aria-label="拡大表示（カード）" title="拡大表示">
            <span class="view-switch__ico view-switch__ico--cards" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <TournamentList items={SCHEDULE} id="r8-list" caption="令和8年度 大会一覧" />
      <p class="note" id="r8-list-empty" hidden>該当する大会はありません。</p>


      <div class="rv mt-40">
        <a class="btn btn--outline" href={SCHEDULE_PDF.src} target="_blank" rel="noopener noreferrer">令和8年度 大会日程をダウンロード（PDF / {SCHEDULE_PDF.kb.toLocaleString()}KB）<span aria-hidden="true" class="text-red">↓</span></a>
      </div>

      <div class="rv" style="margin-top:64px">
        <h2 class="sub-head">令和9年度（先行案内）</h2>
        <TournamentList items={SCHEDULE_NEXT} caption="令和9年度 大会（先行案内）" />
      </div>

      <div class="rv panel panel--gray" style="margin-top:64px">
        <p class="panel__title">過去の大会</p>
        <p class="prose" style="margin:0">平成16年度から令和6年度までの大会は、大会結果のページに年度ごとにまとめています。種目ごとの成績と当日の写真をご覧いただけます。</p>
        <a class="ghost-link mt-24" href="results.html">大会結果を見る <span class="aw">→</span></a>
      </div>
    </div>
  </section>

  <!-- ============ 月ごとのカレンダー ============ -->
  <section class="section section--gray" id="calendar" aria-labelledby="cal-title">
    <span class="ghost" aria-hidden="true">CALENDAR</span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Calendar</p>
            <h2 class="sec-head__title" id="cal-title">大会カレンダー</h2>
          </div>
        </div>
      </div>
      <p class="sec-head__lead rv">令和8年度の大会を月ごとに並べています。開催日のほか、エントリー締切とドロー会議（締切の週の土曜 18:00〜、テニスショップ フラシーノ）の日も載せています。</p>

      <ScheduleCalendar />

    </div>
  </section>

</Base>
