---
import Base from '../layouts/Base.astro';
import { RESULTS, resultUrl, summarize, counts } from '../data/results.js';

const title = "大会結果｜鳥取市テニス協会";
const description = "鳥取市テニス協会が主催・主管した大会の結果。平成16年度から令和6年度まで、年度ごとの優勝・準優勝と大会写真を掲載しています。";

// 年度タブは新しい順。旧サイトから引き継いだ分をそのまま並べる。
const years = RESULTS;
const totalTournaments = years.reduce((n, y) => n + y.tournaments.length, 0);
const totalPhotos = years.reduce(
  (n, y) => n + y.tournaments.reduce((m, t) => m + t.photos.length, 0), 0);
---

<Base
  title={title}
  description={description}
  navActive="tournaments"
  mobileNavActive="tournaments"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">RESULTS</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">大会結果</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">Results</p>
          <h1 class="page-title" style="margin-top:8px">大会結果</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">これまでの大会結果です。年度を選ぶと、その年に行われた大会が並びます。大会名をひらくと、種目ごとの成績と当日の写真をご覧いただけます。</p>
    </div>
  </section>

  <section class="section" aria-labelledby="results-title">
    <div class="container">
      <h2 class="visually-hidden" id="results-title">年度別の大会結果</h2>

      <div class="tabs" role="tablist" aria-label="年度の切り替え">
        {years.map((y, i) => (
          <button
            class:list={['tab', i === 0 && 'is-active']}
            type="button"
            role="tab"
            id={`tab-${y.nendo}`}
            aria-controls={`panel-${y.nendo}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >{y.label}</button>
        ))}
      </div>

      {years.map((y, i) => (
        <div class="tabpanel" id={`panel-${y.nendo}`} role="tabpanel" aria-labelledby={`tab-${y.nendo}`} hidden={i !== 0}>
          <ul class="sch-list">
            {y.tournaments.map((t) => {
              const c = counts(t);
              const wins = summarize(t);
              return (
                <li><a class="sch-item" href={resultUrl(t)}>
                  <span class="sch-item__text">
                    <span class="sch-item__title">{t.title}</span>
                    <span class="sch-item__place">
                      {wins.length > 0
                        ? `優勝 ${wins.join('／')}${c.places > wins.length ? ' ほか' : ''}`
                        : c.photos > 0 ? '写真で結果を掲載しています' : '結果を掲載しています'}
                    </span>
                  </span>
                  <span class="result-tags" aria-hidden="true">
                    {c.places > 0 && <span class="badge badge--outline">{c.places}件</span>}
                    {c.photos > 0 && <span class="badge badge--tint">写真{c.photos}</span>}
                    {c.pdfs > 0 && <span class="dl-item__type">PDF</span>}
                  </span>
                  <span class="sqbtn" aria-hidden="true">→</span>
                </a></li>
              );
            })}
          </ul>
        </div>
      ))}

      <p class="note">※ 旧サイト（{totalTournaments}大会・写真{totalPhotos}枚）から引き継いだ内容です。種目名や氏名は当時の掲載をそのまま載せています。誤りや掲載の取り下げのご依頼は<a href="contact.html">お問い合わせ</a>からお知らせください。</p>
    </div>
  </section>
</Base>
