---
// 大会1件の結果ページ。src/data/results.json の大会を results.js で束ねた1件から作る。
// URL は result-<id>.html（id は束ねた先頭ページの id）。旧サイトの結果は EmDash ではなく
// results.json に置いたまま（手で直す資料。管理画面からは触らない）。
// 相対パス（assets/... など）を他のページと同じに保つため、あえて平置きにしている。
//
// 画面の構成は旧サイトと同じ。
//   種目の結果画像（ドロー表・リーグ表）を大きく → その下にその種目の入賞者の写真 → その下に入賞者の名前 → 次の種目 …
// 成績の表は別に出さない。種目と画像が対応づけられないページ（結果画像の枚数と種目の数が合わない）だけ、
// 入賞者の名前を画像のあとに種目ごとの行で並べる。
// クラブ対抗戦だけは、旧サイトで分かれていたページを1つにし、男子1部→8部、女子1部→5部の部の順に並べ直す。
//   部ごとに「リーグ表 → その下に優勝クラブの写真 → 優勝クラブの名前」。
// 写真だけのページ（ギャラリー＝優勝クラブ以外の当日の写真）があるときだけ、別ページ（gallery-<id>.html）に分けて入口を置く。
import Base from '../layouts/Base.astro';
import EventSection from '../components/EventSection.astro';
import EventResult from '../components/EventResult.astro';
import AwardLine from '../components/AwardLine.astro';
import { siteData } from '../lib/cms.js';
import { groupById, GROUPS_BY_YEAR, CLUB_GROUPS, photoBlocks, imageRuns, clubDivisions, divisionChampion } from '../data/results.js';
import { sortByCategory } from '../data/category-order.js';

// 令和7年度以降（EmDash の大会）の結果も、同じ URL の形（result-<slug>.html）で出す
const g = groupById(Astro.params.id);
const site = await siteData(Astro);
const ev = g ? null : site.eventBySlug(Astro.params.id);
if (!g && !(ev && ev.hasResult)) return Astro.rewrite('/404');

// 同じ年度の前後の大会（ページ下部の行き来に使う）
const year = g ? GROUPS_BY_YEAR.find((y) => y.nendo === g.nendo) : null;
const idx = g ? year.groups.findIndex((x) => x.id === g.id) : -1;
let prev = g ? year.groups[idx - 1] : null;
let next = g ? year.groups[idx + 1] : null;
// クラブ対抗戦は、同じ年度の前後の大会ではなく、前の年度・次の年度のクラブ対抗戦へ行き来する
// （CLUB_GROUPS は新しい年度が先）。いちばん新しい年度の次は、管理画面の大会（令和7年度〜）の結果があればそこへ
const isClub = !!g?.merged;
if (isClub) {
  const ci = CLUB_GROUPS.findIndex((x) => x.id === g.id);
  const older = CLUB_GROUPS[ci + 1];
  const newer = CLUB_GROUPS[ci - 1];
  const newerEv = !newer
    ? (site.EVENTS ?? []).filter((e) => /クラブ対抗/.test(e.name) && e.hasResult && Number(e.nendo) > Number(g.nendo)).sort((a, b) => a.date.localeCompare(b.date))[0]
    : null;
  prev = older ? { href: older.href, title: `${older.yearLabel} クラブ対抗戦` } : null;
  next = newer
    ? { href: newer.href, title: `${newer.yearLabel} クラブ対抗戦` }
    : newerEv ? { href: `result-${newerEv.slug}.html`, title: `${newerEv.nendoLabel} ${newerEv.name.replace(/^令和\d+年度\s*/, '')}` } : null;
}

const head = g ? g.entries[0].t : null;
const title = g ? `${g.title}（${g.yearLabel}）｜大会結果｜鳥取市テニス協会` : '';
const description = g ? `${g.yearLabel}に行われた${g.title}の結果です。種目ごとの結果表と当日の写真を掲載しています。` : '';

// 束ねたページごとに、画像のかたまり・入賞者・PDFを組む。できるだけ写真と入賞者の名前をセットにする。
// 画像を「結果表（1枚以上）→ 写真」のまとまりに切り、次の順に試す（旧サイトの並びが種目順だったため）：
//   0. ファイル名の種目の記号（mas＝男子A級シングルス、w45d＝女子45歳以上ダブルス など）で、写真のあるまとまりが
//      すべてどれか1つの種目に当てはまる … その種目に。記号が無い・当てはまらないまとまりは種目なし
//   1. まとまりの数 ＝ 種目の数        … n番目のまとまり ＝ n番目の種目。その種目の入賞者を写真1枚ずつに添える
//      （結果表のあるまとまり・写真のあるまとまりの数が種目の数と同じときも、それぞれの順で同じこと。
//        先頭の集合写真だけのまとまりや、写真の無い結果表だけのまとまりを除いて数える）
//   2. 結果画像の数 ＝ 種目の数        … 結果画像1枚ごとに切り直して同じこと
//   3. まとまりの数 ＝ 入賞者の数      … n番目のまとまり ＝ n番目の入賞者（同じ種目に優勝が2人いて、それぞれ表と写真があるときなど）
//   4. 結果画像の数 ＝ 入賞者の数      … 結果画像1枚ごとに切り直して同じこと
//   5. 写真の数 ＝ 入賞者の数          … 種目は分からないが、写真の順に入賞者を1人ずつ添える
//   6. それでも合わなければ、入賞者の名前は画像のあとに種目ごとに並べる（loose）
// 各まとまり：{ sheets, photos, category, caps: 写真ごとの入賞者 { category, text } か null, extra: 写真の無い入賞者 }
/** 種目名 → ファイル名に使われる記号（男子A級シングルス → mas、女子45歳以上ダブルス → w45d）。作れないときは null */
const catCode = (name) => {
  const t = String(name ?? '').normalize('NFKC');
  const g = /^男子/.test(t) ? 'm' : /^女子/.test(t) ? 'w' : null;
  const lv = (t.match(/([ABC])級/) || [])[1]?.toLowerCase() ?? (t.match(/(\d{2})歳以上/) || [])[1] ?? null;
  const ty = /シングルス/.test(t) ? 's' : /ダブルス/.test(t) ? 'd' : null;
  return g && lv && ty ? g + lv + ty : null;
};
/** 画像のファイル名から種目の記号を拾う（…-mas-002.webp、…_m45d-001.webp など） */
const fileCodes = (imgs) => imgs.flatMap((p) => [...String(p.src).split('/').pop().matchAll(/(?:^|[-_])([mw](?:[abc]|\d{2})[sd])(?=[-_.\d])/gi)].map((m) => m[1].toLowerCase()));
/** ファイル名の記号で、写真のあるまとまりをすべて種目に当てはめられるとき、まとまりごとの種目（無いところは null）。できなければ null */
const codeMatch = (runs, cats) => {
  const byCode = new Map();
  for (const c of cats) { const k = catCode(c.category); if (!k || byCode.has(k)) return null; byCode.set(k, c); }
  if (byCode.size < 2) return null;
  const used = new Set();
  const out = runs.map((b) => {
    const codes = [...new Set(fileCodes(b.photos).length ? fileCodes(b.photos) : fileCodes(b.sheets).slice(-1))];
    const hit = codes.map((k) => byCode.get(k)).filter(Boolean);
    return hit.length === 1 ? hit[0] : null;
  });
  for (let k = 0; k < runs.length; k++) {
    if (!runs[k].photos.length) continue;
    if (!out[k] || used.has(out[k])) return null;
    used.add(out[k]);
  }
  return out.some(Boolean) ? out : null;
};
const placeText = (pl) => `${pl.award} ${pl.name}${pl.note ? (/^[（(]/.test(pl.note) ? pl.note : `（${pl.note}）`) : ''}`;
const placesOf = (c) => c.places.filter((pl) => pl.name).map((pl) => ({ category: c.category, text: placeText(pl) }));
// ギャラリーを別ページに出すときは、その分をここから外す
const inline = !g ? [] : g.galleryHref ? g.entries.filter((e) => e.kind !== 'gallery') : g.entries;
const parts = inline.map((e) => {
  const cats = e.t.categories;
  const flat = cats.flatMap(placesOf);
  const runs = imageRuns(e.t.photos);
  const perSheet = photoBlocks(e.t).map((b) => ({ sheets: b.sheet ? [b.sheet] : [], photos: b.photos }));
  const withSheet = (list) => list.filter((b) => b.sheets.length);
  let blocks = runs;
  let loose = [];
  const give = (b, category, places) => {
    b.category = category;
    b.caps = b.photos.map((_, k) => places[k] ?? null);
    b.extra = places.slice(b.photos.length);
  };
  const fill = (list, units, pick) => { let n = 0; for (const b of list) { const u = b.sheets.length ? units[n++] : null; if (u) pick(b, u); else give(b, null, []); } };
  // 条件に合うまとまりにだけ、順に割り当てる（合わないまとまりは種目なし）
  const fillIf = (list, units, ok, pick) => { let n = 0; for (const b of list) { const u = ok(b) ? units[n++] : null; if (u) pick(b, u); else give(b, null, []); } };
  const hasPhoto = (b) => b.photos.length > 0;
  const hasSheet = (b) => b.sheets.length > 0;
  const byCode = codeMatch(runs, cats);
  if (byCode) {
    runs.forEach((b, k) => (byCode[k] ? give(b, byCode[k].category, placesOf(byCode[k])) : give(b, null, [])));
    loose = cats.filter((c) => !byCode.includes(c)).flatMap(placesOf);
  } else if (cats.length && runs.length === cats.length && runs.some(hasSheet)) {
    runs.forEach((b, k) => give(b, cats[k].category, placesOf(cats[k])));
  } else if (cats.length && runs.filter(hasSheet).length === cats.length) {
    fillIf(runs, cats, hasSheet, (b, c) => give(b, c.category, placesOf(c)));
  } else if (cats.length && runs.filter(hasPhoto).length === cats.length && runs.some(hasSheet)) {
    fillIf(runs, cats, hasPhoto, (b, c) => give(b, c.category, placesOf(c)));
  } else if (cats.length && withSheet(perSheet).length === cats.length) {
    blocks = perSheet; fill(perSheet, cats, (b, c) => give(b, c.category, placesOf(c)));
  } else if (flat.length && runs.length === flat.length && runs.some((r) => r.sheets.length)) {
    fill(runs, flat, (b, p) => give(b, p.category, [p]));
  } else if (flat.length && runs.filter(hasSheet).length === flat.length) {
    fillIf(runs, flat, hasSheet, (b, p) => give(b, p.category, [p]));
  } else if (flat.length && runs.filter(hasPhoto).length === flat.length && runs.some(hasSheet)) {
    fillIf(runs, flat, hasPhoto, (b, p) => give(b, p.category, [p]));
  } else if (flat.length && withSheet(perSheet).length === flat.length) {
    blocks = perSheet; fill(perSheet, flat, (b, p) => give(b, p.category, [p]));
  } else {
    const photos = runs.reduce((s, r) => s + r.photos.length, 0);
    if (flat.length && photos === flat.length) {
      let n = 0;
      for (const b of runs) { b.category = null; b.caps = b.photos.map(() => flat[n++]); b.extra = []; }
    } else {
      for (const b of runs) { b.category = null; b.caps = b.photos.map(() => null); b.extra = []; }
      loose = flat;
    }
  }
  // 種目の順（予選 → 決勝、男子 → 女子）。種目が分かるまとまりだけ並べ替え、分からないものは元の順のまま
  const sorted = blocks.length && blocks.every((b) => b.category) ? sortByCategory(blocks, (b) => b.category) : blocks;
  const categories = sortByCategory(e.t.categories, (c) => c.category);
  return { title: inline.length > 1 ? e.title : null, blocks: sorted, categories, loose, pdfs: e.t.pdfs };
});
const hasAny = !!g && (parts.some((p) => p.blocks.length || p.categories.length || p.pdfs.length) || !!g.galleryHref);

// クラブ対抗戦：部ごとにまとめ直したもの（男子1部→8部、女子1部→5部）
const club = g?.merged ? clubDivisions(g) : null;
const anchor = (name) => `div-${name.replace(/[^0-9A-Za-z\u3040-\u30ff\u4e00-\u9fff]/g, '')}`;

// ギャラリーの入口に見せる写真（先頭の数枚）
const GALLERY_PEEK = 8;
const galleryPeek = g?.galleryHref ? g.galleries.flatMap((e) => e.t.photos).slice(0, GALLERY_PEEK) : [];
let photoNo = 0;
---

{ev && (
  <EventSection e={ev} label="結果" en="Result">
    <EventResult e={ev} />
  </EventSection>
)}

{g && <Base
  title={title}
  description={description}
  navActive="results"
  mobileNavActive="results"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">RESULT</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <a href="results.html">大会結果</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <span aria-current="page">{g.title}</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">{g.yearLabel}</p>
          <h1 class="page-title">{g.title}</h1>
        </div>
      </div>
      {(head.date || head.venue) && (
        <p class="page-lead fu" style="animation-delay:.15s">
          {[head.date, head.venue].filter(Boolean).join('　／　')}
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container container--result">

      {club && (
        <>
          {/* 部へのジャンプ。長いページなので、見たい部へすぐ飛べるように */}
          <nav class="jump jump--scroll hscroll rv" data-hscroll style="margin-top:0" aria-label="部へ移動">
            <div class="jump__track hscroll__track">
              {club.divisions.map((d) => <a class="jump__link" href={`#${anchor(d.name)}`}>{d.name}</a>)}
              {g.galleryHref && <a class="jump__link" href="#gallery">ギャラリー<span class="jump__n">{g.galleryPhotos}</span></a>}
            </div>
            <span class="hscroll__hint" aria-hidden="true"><span class="hscroll__arrow"></span>SCROLL</span>
          </nav>

          {club.divisions.map((d) => {
            const champ = divisionChampion(d);
            return (
              <section class="division rv" id={anchor(d.name)}>
                {/* 見出しは置かない（部の名前はリーグ表の中にある）。リーグ表 → その下に優勝クラブの写真（横には並べない） */}
                <div class="rblock">
                  {d.sheets.length > 0 && (
                    <div class:list={['rblock__sheet', d.sheets.length > 1 && 'sheets sheets--result']}>
                      {d.sheets.map((sh, i) => (
                        <a class="sheet sheet--result" href={sh.src}>
                          <img src={sh.src} alt={`${g.title} ${d.name}の結果表${d.sheets.length > 1 ? ` ${i + 1}` : ''}`} width={sh.w} height={sh.h} loading="lazy" decoding="async">
                        </a>
                      ))}
                    </div>
                  )}
                  {(() => {
                    const places = d.places.filter((pl) => pl.name);
                    return (
                      <>
                        {d.photos.length > 0 && (
                          <div class="rblock__photos division__photos">
                            <div class="gallery gallery--winners">
                              {d.photos.map((ph, k) => (
                                <a class="gallery__item" href={ph.src}>
                                  <img src={ph.src} alt={`${g.title} ${d.name} 優勝クラブの写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
                                  {places[k] && <span class="gallery__cap"><span class="rblock__cat">{d.name}</span><AwardLine items={[places[k]]} /></span>}
                                </a>
                              ))}
                            </div>
                          </div>
                        )}
                        {/* 写真の無い入賞クラブは1行ずつ（写真が無ければリーグ表の下） */}
                        {places.slice(d.photos.length).map((pl) => (
                          <p class="rblock__caption"><span class="rblock__cat">{d.name}</span><AwardLine items={[pl]} /></p>
                        ))}
                      </>
                    );
                  })()}
                </div>
              </section>
            );
          })}

          {/* 部に対応づけられなかった画像（いまは無い。データを足したときの保険） */}
          {club.loose.map((l) => (
            <>
              <h2 class="sub-head rv" style="margin-top:48px">{l.title}</h2>
              {l.runs.map((r) => (
                <div class="rblock rv">
                  <div class:list={['rblock__sheet', r.sheets.length > 1 && 'sheets sheets--result']}>
                    {r.sheets.map((sh) => (
                      <a class="sheet sheet--result" href={sh.src}>
                        <img src={sh.src} alt={`${g.title}の結果表`} width={sh.w} height={sh.h} loading="lazy" decoding="async">
                      </a>
                    ))}
                  </div>
                  {r.photos.length > 0 && (
                    <div class="gallery gallery--winners">
                      {r.photos.map((ph) => (
                        <a class="gallery__item" href={ph.src}>
                          <img src={ph.src} alt={`${g.title}の写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </>
          ))}

          {g.pdfs.length > 0 && (
            <ul class="rv" style="margin-top:24px">
              {g.pdfs.map((pdf) => (
                <li><a class="dl-item" href={pdf} target="_blank" rel="noopener noreferrer">
                  <span class="dl-item__type">PDF</span>
                  <span class="dl-item__text">
                    <span class="dl-item__title">{g.title} 結果（PDF をダウンロード）</span>
                    <span class="dl-item__note">上の結果画像と同じ内容です。別タブで開きます</span>
                  </span>
                  <span class="sqbtn" aria-hidden="true">→</span>
                </a></li>
              ))}
            </ul>
          )}
        </>
      )}

      {!club && parts.map((p) => (
        <>
          {p.title && <h2 class="sub-head rv" style="margin-top:48px">{p.title}</h2>}

          {/* 種目ごとに 結果表 → その下に入賞者の写真 → 入賞者の名前（EmDash の大会の結果と同じ型） */}
          {p.blocks.map((b, i) => (
            <section class:list={[b.category ? 'division' : 'rblock', 'rv']} id={b.category ? `${anchor(b.category)}-${i}` : undefined}>
              {/* 見出しは置かない（種目名は結果表の中にある） */}
              <div class="rblock">
                {b.sheets.length > 0 && (
                  <div class:list={['rblock__sheet', b.sheets.length > 1 && 'sheets sheets--result']}>
                    {b.sheets.map((sh, k) => (
                      <a class="sheet sheet--result" href={sh.src}>
                        <img src={sh.src} alt={`${g.title}${b.category ? ' ' + b.category : ''}の結果表${b.sheets.length > 1 ? ` ${k + 1}` : ''}`} width={sh.w} height={sh.h} loading="lazy" decoding="async">
                      </a>
                    ))}
                  </div>
                )}
                {b.photos.length > 0 && (
                  <div class="rblock__photos division__photos">
                    <div class="gallery gallery--winners">
                      {b.photos.map((ph, k) => (
                        <a class="gallery__item" href={ph.src}>
                          <img src={ph.src} alt={`${g.title}${(b.caps[k]?.category || b.category) ? ' ' + (b.caps[k]?.category || b.category) : ''} 入賞者の写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
                          {b.caps[k] && <span class="gallery__cap">{b.caps[k].category && <span class="rblock__cat">{b.caps[k].category}</span>}<AwardLine texts={[b.caps[k].text]} category={b.caps[k].category} /></span>}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
                {/* 写真の無い入賞者は1行ずつ */}
                {b.extra.map((c) => (
                  <p class="rblock__caption">{c.category && <span class="rblock__cat">{c.category}</span>}<AwardLine texts={[c.text]} category={c.category} /></p>
                ))}
              </div>
            </section>
          ))}

          {/* 種目と画像が対応づけられないページ：入賞者の名前を画像のあとに1人ずつ */}
          {p.loose.length > 0 && (
            <div class="rblock__captions rv">
              {p.loose.map((c) => (
                <p class="rblock__caption">
                  <span class="rblock__cat">{c.category || '種目'}</span>
                  <AwardLine texts={[c.text]} category={c.category} />
                </p>
              ))}
            </div>
          )}

          {p.pdfs.length > 0 && (
            <ul class="rv" style="margin-top:24px">
              {p.pdfs.map((pdf) => (
                <li><a class="dl-item" href={pdf} target="_blank" rel="noopener noreferrer">
                  <span class="dl-item__type">PDF</span>
                  <span class="dl-item__text">
                    <span class="dl-item__title">{p.title ? `${g.title} ${p.title}` : g.title} 結果（PDF をダウンロード）</span>
                    <span class="dl-item__note">上の結果画像と同じ内容です。別タブで開きます</span>
                  </span>
                  <span class="sqbtn" aria-hidden="true">→</span>
                </a></li>
              ))}
            </ul>
          )}
        </>
      ))}

      {g.galleryHref && (
        <div class="rv" id="gallery" style="margin-top:64px">
          <div class="esec__head">
            <h2 class="sub-head" style="margin-bottom:0">ギャラリー</h2>
            <span class="gallery__count">{g.galleryPhotos}枚</span>
          </div>
          <p class="note mt-24" style="margin-bottom:0">当日の写真は別のページにまとめています。</p>
          <a class="gallery-peek" href={g.galleryHref}>
            <span class="gallery-peek__grid" aria-hidden="true">
              {galleryPeek.map((ph) => (
                <img src={ph.src} alt="" width={ph.w} height={ph.h} loading="lazy" decoding="async">
              ))}
            </span>
            <span class="gallery-peek__label">写真をすべて見る（{g.galleryPhotos}枚）<span class="aw">→</span></span>
          </a>
        </div>
      )}

      {!hasAny && (
        <div class="panel panel--gray rv">
          <p style="margin:0">この大会は記録が残っていません。</p>
        </div>
      )}

      <nav class="page-nav rv" aria-label={isClub ? '前後の年度のクラブ対抗戦' : '同じ年度の大会'}>
        {prev
          ? <a class="page-nav__link" href={prev.href}><span class="page-nav__dir">{isClub ? '← 前年のクラブ対抗戦' : '← 前の大会'}</span><span class="page-nav__title">{prev.title}</span></a>
          : <span></span>}
        <a class="ghost-link" href="results.html">大会結果の一覧へ</a>
        {next
          ? <a class="page-nav__link page-nav__link--next" href={next.href}><span class="page-nav__dir">{isClub ? '翌年のクラブ対抗戦 →' : '次の大会 →'}</span><span class="page-nav__title">{next.title}</span></a>
          : <span></span>}
      </nav>

    </div>
  </section>
</Base>}
