---
import Base from '../layouts/Base.astro';

const title = "水曜テニス教室｜鳥取市テニス協会";
const description = "毎週水曜日、井原公園テニスコートで開催しているレベル別テニス教室。初心者から中級者まで4コースをご用意しています。";
---

<Base
  title={title}
  description={description}
  navActive="courts"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">SCHOOL</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">水曜テニス教室</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">School</p>
          <h1 class="page-title" style="margin-top:8px">水曜テニス教室</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">毎週水曜日の夜、井原公園テニスコートで開いている教室です。レベル別に4つのコートに分かれ、それぞれに専任コーチがつきます。ラケットの持ち方から教えるコートもありますので、はじめての方もどうぞ。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="rv">
        <h2 class="sub-head">開催概要</h2>
        <dl class="deflist">
          <div class="deflist__row"><dt class="deflist__key">主催</dt><dd class="deflist__val" style="margin:0">鳥取市テニス協会</dd></div>
          <div class="deflist__row"><dt class="deflist__key">期間</dt><dd class="deflist__val" style="margin:0">4月下旬〜（毎週水曜日）※令和8年度の開始日は<span class="todo-note">要確認</span></dd></div>
          <div class="deflist__row"><dt class="deflist__key">時間</dt><dd class="deflist__val" style="margin:0">18:00〜21:00（レッスンは18:30スタート）</dd></div>
          <div class="deflist__row"><dt class="deflist__key">場所</dt><dd class="deflist__val" style="margin:0">井原公園テニスコート（4面使用）</dd></div>
          <div class="deflist__row"><dt class="deflist__key">対象</dt><dd class="deflist__val" style="margin:0">中学生以上（夜間開催のため）</dd></div>
          <div class="deflist__row"><dt class="deflist__key">参加費</dt><dd class="deflist__val" style="margin:0">1回 500円</dd></div>
          <div class="deflist__row"><dt class="deflist__key">登録費</dt><dd class="deflist__val" style="margin:0">鳥取市テニス協会への登録が必要です（一般 1,500円／学生 1,000円／高校生以下 500円）</dd></div>
        </dl>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">コース案内</h2>
        <div class="card-grid card-grid--4">
        <div class="panel">
          <p style="margin:0;font:700 13px/1 var(--flt);letter-spacing:.12em;color:var(--red)">COURT 1</p>
          <p style="margin:12px 0 0;font:700 18px/1.5 var(--fjp);letter-spacing:.02em;color:var(--ink)">初心者・初級者</p>
          <p style="margin:10px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-800)">ラケットの持ち方、コート上のマナーから指導します。</p>
        </div>
        <div class="panel">
          <p style="margin:0;font:700 13px/1 var(--flt);letter-spacing:.12em;color:var(--red)">COURT 2</p>
          <p style="margin:12px 0 0;font:700 18px/1.5 var(--fjp);letter-spacing:.02em;color:var(--ink)">初級者</p>
          <p style="margin:10px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-800)">基礎練習を中心に、安定したストロークとボレーの習得を目指します。</p>
        </div>
        <div class="panel">
          <p style="margin:0;font:700 13px/1 var(--flt);letter-spacing:.12em;color:var(--red)">COURT 3</p>
          <p style="margin:12px 0 0;font:700 18px/1.5 var(--fjp);letter-spacing:.02em;color:var(--ink)">中級者</p>
          <p style="margin:10px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-800)">基礎練習に加え、すべてのショットのテクニック向上を目指します。</p>
        </div>
        <div class="panel">
          <p style="margin:0;font:700 13px/1 var(--flt);letter-spacing:.12em;color:var(--red)">COURT 4</p>
          <p style="margin:12px 0 0;font:700 18px/1.5 var(--fjp);letter-spacing:.02em;color:var(--ink)">中級者</p>
          <p style="margin:10px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-800)">試合形式を中心に練習します。</p>
        </div>
        </div>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">参加時の注意</h2>
        <ul class="bullet-list">
          <li>ラケットの貸出はありません。各自でご持参ください。</li>
          <li>テニスのできる服装でお越しください。</li>
          <li>井原コートはハードコートのため、雨天の場合は中止となります。</li>
          <li>天候不良による急な予定変更・開催可否は、LINEグループでお知らせします。</li>
        </ul>
      </div>

      <div class="split">
        <div class="rv panel panel--tint">
          <p class="panel__title">教室のご連絡について</p>
          <p class="prose" style="margin:0">下のボタンからLINEグループにご参加ください。中止のご連絡はこちらで行っています。</p>
          <a class="btn btn--primary" style="margin-top:24px" href="contact.html">LINEグループに参加する <span class="aw">↗</span></a>
        </div>
        <div class="rv" style="transition-delay:.1s">
          <div class="embed embed--map">
            <span class="embed__label">Googleマップ埋め込み（井原公園テニスコート）</span>
            <span class="embed__note">title="井原公園テニスコート"</span>
          </div>
          <p style="margin:16px 0 0;font:700 15px/1.7 var(--fjp);color:var(--ink)">井原公園テニスコート</p>
          <p style="margin:2px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-600)">〒680-0844 鳥取県鳥取市興南町174</p>
        </div>
      </div>

    </div>
  </section>
</Base>
