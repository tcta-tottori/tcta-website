---
import Base from '../layouts/Base.astro';
import LinkCard from '../components/LinkCard.astro';
import { LINK_GROUPS } from '../data/links.js';

const title = "リンク集｜鳥取市テニス協会";
const description = "鳥取市テニス協会に関係する団体・施設のリンク集。鳥取県テニス協会、公共施設予約システム、近隣協会など。";
---

<Base
  title={title}
  description={description}
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">リンク集</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">Links</p>
          <h1 class="page-title" style="margin-top:8px">リンク集</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">鳥取市テニス協会に関係する団体・施設のサイトです。すべて外部サイトが開きます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {LINK_GROUPS.map((g, i) => (
        <div class="rv" style={i === 0 ? undefined : 'margin-top:56px'}>
          <h2 class="sub-head">{g.title}</h2>
          <div class="link-grid">
            {g.items.map((l) => <LinkCard link={l} />)}
          </div>
        </div>
      ))}

      <p class="note">※ バナー画像の使用許諾と掲載団体の追加・削除は公開前に確認してください。リンク切れ防止のため年1回の定期確認を運用手順に含めます。</p>
    </div>
  </section>
</Base>
