---
import Base from '../layouts/Base.astro';
import { siteData } from '../lib/cms.js';
import { LINK_GROUPS, LINE_OFFICIAL } from '../data/links.js';

// 協会の SNS（管理画面 → Settings → Social）
const { SOCIAL } = await siteData(Astro);

// 「協会の公式アカウント」は画像のボタン（YouTube・Instagram・LINE の順。public/assets/img/sns/）で出す。
// 入会案内のボタンと同じく縦に積む（スマホは幅いっぱい、広い画面では内容幅）。URL は LINE が links.js、
// Instagram・YouTube が管理画面の Social 設定。設定の無いものは出さない。
const social = (key) => SOCIAL.find((x) => x.key === key)?.url;
const SNS_BUTTONS = [
  { key: 'youtube', url: social('youtube'), img: 'assets/img/sns/youtube-button.webp', w: 1600, h: 310, alt: '鳥取市テニス協会 YouTube（大会や教室の動画を配信中）' },
  { key: 'instagram', url: social('instagram'), img: 'assets/img/sns/instagram-button.webp', w: 1600, h: 318, alt: '鳥取市テニス協会 Instagram（大会・教室の写真を投稿中）' },
  { key: 'line', url: LINE_OFFICIAL.url, img: 'assets/img/sns/line-button.webp', w: 1600, h: 303, alt: '鳥取市テニス協会 LINE 公式アカウント（大会・教室のお知らせを配信中）' },
].filter((b) => b.url);
// LINE はボタンで出すので、公式アカウントのバナー一覧からは外す
const itemsOf = (g) => (g.id === 'official' ? g.items.filter((l) => l !== LINE_OFFICIAL) : g.items);

const title = "リンク集｜鳥取市テニス協会";
const description = "鳥取市テニス協会に関係する団体・施設のリンク集。鳥取県テニス協会、公共施設予約システム、近隣協会など。";
---

<Base
  mobileNavActive="links"
  title={title}
  description={description}
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">リンク集</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">Links</p>
          <h1 class="page-title">リンク集</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">鳥取市テニス協会に関係する団体・施設のサイトです。すべて外部サイトが開きます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {/* 種類のタブ（すべて／協会の公式アカウント／関係団体 …）。1行に並べ、収まらない分は横スクロール。
          押した種類だけを出す（main.js の initFilters。大会情報の絞り込みと同じ仕組み） */}
      <div class="ltabs hscroll" data-hscroll>
        <div class="ltabs__track hscroll__track" data-filter-group data-filter-target="#link-list" role="group" aria-label="リンクの種類">
          <button class="chip ltab is-active" type="button" data-filter="all" aria-pressed="true">すべて</button>
          {LINK_GROUPS.map((g) => <button class="chip ltab" type="button" data-filter={g.id} aria-pressed="false">{g.title}</button>)}
        </div>
        <span class="hscroll__hint" aria-hidden="true"><span class="hscroll__arrow"></span>SCROLL</span>
      </div>

      <div id="link-list">
        {LINK_GROUPS.map((g) => (
          <div class="lgroup" data-tags={g.id}>
            <h2 class="sub-head rv">{g.title}</h2>
            {g.id === 'official' && SNS_BUTTONS.length > 0 && (
              <div class="sns-buttons rv">
                {SNS_BUTTONS.map((b) => (
                  <a class="sns-button" href={b.url} target="_blank" rel="me noopener noreferrer">
                    <img src={b.img} alt={b.alt} width={b.w} height={b.h} loading="lazy" decoding="async">
                  </a>
                ))}
              </div>
            )}
            {itemsOf(g).length > 0 && (
              <ul class="llist">
                {itemsOf(g).map((l) => (
                  <li class="rv">
                    {/* バナーを白い枠の中央に大きく → 団体名と ↗ → 説明（全文） */}
                    <a class="litem" href={l.url} target="_blank" rel="noopener noreferrer">
                      <span class="litem__media">
                        {l.banner
                          ? <img src={l.banner} alt="" width="1018" height="168" loading="lazy" decoding="async">
                          : <span class="litem__noimg">{l.name}</span>}
                      </span>
                      <span class="litem__head">
                        <span class="litem__name">{l.name}</span>
                        <span class="litem__ext" aria-hidden="true">↗</span>
                      </span>
                      {l.desc && <span class="litem__desc">{l.desc}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
