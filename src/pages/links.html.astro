---
import Base from '../layouts/Base.astro';
import { LINK_GROUPS } from '../data/links.js';

const title = "リンク集｜鳥取市テニス協会";
const description = "鳥取市テニス協会に関係する団体・施設のリンク集。鳥取県テニス協会、公共施設予約システム、近隣協会など。";
---

<Base
  mobileNavActive="links"
  title={title}
  description={description}
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">リンク集</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">Links</p>
          <h1 class="page-title">リンク集</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">鳥取市テニス協会に関係する団体・施設のサイトです。すべて外部サイトが開きます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div id="link-list">
        {LINK_GROUPS.map((g) => (
          <div class="lgroup">
            <h2 class="sub-head rv">{g.title}</h2>
            {g.items.length > 0 && (
              <ul class="llist">
                {g.items.map((l) => (
                  <li class="rv">
                    {/* バナーを白い枠の中央に大きく → 団体名と ↗ → 説明（全文） */}
                    <a class="litem" href={l.url} target="_blank" rel="noopener noreferrer">
                      {/* 枠全体（バナー・団体名・説明）の下地に、同じバナーを大きくしてぼかしたものを敷く（.litem__bg。style.css） */}
                      {l.banner && <span class="litem__bg" style={`background-image:url('${l.banner}')`} aria-hidden="true"></span>}
                      <span class="litem__media">
                        {l.banner
                          ? <img src={l.banner} alt="" width="1018" height="168" loading="lazy" decoding="async">
                          : <span class="litem__noimg">{l.name}</span>}
                      </span>
                      <span class="litem__head">
                        <span class="litem__name">{l.name}</span>
                        <span class="litem__ext" aria-hidden="true">↗</span>
                      </span>
                      {l.desc && <span class="litem__desc">{l.desc}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
