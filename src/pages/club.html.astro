---
import Base from '../layouts/Base.astro';
import { siteData } from '../lib/cms.js';
import { CLUB_GROUPS, clubDivisions, divisionChampion } from '../data/results.js';
import { CLUB_SEASONS } from '../data/club-league.js';

const title = "クラブ対抗戦｜鳥取市テニス協会";
const description = "鳥取市テニス協会のクラブ対抗戦。令和8年度の各部の結果と令和9年度の編成表、平成26年度からの各部の優勝クラブを掲載しています。";

// ■ 令和7年度〜（EmDash に移ってから）
//   結果表と写真は EmDash の大会ページ（event-r8-club-taiko-1.html など）。
//   部ごとの優勝クラブは、管理画面の「成績」に行があればそれを、無ければ src/data/club-league.js の写しを使う。
const { eventBySlug } = await siteData(Astro);
const seasons = CLUB_SEASONS.map((season) => ({
  ...season,
  terms: season.terms.map((term) => {
    const e = eventBySlug(term.slug);
    const fromCms = e?.winners?.length
      ? e.winners.flatMap((c) => c.places.map((p) => ({ div: c.category, club: p.name, award: p.award === '優勝' ? undefined : p.award })))
      : null;
    return { ...term, href: e?.url ?? null, divisions: fromCms ?? term.divisions, summary: e ? '結果表と当日の写真' : null };
  }),
}));

// ■ 令和6年度まで（旧サイトから引き継いだ results.json）
//   旧サイトで「男子1部〜6部」「男子7部・8部」「女子…」と分かれていたページを年度ごとに1つに束ね、
//   男子1部→8部、女子1部→5部の順に優勝クラブを出す（results.js の clubDivisions）。
const archive = CLUB_GROUPS.map((g) => ({
  label: g.yearLabel,
  href: g.href,
  galleryHref: g.galleryHref,
  galleryPhotos: g.galleryPhotos,
  divisions: clubDivisions(g).divisions
    .map((d) => ({ div: d.name, club: divisionChampion(d) }))
    .filter((x) => x.club),
}));
---


<Base
  title={title}
  description={description}
  navActive="tournaments"
  mobileNavActive="tournaments"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">CLUB LEAGUE</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">クラブ対抗戦</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">Club League</p>
          <h1 class="page-title" style="margin-top:8px">クラブ対抗戦</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">市内のクラブが部ごとに分かれて戦う、年2回のリーグ戦です。前期は男子1部〜8部、後期は女子の各部と男女の予選会を行います。一年を通じて成績が積み上がり、上位クラブは翌年度に昇格します。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="rv">
        <h2 class="sub-head">令和9年度</h2>
        <ul>
          <li><a class="dl-item" href="assets/pdf/club/r9-club-league-lineup.pdf" target="_blank" rel="noopener noreferrer">
            <span class="dl-item__type">PDF</span>
            <span class="dl-item__text">
              <span class="dl-item__title">令和9年度クラブ対抗戦 編成表</span>
              <span class="dl-item__note">部ごとの所属クラブと日程を掲載しています。別タブで開きます。</span>
            </span>
            <span class="sqbtn" aria-hidden="true">→</span>
          </a></li>
        </ul>
      </div>

      {seasons.map((season) => (
        <div class="rv" style="margin-top:56px">
          <h2 class="sub-head">{season.label}</h2>
          <p class="sec-head__lead" style="margin-top:8px">部ごとの優勝クラブです。結果表と当日の写真は、前期・後期それぞれのページでご覧いただけます。</p>
          <div class="champ__body" style="padding:0">
            {season.terms.map((term) => (
              <div class="champ__block" style="margin-top:24px">
                {term.href
                  ? <a class="champ__title" href={term.href}>{term.label}（{term.event}）<span class="aw">→</span></a>
                  : <p class="champ__title" style="margin:0">{term.label}（{term.event}）</p>}
                <ul class="champ__list">
                  {term.divisions.map((c) => (
                    <li><span class="champ__div">{c.div}</span><span class="champ__club">{c.award && <span class="champ__award">{c.award}</span>}{c.club}</span></li>
                  ))}
                </ul>
                {term.href && <p class="champ__none">{term.date}　／　<a class="ghost-link" href={term.href}>結果表と当日の写真を見る <span class="aw">→</span></a></p>}
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">これまでの優勝クラブ</h2>
        <p class="sec-head__lead" style="margin-top:8px">令和6年度までは旧サイトから引き継いだ記録です。年度をひらくと、男子1部から8部、女子1部から5部の順に各部の優勝クラブが出ます。年度名からは結果表と写真のページへ移れます。</p>

        {archive.map((y) => (
          <details class="champ">
            <summary class="champ__year">{y.label}<span class="champ__count">{y.divisions.length}部</span></summary>
            <div class="champ__body">
              <div class="champ__block">
                <a class="champ__title" href={y.href}>{y.label}のクラブ対抗戦 結果表と写真<span class="aw">→</span></a>
                {y.divisions.length > 0 ? (
                  <ul class="champ__list">
                    {y.divisions.map((c) => (
                      <li><span class="champ__div">{c.div}</span><span class="champ__club">{c.club}</span></li>
                    ))}
                  </ul>
                ) : (
                  <p class="champ__none">記録は写真のみです</p>
                )}
                {y.galleryHref && <p class="champ__none"><a class="ghost-link" href={y.galleryHref}>当日のギャラリー（{y.galleryPhotos}枚） <span class="aw">→</span></a></p>}
              </div>
            </div>
          </details>
        ))}
      </div>

      <div class="rv panel panel--gray" style="margin-top:56px">
        <p class="panel__title">参加について</p>
        <p class="prose" style="margin:0">クラブ対抗戦への参加には、鳥取市テニス協会への団体登録が必要です。所属クラブがない方は、お問い合わせフォームからご相談ください。</p>
        <a class="ghost-link mt-24" href="contact.html">お問い合わせフォームへ <span class="aw">→</span></a>
      </div>

    </div>
  </section>
</Base>
