---
// リーグ戦の順位計算（誰でも使える）。要項・ドローのページの下のリンク（league-rules.js に書いた大会）から開く。
//   league-calc.html?e=<大会の slug>  … その大会のルール（勝数が先／取得ゲーム率が先／チーム対抗戦）と試合の形式で計算する
//   league-calc.html                  … ルールを画面で選ぶ
// チームは A〜G（3〜7 チーム）。名前は書き換えられる。リーグ表のマスを押してゲーム数を入れると、勝敗・取得ゲーム率・順位と、
// その計算式・順位の決め手を出す（順位は全試合が入ってから）。ルールで決まらないときだけ、くじ引き（ルーレット）を出す。
// 勝数が先・取得ゲーム率が先は、大会運営システム（tournament/src/features/draw/leagueStandings.ts）と同じ決め方。
import Base from '../layouts/Base.astro';
import { siteData } from '../lib/cms.js';
import { RULE_TEXT, DEFAULT_FORMATS, leagueRuleOf } from '../data/league-rules.js';
import { TOURNAMENT_APP } from '../data/live.js';

const slug = Astro.url.searchParams.get('e') ?? '';
const site = await siteData(Astro);
const ev = slug ? site.eventBySlug(slug) : null;
const conf = ev ? leagueRuleOf(ev.slug) : null;
const fixedRule = conf?.rule ?? null;
const nParam = Number(Astro.url.searchParams.get('n'));
const n0 = Number.isInteger(nParam) && nParam >= 3 && nParam <= 7 ? nParam : (conf?.teams ?? 4);
const formats = JSON.stringify(conf ? { [conf.rule]: conf.formats } : DEFAULT_FORMATS);
const title = `リーグ戦の順位計算${ev ? `（${ev.name}）` : ''}｜鳥取市テニス協会`;
const description = 'リーグ戦（総当たり）の勝敗・取得ゲーム率・順位を、大会のルールに沿って計算するページです。計算式と順位の決め手も確かめられます。';
---

<Base title={title} description={description} navActive="tournaments" mobileNavActive="tournaments">
  <section class="page-head">
    <span class="ghost" aria-hidden="true">LEAGUE</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <a href="tournaments.html">大会情報</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        {ev && <><a href={ev.url}>{ev.displayName}</a><span class="breadcrumb__sep" aria-hidden="true">›</span></>}
        <span aria-current="page">リーグ戦の順位計算</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">League Calculator</p>
          <h1 class="page-title">リーグ戦の順位計算</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">
        リーグ表のマスを押して試合ごとのゲーム数を入れると、勝敗・取得ゲーム率・順位を計算します。計算式と、順位が決まった理由も下に出します。
        {ev && fixedRule && <><br /><b>{ev.name}</b> のルール（{RULE_TEXT[fixedRule].label}）で計算します。</>}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--result">
      <div class="lc" id="lc" data-api={ev && conf ? TOURNAMENT_APP : ''} data-tour={ev?.name ?? ''} data-rule={fixedRule ?? ''} data-n={n0} data-slug={ev?.slug ?? ''} data-formats={formats} data-leagues={JSON.stringify(conf?.leagues ?? [])}>
        {/* 大会・リーグ・試合の形式（上にまとめて小さく） */}
        <div class="lc-box lc-box--top rv">
          {fixedRule ? (
            <p class="lc-rule"><span class="lc-rule__tag">{RULE_TEXT[fixedRule].label}</span>{ev?.name}</p>
          ) : (
            <div class="lc-seg" role="radiogroup" aria-label="順位の決め方">
              {Object.entries(RULE_TEXT).map(([k, r], i) => (
                <label class="lc-seg__opt"><input type="radio" name="lc-rule" value={k} checked={i === 0} /><span>{r.label}</span></label>
              ))}
            </div>
          )}
          {/* 実際のリーグを選べる大会は、チーム名・チームの数が入る */}
          <div class="lc-league" id="lc-league-box" hidden>
            <p class="lc-league__label" id="lc-league-label">リーグを選ぶ</p>
            {/* リーグごとのカード（リーグ名とその中のチーム名）。押すとそのリーグになる。選んだ値は隠した select に持つ */}
            <div class="lc-lgs" id="lc-lgs" role="radiogroup" aria-labelledby="lc-league-label"></div>
            <select id="lc-league" class="lc-league__sel" hidden aria-hidden="true" tabindex="-1"></select>
            <p class="lc-note" id="lc-league-note"></p>
          </div>
          <div class="lc-seg lc-seg--fmt" id="lc-fmts" role="radiogroup" aria-label="試合の形式"></div>
          <div class="lc-seg lc-seg--n" role="radiogroup" aria-label="チームの数">
            {[3, 4, 5, 6, 7].map((k) => (
              <label class="lc-seg__opt"><input type="radio" name="lc-n" value={k} checked={k === n0} /><span>{k}チーム</span></label>
            ))}
          </div>
          <p class="lc-note lc-note--more"><a href="#lc-rules">順位の決め方（詳しいルール）は下にあります ↓</a></p>
        </div>

        {/* リーグ表（マスを押してスコアを入れる。大会運営システムのリーグ表と同じ形） */}
        <div class="lc-box rv">
          <div class="lc-hrow">
            <h2 class="lc-h">リーグ表</h2>
            <div class="lc-hbtns">
              {/* 印刷用のリーグ表を見る／入れた結果をすべて消す（アイコンだけのボタン。名前は aria-label と title） */}
              <button type="button" class="lc-ibtn lc-ibtn--print" id="lc-print-open" aria-label="印刷用のリーグ表を見る" title="印刷用のリーグ表を見る">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M6 14h12v7H6z" /><circle cx="17.5" cy="12" r=".6" fill="currentColor" /></svg>
              </button>
              <button type="button" class="lc-ibtn lc-ibtn--clear" id="lc-clear" aria-label="入れた結果をすべて消す" title="すべて消す">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            </div>
          </div>
          <p class="lc-note lc-note--lead">マスを押すと、その試合のスコア（ゲーム数）を入れられます。左の列のチームから見たスコアで入れてください。</p>
          <p class="lc-warn" id="lc-warn" hidden></p>
          <div class="lc-tablewrap"><table class="lc-grid" id="lc-grid"></table></div>
          <p class="lc-note lc-why-note" id="lc-why-note" hidden></p>
          <div id="lc-pts-box" hidden>
            <h3 class="lc-h3">チーム得点</h3>
            <p class="lc-note lc-note--lead">各チームが MIX・WD・MD で取ったゲーム数と、その合計（得点）。入っている対戦までの数です。</p>
            <div class="lc-tablewrap"><table class="lc-pts" id="lc-pts"></table></div>
          </div>
        </div>

        {/* 順位（全試合の結果が入ってから出す）と計算式 */}
        <div class="lc-box rv">
          <div id="lc-rank-box" hidden>
            <h2 class="lc-h">順位</h2>
            <div class="lc-tablewrap"><table class="lc-table" id="lc-table"></table></div>
            <h3 class="lc-h3">順位の決め方</h3>
            <ol class="lc-log" id="lc-log"></ol>
          </div>
          <p class="lc-wait" id="lc-rank-wait">すべての試合の結果が入ると、ここに順位と、順位が決まった理由が出ます。</p>
          <h3 class="lc-h3">計算式</h3>
          <ul class="lc-calc" id="lc-calc"></ul>
        </div>

        {/* くじ引き（同率で決まらないとき） */}
        <div class="lc-box" id="lc-lot" hidden>
          <h2 class="lc-h">くじ引き（ルーレット）</h2>
          <p class="lc-note" style="margin-top:0">ルールで順位が決まらないチーム（同率で直接対決も引き分けなど）があるので、くじ引きで決めます。「ルーレットを回す」を押すと、上の順位から 1 チームずつ決まります。</p>
          <div class="lc-lot__teams" id="lc-lot-teams"></div>
          <div class="lc-lot__stage">
            <div class="lc-wheel">
              <span class="lc-wheel__pin" aria-hidden="true"></span>
              <canvas id="lc-wheel" width="640" height="640" aria-label="ルーレット"></canvas>
            </div>
            <div class="lc-lot__side">
              <div class="lc-lot__btns">
                <button type="button" class="btn btn--primary" id="lc-spin">ルーレットを回す</button>
                <button type="button" class="btn btn--outline" id="lc-lot-reset">やり直す</button>
              </div>
              <p class="lc-lot__now" id="lc-lot-now" aria-live="polite"></p>
              <ol class="lc-lot__result" id="lc-lot-result"></ol>
            </div>
          </div>
        </div>

        {/* チーム名の入力欄（画面には出さない。名前はリーグ表のチーム名を押して直す。保存・まとめ入力の仕組みはそのまま） */}
        <div class="lc-box rv" hidden>
          <h2 class="lc-h">チーム名</h2>
          <div class="lc-names" id="lc-names"></div>
          <p class="lc-note">実際のチーム名・ペア名に書き換えられます（空けておくと A・B・C… のまま）。リーグ表のチーム名を押しても直せます。</p>
          <details class="lc-bulk">
            <summary>チーム名をまとめて入れる</summary>
            <p class="lc-note">1 行に 1 チームずつ、リーグの順（1 番から）に入れてください。行の数がチームの数になります（3〜7）。</p>
            <textarea id="lc-bulk" rows="5" placeholder={'谷口・近藤\n加藤・酒本\n長谷川・高木\n前田・住吉'}></textarea>
            <button type="button" class="btn btn--outline" id="lc-bulk-ok">この名前で入れる</button>
          </details>
        </div>

        {/* ルールの詳細（下に） */}
        <div class="lc-box rv" id="lc-rules">
          <h2 class="lc-h">ルール（順位の決め方）</h2>
          {fixedRule && <p class="lc-rule lc-rule--head"><span class="lc-rule__tag">{RULE_TEXT[fixedRule].label}</span><span class="lc-rule__ev">{ev?.name}</span></p>}
          {/* 順位の決め方の流れ（上から順に当てはめる）。番号は見えている行だけで数える（CSS の counter） */}
          <ol class="lc-steps lc-flow" id="lc-steps">
            {Object.entries(RULE_TEXT).map(([k, r]) => r.steps.map((s, i, arr) => (
              <li data-rule={k} class:list={['lc-flow__step', i === arr.length - 1 && 'lc-flow__step--last']}>
                <span class="lc-flow__label">{i === 0 ? '順位の基本' : i === arr.length - 1 ? '最後に' : 'それでも並んだら'}</span>
                <span class="lc-flow__text">{s}</span>
              </li>
            )))}
          </ol>
          {conf?.note && (
            <div class="lc-callout">
              <p class="lc-callout__head">この大会の決まり</p>
              <p class="lc-callout__text">{conf.note}</p>
            </div>
          )}
          <div class="lc-formula" id="lc-rate-note">
            <p class="lc-formula__head">取得ゲーム率の計算</p>
            <div class="lc-formula__eq" aria-label="取得ゲーム率 ＝ 取ったゲーム数 ÷（取ったゲーム数 ＋ 取られたゲーム数）">
              <span class="lc-formula__lhs">取得ゲーム率</span><span class="lc-formula__op">＝</span>
              <span class="lc-frac"><span class="lc-frac__num">取ったゲーム数</span><span class="lc-frac__den">取ったゲーム数 ＋ 取られたゲーム数</span></span>
            </div>
            <p class="lc-formula__note">引き分け（同じゲーム数）は勝ち負けに数えず、ゲーム数だけ数えます。</p>
          </div>
        </div>

        {ev && <p class="rv"><a class="ghost-link" href={ev.url}>← {ev.displayName} のページへ</a></p>}

        {/* チーム名を直す小窓（リーグ表のチーム名を押すと開く） */}
        <dialog class="lc-dlg lc-namedlg" id="lc-name-dlg" aria-labelledby="lc-name-title">
          <form method="dialog" class="lc-dlg__form" id="lc-name-form">
            <p class="lc-dlg__title" id="lc-name-title">チーム名を直す</p>
            <input class="lc-namedlg__in" id="lc-name-in" maxlength="20" autocomplete="off" />
            <p class="lc-dlg__hint">空けておくと A・B・C… の表示になります。</p>
            <div class="lc-dlg__btns lc-dlg__btns--2">
              <button type="button" class="btn btn--outline" id="lc-name-cancel">やめる</button>
              <button type="submit" class="btn btn--primary">決定</button>
            </div>
          </form>
        </dialog>

        {/* 印刷用のリーグ表のプレビュー（紙のリーグ表と同じ形） */}
        <dialog class="lc-pv" id="lc-pv" aria-labelledby="lc-pv-title">
          <div class="lc-pv__bar">
            <p class="lc-pv__title" id="lc-pv-title" tabindex="-1" autofocus>印刷用のリーグ表</p>
            <div class="lc-pv__fields">
              <label>種目<input id="pv-title" maxlength="40" placeholder="例 男子B級ダブルス" /></label>
              <label>リーグ<input id="pv-league" maxlength="6" placeholder="A" /></label>
              <label>コート<input id="pv-court" maxlength="20" placeholder="例 No.1 コート" /></label>
              <label>大会名<input id="pv-tour" maxlength="60" /></label>
              <label>用紙<select id="pv-paper"><option value="297x210">A4 横</option><option value="210x297">A4 縦</option><option value="257x182">B5 横</option><option value="364x257">B4 横</option></select></label>
            </div>
            <div class="lc-pv__btns">
              <button type="button" class="btn btn--primary" id="pv-print">印刷する</button>
              <button type="button" class="btn btn--outline" id="pv-close">閉じる</button>
            </div>
          </div>
          <div class="lc-pv__stage" id="pv-stage"></div>
        </dialog>

        {/* スコアを入れる小窓 */}
        <dialog class="lc-dlg" id="lc-dlg" aria-labelledby="lc-dlg-title">
          <form method="dialog" class="lc-dlg__form" id="lc-dlg-form">
            <p class="lc-dlg__title" id="lc-dlg-title">スコアを入れる</p>
            <div class="lc-dlg__heads"><span id="lc-dlg-a">A</span><span></span><span id="lc-dlg-b">B</span></div>
            <div class="lc-dlg__rows" id="lc-dlg-rows"></div>
            <p class="lc-dlg__hint" id="lc-dlg-hint">同じゲーム数（4-4 など）は引き分けです。</p>
            <div class="lc-dlg__btns">
              <button type="button" class="btn btn--outline" id="lc-dlg-del">消す</button>
              <button type="button" class="btn btn--outline" id="lc-dlg-cancel">やめる</button>
              <button type="submit" class="btn btn--primary" id="lc-dlg-ok">決定</button>
            </div>
          </form>
        </dialog>
      </div>
    </div>
  </section>
</Base>

<script>
  type Rule = 'wins' | 'games' | 'team';
  type Fmt = { key: string; label: string; total: number | null; matches?: string[]; matchNames?: string[]; for?: string };
  type LeagueData = { name: string; type: string; rankRule: string; players: { position: number; name: string; affiliation: string; partnerName?: string; partnerAffiliation?: string }[] };
  const root = document.getElementById('lc')!;
  const LETTERS = 'ABCDEFG';
  const fixed = (root.dataset.rule || '') as Rule | '';
  const FORMATS: Record<string, Fmt[]> = JSON.parse(root.dataset.formats || '{}');
  let n = Number(root.dataset.n) || 4;
  let names: string[] = Array(7).fill('');
  let fmtKey = '';
  // data[形式] … scores[試合][i][j]：i 対 j の i 側のゲーム数（文字列。空なら未入力）。チーム対抗戦は 1 対戦に複数の試合
  let data: Record<string, string[][][]> = {};
  const KEY = `tcta-league-calc2:${root.dataset.slug || 'free'}`;
  let savedRule: Rule | '' = '';
  // 選んでいるリーグ（大会運営システムの種目名。空なら自分で入れる）と、リーグごとのチーム名・チームの数
  let league = '';
  let byLeague: Record<string, { n: number; names: string[] }> = {};
  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s) { n = s.n ?? n; names = s.names ?? names; fmtKey = s.fmt ?? ''; data = s.data ?? {}; savedRule = s.rule ?? ''; league = s.league ?? ''; byLeague = s.byLeague ?? {}; }
  } catch { /* 保存できない環境 */ }
  const save = () => {
    byLeague[league] = { n, names: [...names] };
    try { localStorage.setItem(KEY, JSON.stringify({ n, names, fmt: fmtKey, data, rule: rule(), league, byLeague })); } catch { /* */ }
  };

  if (!fixed && savedRule) { const el = document.querySelector<HTMLInputElement>(`input[name=lc-rule][value=${savedRule}]`); if (el) el.checked = true; }
  const rule = (): Rule => (fixed || ((document.querySelector('input[name=lc-rule]:checked') as HTMLInputElement)?.value as Rule) || 'wins');
  const formats = (): Fmt[] => FORMATS[rule()] ?? [{ key: 'free', label: '', total: null }];
  const fmt = (): Fmt => formats().find((x) => x.key === fmtKey) ?? formats()[0];
  const M = () => fmt().matches?.length ?? 1;
  const blank = () => Array.from({ length: 6 }, () => Array.from({ length: 7 }, () => Array(7).fill('')));
  const S = () => (data[(league ? `${league}|` : '') + fmt().key] ??= blank());
  const nameOf = (i: number) => names[i].trim() || LETTERS[i];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const pct = (r: number) => `${(Math.round(r * 1000) / 10).toFixed(1)}%`;
  const digits = (v: string) => v.replace(/[０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xFEE0)).replace(/\D/g, '').slice(0, 2);
  const pairs = () => { const p: [number, number][] = []; for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) p.push([i, j]); return p; };

  function renderFormats() {
    const box = document.getElementById('lc-fmts')!;
    const list = formats();
    if (!list.some((x) => x.key === fmtKey)) fmtKey = list[0].key;
    box.hidden = list.length < 2;
    box.innerHTML = list.map((x) => `<label class="lc-seg__opt"><input type="radio" name="lc-fmt" value="${x.key}" ${x.key === fmtKey ? 'checked' : ''}><span>${esc(x.label || 'ゲーム数を入れる')}</span></label>`).join('');
    box.querySelectorAll<HTMLInputElement>('input').forEach((el) => el.addEventListener('change', () => { fmtKey = el.value; save(); compute(); }));
  }

  function renderNames() {
    const box = document.getElementById('lc-names')!;
    box.innerHTML = Array.from({ length: n }, (_, i) =>
      `<label class="lc-name"><span>${LETTERS[i]}</span><input type="text" maxlength="20" data-i="${i}" value="${esc(names[i])}" placeholder="${LETTERS[i]}"></label>`).join('');
    box.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => {
      names[Number(el.dataset.i)] = el.value; save(); compute();
    }));
  }

  // ---- スコアを入れる小窓（リーグ表のマスを押すと開く） ----
  //   1 試合の合計ゲーム数が決まっている形式（合計 8 ゲームなど）は、片方を入れるともう片方が「合計 − その数」で入る
  const dlg = document.getElementById('lc-dlg') as HTMLDialogElement;
  const rowsBox = document.getElementById('lc-dlg-rows')!;
  let cur: [number, number] | null = null;
  const dlgInputs = () => [...rowsBox.querySelectorAll<HTMLInputElement>('.lc-dlg__in')];
  function openCell(i: number, j: number) {
    cur = [i, j];
    const f = fmt(), sc = S();
    document.getElementById('lc-dlg-title')!.textContent = `${nameOf(i)} 対 ${nameOf(j)}`;
    document.getElementById('lc-dlg-a')!.textContent = nameOf(i);
    document.getElementById('lc-dlg-b')!.textContent = nameOf(j);
    const labels = f.matches ?? [''];
    rowsBox.innerHTML = labels.map((lb, m) => `
      <div class="lc-dlg__row">
        ${lb ? `<span class="lc-dlg__mlabel"><b>${esc(lb)}</b>${f.matchNames?.[m] ? `<small>${esc(f.matchNames[m])}</small>` : ''}</span>` : ''}
        <input class="lc-dlg__in" data-m="${m}" data-s="0" inputmode="numeric" maxlength="2" autocomplete="off" aria-label="${esc(lb)} ${esc(nameOf(i))} のゲーム数" value="${esc(sc[m][i][j])}">
        <span class="lc-dlg__sep">-</span>
        <input class="lc-dlg__in" data-m="${m}" data-s="1" inputmode="numeric" maxlength="2" autocomplete="off" aria-label="${esc(lb)} ${esc(nameOf(j))} のゲーム数" value="${esc(sc[m][j][i])}">
      </div>`).join('');
    rowsBox.classList.toggle('is-multi', labels.length > 1);
    document.getElementById('lc-dlg-hint')!.textContent = f.total
      ? `1 試合は合計 ${f.total} ゲームです。片方を入れると、もう片方は自動で入ります（${f.total / 2}-${f.total / 2} は引き分け）。`
      : '同じゲーム数（4-4 など）は引き分けです。';
    const ins = dlgInputs();
    ins.forEach((el, k) => {
      el.addEventListener('input', () => {
        el.value = digits(el.value);
        const partner = ins[k % 2 === 0 ? k + 1 : k - 1];
        const total = fmt().total;
        if (total != null && el.value !== '' && Number(el.value) <= total) {
