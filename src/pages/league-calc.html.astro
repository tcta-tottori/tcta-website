  function splitName(name: string): [string, string] {
    const ch = Array.from(name.trim());
    const mid = ch.length / 2;
    const kind = (c: string) => (/[゠-ヿ]/.test(c) ? 'k' : /[぀-ゟ]/.test(c) ? 'h' : /[一-鿿]/.test(c) ? 'c' : /[A-Za-z0-9Ａ-Ｚａ-ｚ０-９]/.test(c) ? 'a' : 'o');
