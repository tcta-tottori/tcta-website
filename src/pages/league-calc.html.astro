---
// リーグ戦の順位計算（誰でも使える）。要項・ドローのページの下のリンク（league-rules.js に書いた大会）から開く。
//   league-calc.html?e=<大会の slug>  … その大会のルール（勝数が先／取得ゲーム率が先／チーム対抗戦）と試合の形式で計算する
//   league-calc.html                  … ルールを画面で選ぶ
// チームは A〜G（3〜7 チーム）。名前は書き換えられる。リーグ表のマスを押してゲーム数を入れると、勝敗・取得ゲーム率・順位と、
// その計算式・順位の決め手を出す（順位は全試合が入ってから）。ルールで決まらないときだけ、くじ引き（ルーレット）を出す。
// 勝数が先・取得ゲーム率が先は、大会運営システム（tournament/src/features/draw/leagueStandings.ts）と同じ決め方。
import Base from '../layouts/Base.astro';
import { siteData } from '../lib/cms.js';
import { RULE_TEXT, DEFAULT_FORMATS, leagueRuleOf } from '../data/league-rules.js';

const slug = Astro.url.searchParams.get('e') ?? '';
const site = await siteData(Astro);
const ev = slug ? site.eventBySlug(slug) : null;
const conf = ev ? leagueRuleOf(ev.slug) : null;
const fixedRule = conf?.rule ?? null;
const nParam = Number(Astro.url.searchParams.get('n'));
const n0 = Number.isInteger(nParam) && nParam >= 3 && nParam <= 7 ? nParam : (conf?.teams ?? 4);
const formats = JSON.stringify(conf ? { [conf.rule]: conf.formats } : DEFAULT_FORMATS);
const title = `リーグ戦の順位計算${ev ? `（${ev.name}）` : ''}｜鳥取市テニス協会`;
const description = 'リーグ戦（総当たり）の勝敗・取得ゲーム率・順位を、大会のルールに沿って計算するページです。計算式と順位の決め手も確かめられます。';
---

<Base title={title} description={description} navActive="tournaments" mobileNavActive="tournaments">
  <section class="page-head">
    <span class="ghost" aria-hidden="true">LEAGUE</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <a href="tournaments.html">大会情報</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        {ev && <><a href={ev.url}>{ev.displayName}</a><span class="breadcrumb__sep" aria-hidden="true">›</span></>}
        <span aria-current="page">リーグ戦の順位計算</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">League Calculator</p>
          <h1 class="page-title">リーグ戦の順位計算</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">
        リーグ表のマスを押して試合ごとのゲーム数を入れると、勝敗・取得ゲーム率・順位を計算します。計算式と、順位が決まった理由も下に出します。
        {ev && fixedRule && <><br /><b>{ev.name}</b> のルール（{RULE_TEXT[fixedRule].label}）で計算します。</>}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--result">
      <div class="lc" id="lc" data-rule={fixedRule ?? ''} data-n={n0} data-slug={ev?.slug ?? ''} data-formats={formats}>
        {/* ルール */}
        <div class="lc-box rv">
          <h2 class="lc-h">ルール</h2>
          {fixedRule ? (
            <p class="lc-rule"><span class="lc-rule__tag">{RULE_TEXT[fixedRule].label}</span>{ev?.name}</p>
          ) : (
            <div class="lc-seg" role="radiogroup" aria-label="順位の決め方">
              {Object.entries(RULE_TEXT).map(([k, r], i) => (
                <label class="lc-seg__opt"><input type="radio" name="lc-rule" value={k} checked={i === 0} /><span>{r.label}</span></label>
              ))}
            </div>
          )}
          <div class="lc-seg lc-seg--fmt" id="lc-fmts" role="radiogroup" aria-label="試合の形式"></div>
          <ol class="lc-steps" id="lc-steps">
            {Object.entries(RULE_TEXT).map(([k, r]) => r.steps.map((s) => <li data-rule={k}>{s}</li>))}
          </ol>
          {conf?.note && <p class="lc-note">{conf.note}</p>}
          <p class="lc-note" id="lc-rate-note">取得ゲーム率 ＝ 取ったゲーム数 ÷（取ったゲーム数 ＋ 取られたゲーム数）。引き分け（同じゲーム数）は勝ち負けに数えず、ゲーム数だけ数えます。</p>
        </div>

        {/* チーム */}
        <div class="lc-box rv">
          <h2 class="lc-h">チーム</h2>
          <div class="lc-seg lc-seg--n" role="radiogroup" aria-label="チームの数">
            {[3, 4, 5, 6, 7].map((k) => (
              <label class="lc-seg__opt"><input type="radio" name="lc-n" value={k} checked={k === n0} /><span>{k}チーム</span></label>
            ))}
          </div>
          <div class="lc-names" id="lc-names"></div>
          <p class="lc-note">名前は書き換えられます（空けておくと A・B・C… のまま）。</p>
        </div>

        {/* リーグ表（マスを押してスコアを入れる。大会運営システムのリーグ表と同じ形） */}
        <div class="lc-box rv">
          <div class="lc-hrow">
            <h2 class="lc-h">リーグ表</h2>
            <button type="button" class="lc-clear" id="lc-clear">すべて消す</button>
          </div>
          <p class="lc-note lc-note--lead">マスを押すと、その試合のスコア（ゲーム数）を入れられます。左の列のチームから見たスコアで入れてください。</p>
          <p class="lc-warn" id="lc-warn" hidden></p>
          <div class="lc-tablewrap"><table class="lc-grid" id="lc-grid"></table></div>
          <div id="lc-pts-box" hidden>
            <h3 class="lc-h3">チーム得点</h3>
            <p class="lc-note lc-note--lead">各チームが MIX・WD・MD で取ったゲーム数と、その合計（得点）。入っている対戦までの数です。</p>
            <div class="lc-tablewrap"><table class="lc-pts" id="lc-pts"></table></div>
          </div>
        </div>

        {/* 順位（全試合の結果が入ってから出す）と計算式 */}
        <div class="lc-box rv">
          <div id="lc-rank-box" hidden>
            <h2 class="lc-h">順位</h2>
            <div class="lc-tablewrap"><table class="lc-table" id="lc-table"></table></div>
            <h3 class="lc-h3">順位の決め方</h3>
            <ol class="lc-log" id="lc-log"></ol>
          </div>
          <p class="lc-wait" id="lc-rank-wait">すべての試合の結果が入ると、ここに順位と、順位が決まった理由が出ます。</p>
          <h3 class="lc-h3">計算式</h3>
          <ul class="lc-calc" id="lc-calc"></ul>
        </div>

        {/* くじ引き（同率で決まらないとき） */}
        <div class="lc-box" id="lc-lot" hidden>
          <h2 class="lc-h">くじ引き（ルーレット）</h2>
          <p class="lc-note" style="margin-top:0">ルールで順位が決まらないチーム（同率で直接対決も引き分けなど）があるので、くじ引きで決めます。「ルーレットを回す」を押すと、上の順位から 1 チームずつ決まります。</p>
          <div class="lc-lot__teams" id="lc-lot-teams"></div>
          <div class="lc-lot__stage">
            <div class="lc-wheel">
              <span class="lc-wheel__pin" aria-hidden="true"></span>
              <canvas id="lc-wheel" width="640" height="640" aria-label="ルーレット"></canvas>
            </div>
            <div class="lc-lot__side">
              <div class="lc-lot__btns">
                <button type="button" class="btn btn--primary" id="lc-spin">ルーレットを回す</button>
                <button type="button" class="btn btn--outline" id="lc-lot-reset">やり直す</button>
              </div>
              <p class="lc-lot__now" id="lc-lot-now" aria-live="polite"></p>
              <ol class="lc-lot__result" id="lc-lot-result"></ol>
            </div>
          </div>
        </div>

        {ev && <p class="rv"><a class="ghost-link" href={ev.url}>← {ev.displayName} のページへ</a></p>}

        {/* スコアを入れる小窓 */}
        <dialog class="lc-dlg" id="lc-dlg" aria-labelledby="lc-dlg-title">
          <form method="dialog" class="lc-dlg__form" id="lc-dlg-form">
            <p class="lc-dlg__title" id="lc-dlg-title">スコアを入れる</p>
            <div class="lc-dlg__heads"><span id="lc-dlg-a">A</span><span></span><span id="lc-dlg-b">B</span></div>
            <div class="lc-dlg__rows" id="lc-dlg-rows"></div>
            <p class="lc-dlg__hint" id="lc-dlg-hint">同じゲーム数（4-4 など）は引き分けです。</p>
            <div class="lc-dlg__btns">
              <button type="button" class="btn btn--outline" id="lc-dlg-del">消す</button>
              <button type="button" class="btn btn--outline" id="lc-dlg-cancel">やめる</button>
              <button type="submit" class="btn btn--primary" id="lc-dlg-ok">決定</button>
            </div>
          </form>
        </dialog>
      </div>
    </div>
  </section>
</Base>

<script>
  type Rule = 'wins' | 'games' | 'team';
  type Fmt = { key: string; label: string; total: number | null; matches?: string[]; matchNames?: string[] };
  const root = document.getElementById('lc')!;
  const LETTERS = 'ABCDEFG';
  const fixed = (root.dataset.rule || '') as Rule | '';
  const FORMATS: Record<string, Fmt[]> = JSON.parse(root.dataset.formats || '{}');
  let n = Number(root.dataset.n) || 4;
  let names: string[] = Array(7).fill('');
  let fmtKey = '';
  // data[形式] … scores[試合][i][j]：i 対 j の i 側のゲーム数（文字列。空なら未入力）。チーム対抗戦は 1 対戦に複数の試合
  let data: Record<string, string[][][]> = {};
  const KEY = `tcta-league-calc2:${root.dataset.slug || 'free'}`;
  let savedRule: Rule | '' = '';
  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s) { n = s.n ?? n; names = s.names ?? names; fmtKey = s.fmt ?? ''; data = s.data ?? {}; savedRule = s.rule ?? ''; }
  } catch { /* 保存できない環境 */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify({ n, names, fmt: fmtKey, data, rule: rule() })); } catch { /* */ } };

  if (!fixed && savedRule) { const el = document.querySelector<HTMLInputElement>(`input[name=lc-rule][value=${savedRule}]`); if (el) el.checked = true; }
  const rule = (): Rule => (fixed || ((document.querySelector('input[name=lc-rule]:checked') as HTMLInputElement)?.value as Rule) || 'wins');
  const formats = (): Fmt[] => FORMATS[rule()] ?? [{ key: 'free', label: '', total: null }];
  const fmt = (): Fmt => formats().find((x) => x.key === fmtKey) ?? formats()[0];
  const M = () => fmt().matches?.length ?? 1;
  const blank = () => Array.from({ length: 6 }, () => Array.from({ length: 7 }, () => Array(7).fill('')));
  const S = () => (data[fmt().key] ??= blank());
  const nameOf = (i: number) => names[i].trim() || LETTERS[i];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const pct = (r: number) => `${(Math.round(r * 1000) / 10).toFixed(1)}%`;
  const digits = (v: string) => v.replace(/[０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xFEE0)).replace(/\D/g, '').slice(0, 2);
  const pairs = () => { const p: [number, number][] = []; for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) p.push([i, j]); return p; };

  function renderFormats() {
    const box = document.getElementById('lc-fmts')!;
    const list = formats();
    if (!list.some((x) => x.key === fmtKey)) fmtKey = list[0].key;
    box.hidden = list.length < 2;
    box.innerHTML = list.map((x) => `<label class="lc-seg__opt"><input type="radio" name="lc-fmt" value="${x.key}" ${x.key === fmtKey ? 'checked' : ''}><span>${esc(x.label || 'ゲーム数を入れる')}</span></label>`).join('');
    box.querySelectorAll<HTMLInputElement>('input').forEach((el) => el.addEventListener('change', () => { fmtKey = el.value; save(); compute(); }));
  }

  function renderNames() {
    const box = document.getElementById('lc-names')!;
    box.innerHTML = Array.from({ length: n }, (_, i) =>
      `<label class="lc-name"><span>${LETTERS[i]}</span><input type="text" maxlength="20" data-i="${i}" value="${esc(names[i])}" placeholder="${LETTERS[i]}"></label>`).join('');
    box.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => {
      names[Number(el.dataset.i)] = el.value; save(); compute();
    }));
  }

  // ---- スコアを入れる小窓（リーグ表のマスを押すと開く） ----
  //   1 試合の合計ゲーム数が決まっている形式（合計 8 ゲームなど）は、片方を入れるともう片方が「合計 − その数」で入る
  const dlg = document.getElementById('lc-dlg') as HTMLDialogElement;
  const rowsBox = document.getElementById('lc-dlg-rows')!;
  let cur: [number, number] | null = null;
  const dlgInputs = () => [...rowsBox.querySelectorAll<HTMLInputElement>('.lc-dlg__in')];
  function openCell(i: number, j: number) {
    cur = [i, j];
    const f = fmt(), sc = S();
    document.getElementById('lc-dlg-title')!.textContent = `${nameOf(i)} 対 ${nameOf(j)}`;
    document.getElementById('lc-dlg-a')!.textContent = nameOf(i);
    document.getElementById('lc-dlg-b')!.textContent = nameOf(j);
    const labels = f.matches ?? [''];
    rowsBox.innerHTML = labels.map((lb, m) => `
      <div class="lc-dlg__row">
        ${lb ? `<span class="lc-dlg__mlabel"><b>${esc(lb)}</b>${f.matchNames?.[m] ? `<small>${esc(f.matchNames[m])}</small>` : ''}</span>` : ''}
        <input class="lc-dlg__in" data-m="${m}" data-s="0" inputmode="numeric" maxlength="2" autocomplete="off" aria-label="${esc(lb)} ${esc(nameOf(i))} のゲーム数" value="${esc(sc[m][i][j])}">
        <span class="lc-dlg__sep">-</span>
        <input class="lc-dlg__in" data-m="${m}" data-s="1" inputmode="numeric" maxlength="2" autocomplete="off" aria-label="${esc(lb)} ${esc(nameOf(j))} のゲーム数" value="${esc(sc[m][j][i])}">
      </div>`).join('');
    rowsBox.classList.toggle('is-multi', labels.length > 1);
    document.getElementById('lc-dlg-hint')!.textContent = f.total
      ? `1 試合は合計 ${f.total} ゲームです。片方を入れると、もう片方は自動で入ります（${f.total / 2}-${f.total / 2} は引き分け）。`
      : '同じゲーム数（4-4 など）は引き分けです。';
    const ins = dlgInputs();
    ins.forEach((el, k) => {
      el.addEventListener('input', () => {
        el.value = digits(el.value);
        const partner = ins[k % 2 === 0 ? k + 1 : k - 1];
        const total = fmt().total;
        if (total != null && el.value !== '' && Number(el.value) <= total) {
          partner.value = String(total - Number(el.value));
          // その試合は決まったので、次の試合の左の欄（最後なら「決定」）へ
          const next = ins[(Math.floor(k / 2) + 1) * 2];
          if (next) { next.focus(); next.select(); } else (document.getElementById('lc-dlg-ok') as HTMLButtonElement).focus();
          return;
        }
        if (total == null && (el.value.length >= 2 || (el.value.length === 1 && el.value !== '1'))) {
          const next = ins[k + 1];
          if (next) { next.focus(); next.select(); } else (document.getElementById('lc-dlg-ok') as HTMLButtonElement).focus();
        }
      });
      el.addEventListener('focus', () => {
        el.select();
        // キーボードが出たあとに、入力中の欄が見える位置へ（小窓の中だけ動かす）
        setTimeout(() => el.scrollIntoView({ block: 'nearest', inline: 'nearest' }), 120);
      });
    });
    dlg.showModal();
    fitDialog();
    setTimeout(() => { ins[0]?.focus(); ins[0]?.select(); }, 30);
  }
  document.getElementById('lc-dlg-form')!.addEventListener('submit', (ev) => {
    if (!cur) return;
    const [i, j] = cur;
    const ins = dlgInputs();
    const filled = ins.filter((x) => x.value !== '').length;
    if (filled !== 0 && filled !== ins.length) { ev.preventDefault(); ins.find((x) => x.value === '')?.focus(); return; }
    const sc = S();
    for (let m = 0; m < M(); m++) { sc[m][i][j] = ins[m * 2].value; sc[m][j][i] = ins[m * 2 + 1].value; }
    save(); compute();
  });
  document.getElementById('lc-dlg-del')!.addEventListener('click', () => {
    if (!cur) return;
    const [i, j] = cur, sc = S();
    for (let m = 0; m < M(); m++) { sc[m][i][j] = ''; sc[m][j][i] = ''; }
    save(); compute(); dlg.close();
  });
  document.getElementById('lc-dlg-cancel')!.addEventListener('click', () => dlg.close());
  // スマホでキーボードが出たら、見えている範囲（visualViewport）に小窓を収める：上に寄せ、高さを縮めて中をスクロール
  function fitDialog() {
    const vv = window.visualViewport;
    if (!dlg.open) return;
    if (!vv || window.innerWidth >= 640) { dlg.style.top = ''; dlg.style.maxHeight = ''; return; }
    dlg.style.top = `${Math.round(vv.offsetTop + 8)}px`;
    dlg.style.maxHeight = `${Math.round(vv.height - 16)}px`;
    const active = document.activeElement as HTMLElement | null;
    if (active && dlg.contains(active)) active.scrollIntoView({ block: 'nearest' });
  }
  window.visualViewport?.addEventListener('resize', fitDialog);
  window.visualViewport?.addEventListener('scroll', fitDialog);
  dlg.addEventListener('close', () => { dlg.style.top = ''; dlg.style.maxHeight = ''; });
  dlg.addEventListener('click', (ev) => { if (ev.target === dlg) dlg.close(); });

  let tiedGroups: number[][] = [];
  function compute() {
    renderFormats();
    const r = rule(), f = fmt(), sc = S(), mm = M();
    const team = r === 'team';
    document.querySelectorAll<HTMLElement>('#lc-steps li').forEach((li) => { li.hidden = li.dataset.rule !== r; });
    document.getElementById('lc-rate-note')!.hidden = team;
    const ids = Array.from({ length: n }, (_, i) => i);
    const played = (i: number, j: number) => { for (let m = 0; m < mm; m++) if (sc[m][i][j] === '' || sc[m][j][i] === '') return false; return true; };
    const tot = (i: number, j: number) => { let s = 0; for (let m = 0; m < mm; m++) s += Number(sc[m][i][j]); return s; };
    const st = ids.map(() => ({ w: 0, l: 0, d: 0, gw: 0, gl: 0, mix: 0, by: Array(mm).fill(0) as number[] }));
    let missing = 0;
    for (const [i, j] of pairs()) {
      if (!played(i, j)) { missing++; continue; }
      const a = tot(i, j), b = tot(j, i);
      st[i].gw += a; st[i].gl += b; st[j].gw += b; st[j].gl += a;
      st[i].mix += Number(sc[0][i][j]); st[j].mix += Number(sc[0][j][i]);
      for (let m = 0; m < mm; m++) { st[i].by[m] += Number(sc[m][i][j]); st[j].by[m] += Number(sc[m][j][i]); }
      if (a > b) { st[i].w++; st[j].l++; } else if (b > a) { st[j].w++; st[i].l++; } else { st[i].d++; st[j].d++; }
    }
    const rate = (i: number) => { const t = st[i].gw + st[i].gl; return t > 0 ? st[i].gw / t : 0; };
    const keyFn: Record<string, (i: number) => number> = { rate, wins: (i) => st[i].w, gw: (i) => st[i].gw, mix: (i) => st[i].mix };
    const keyName: Record<string, string> = { rate: '取得ゲーム率', wins: '勝数', gw: '得点（獲得ゲーム数の合計）', mix: f.matches ? `${f.matches[0]}の獲得ゲーム数` : '' };
    const fmtKeyV = (k: string, i: number) => (k === 'rate' ? pct(rate(i)) : k === 'wins' ? `${st[i].w}勝` : `${keyFn[k](i)}ゲーム`);
    const h2h = (a: number, b: number) => { if (!played(a, b)) return 0; const x = tot(a, b), y = tot(b, a); return x > y ? -1 : y > x ? 1 : 0; };
    const names_ = (g: number[]) => g.map(nameOf).join('・');
    const log: string[] = [];
    const tied = new Set<number>();
    const reason = new Map<number, string>();

    const order = (g: number[], keys: string[], depth: number): number[] => {
      if (g.length <= 1) return g;
      if (g.length === 2) {
        const h = h2h(g[0], g[1]);
        if (h !== 0) {
          const [win, lose] = h < 0 ? g : [g[1], g[0]];
          log.push(`${names_(g)} が並んだので、2チームの直接対決で決めます：${nameOf(win)} が ${tot(win, lose)}-${tot(lose, win)} で上回る → ${nameOf(win)} が上。`);
          reason.set(win, reason.get(win) ?? `直接対決で${nameOf(lose)}に勝ち`);
          reason.set(lose, reason.get(lose) ?? `直接対決で${nameOf(win)}に負け`);
          return [win, lose];
        }
        log.push(`${names_(g)} が並びましたが、直接対決は${played(g[0], g[1]) ? `同じゲーム数（${tot(g[0], g[1])}-${tot(g[1], g[0])}）な` : 'まだ入っていない'}ので決まりません。`);
      }
      if (keys.length === 0) {
        tiedGroups.push([...g]);
        log.push(`${names_(g)} は決め方のどれでも並んだままです（下のくじ引きで決めます）。`);
        g.forEach((i) => { tied.add(i); reason.set(i, reason.get(i) ?? '同率（くじ引き）'); });
        return g;
      }
      const [k, ...rest] = keys;
      const groups = new Map<number, number[]>();
      for (const i of g) { const v = Math.round(keyFn[k](i) * 1e9); groups.set(v, [...(groups.get(v) ?? []), i]); }
      if (groups.size === 1) {
        if (g.length >= 3) log.push(`${names_(g)} の ${g.length} チームが並んだので、${keyName[k]}で比べます：${g.map((i) => `${nameOf(i)} ${fmtKeyV(k, i)}`).join('、')}。`);
        return order(g, rest, depth + 1);
      }
      const sorted = [...groups.entries()].sort((a, b) => b[0] - a[0]);
      if (depth > 0) {
        log.push(`${names_(g)} を${keyName[k]}で比べます：${g.map((i) => `${nameOf(i)} ${fmtKeyV(k, i)}`).join('、')}。`);
        for (const [, sg] of sorted) if (sg.length === 1) reason.set(sg[0], reason.get(sg[0]) ?? keyName[k]);
      }
      return sorted.flatMap(([, sg]) => order(sg, rest, depth + 1));
    };

    tiedGroups = [];
    const first = r === 'games' ? 'rate' : r === 'team' ? 'gw' : 'wins';
    const next = r === 'games' ? ['wins'] : r === 'team' ? ['mix'] : ['rate'];
    log.push(`${keyName[first]}で並べます：${ids.map((i) => `${nameOf(i)} ${fmtKeyV(first, i)}`).join('、')}。`);
    const groups = new Map<number, number[]>();
    for (const i of ids) { const v = Math.round(keyFn[first](i) * 1e9); groups.set(v, [...(groups.get(v) ?? []), i]); }
    const top = [...groups.entries()].sort((a, b) => b[0] - a[0]);
    for (const [, g] of top) if (g.length === 1) reason.set(g[0], keyName[first]);
    const ranking = top.flatMap(([, g]) => order(g, next, 1));
    const rankOf = new Map<number, number>();
    ranking.forEach((i, k) => rankOf.set(i, k + 1));
    const done = missing === 0;
    const hasDraw = st.some((s) => s.d);

    const warn = document.getElementById('lc-warn')!;
    warn.hidden = done;
    warn.textContent = done ? '' : `あと ${missing} ${team ? '対戦' : '試合'}の結果が入ると、順位が出ます。`;

    // 順位の表
    const table = document.getElementById('lc-table')!;
    table.innerHTML = team
      ? `<thead><tr><th>順位</th><th>チーム</th><th>得点</th>${(f.matches ?? []).map((lb) => `<th>${esc(lb)}</th>`).join('')}<th>決め手</th></tr></thead><tbody>${
        ranking.map((i) => `<tr class="${rankOf.get(i) === 1 ? 'is-top' : ''}"><td class="lc-rank">${tied.has(i) ? `${rankOf.get(i)}<small>（同率）</small>` : rankOf.get(i)}位</td><td class="lc-team">${esc(nameOf(i))}</td><td class="lc-rate">${st[i].gw}</td>${st[i].by.map((v) => `<td>${v}</td>`).join('')}<td class="lc-why">${esc(reason.get(i) ?? '')}</td></tr>`).join('')}</tbody>`
      : `<thead><tr><th>順位</th><th>チーム</th><th>勝-敗${hasDraw ? '-分' : ''}</th><th>取得</th><th>失</th><th>取得ゲーム率</th><th>決め手</th></tr></thead><tbody>${
        ranking.map((i) => `<tr class="${rankOf.get(i) === 1 ? 'is-top' : ''}"><td class="lc-rank">${tied.has(i) ? `${rankOf.get(i)}<small>（同率）</small>` : rankOf.get(i)}位</td><td class="lc-team">${esc(nameOf(i))}</td><td>${st[i].w}-${st[i].l}${hasDraw ? `-${st[i].d}` : ''}</td><td>${st[i].gw}</td><td>${st[i].gl}</td><td class="lc-rate">${st[i].gw + st[i].gl ? pct(rate(i)) : '—'}</td><td class="lc-why">${esc(reason.get(i) ?? '')}</td></tr>`).join('')}</tbody>`;

    // リーグ表：大会運営システムのリーグ表と同じ形（角丸の外枠・見出しの下に赤線・自分同士は斜線・勝ちは淡い赤地に赤字）
    const grid = document.getElementById('lc-grid')!;
    const statHead = team
      ? '<th class="lc-g__stat">得点</th>'
      : r === 'games' ? '<th class="lc-g__stat">取得ゲーム率</th>' : '<th class="lc-g__stat">勝敗</th><th class="lc-g__stat">勝率</th>';
    const statCells = (i: number) => {
      const t = st[i].gw + st[i].gl;
      if (team) return `<td class="lc-g__stat"><b class="lc-g__pts">${t ? st[i].gw : ''}</b></td>`;
      if (r === 'games') return `<td class="lc-g__stat">${t ? `<b class="lc-g__rate">${pct(rate(i))}</b><small>${st[i].gw}/${t}ゲーム</small>` : ''}</td>`;
      const pl = st[i].w + st[i].l + st[i].d;
      return `<td class="lc-g__stat"><b>${pl ? `${st[i].w}-${st[i].l}${hasDraw ? `-${st[i].d}` : ''}` : ''}</b></td><td class="lc-g__stat lc-g__sub">${t ? rate(i).toFixed(3) : ''}</td>`;
    };
    grid.classList.toggle('lc-grid--team', team);
    grid.innerHTML = `<thead><tr><th class="lc-g__title">リーグ</th>${ids.map((j) => `<th class="lc-g__col">${esc(nameOf(j))}</th>`).join('')}${statHead}<th class="lc-g__stat">順位</th></tr></thead><tbody>${
      ids.map((i) => {
        const rk = rankOf.get(i);
        const champ = done && rk === 1;
        return `<tr><td class="lc-g__name"><span class="lc-g__no">${i + 1}</span><span class="lc-g__team${champ ? ' is-champ' : ''}">${esc(nameOf(i))}</span></td>${ids.map((j) => {
          if (i === j) return '<td class="lc-g__self" aria-hidden="true"></td>';
          const label = `${esc(nameOf(i))} 対 ${esc(nameOf(j))}`;
          if (!played(i, j)) return `<td><button type="button" class="lc-cell lc-cell--empty" data-i="${i}" data-j="${j}" aria-label="${label} のスコアを入れる">入力</button></td>`;
          const a = tot(i, j), b = tot(j, i);
          if (team) {
            // チーム対抗戦：上に対戦の合計（得点）、下に MIX・WD・MD を 1 行ずつ（取った側を赤字）
            const rows = (f.matches ?? []).map((lb, m) => {
              const x = Number(sc[m][i][j]), y = Number(sc[m][j][i]);
              return `<span class="lc-tie__row ${x > y ? 'is-w' : x < y ? 'is-l' : ''}"><i>${esc(lb)}</i><b>${x}-${y}</b></span>`;
            }).join('');
            return `<td class="${a > b ? 'is-win' : a < b ? 'is-lose' : 'is-draw'}"><button type="button" class="lc-cell lc-tie" data-i="${i}" data-j="${j}" aria-label="${label} 合計${a}-${b}（押して直す）"><span class="lc-tie__tot">${a}<small>-</small>${b}</span><span class="lc-tie__rows">${rows}</span></button></td>`;
          }
          return `<td class="${a > b ? 'is-win' : a < b ? 'is-lose' : 'is-draw'}"><button type="button" class="lc-cell" data-i="${i}" data-j="${j}" aria-label="${label} ${a}-${b}（押して直す）">${a}-${b}</button></td>`;
        }).join('')}${statCells(i)}<td class="lc-g__stat lc-g__rank${champ ? ' is-champ' : ''}">${done ? (tied.has(i) ? `${rk}位<small>同率</small>` : `${rk}位`) : ''}</td></tr>`;
      }).join('')}</tbody>`;
    grid.querySelectorAll<HTMLButtonElement>('.lc-cell').forEach((b) => b.addEventListener('click', () => openCell(Number(b.dataset.i), Number(b.dataset.j))));

    // チーム得点（チーム対抗戦だけ）：チームごとに MIX・WD・MD・得点。全対戦が入れば順位も
    const ptsBox = document.getElementById('lc-pts-box')!;
    ptsBox.hidden = !team;
    if (team) {
      const maxBy = (f.matches ?? []).map((_, m) => Math.max(...ids.map((i) => st[i].by[m])));
      const maxPts = Math.max(...ids.map((i) => st[i].gw));
      document.getElementById('lc-pts')!.innerHTML = `<thead><tr><th class="lc-pts__team">チーム</th>${(f.matches ?? []).map((lb, m) => `<th>${esc(lb)}<small>${esc(f.matchNames?.[m] ?? '')}</small></th>`).join('')}<th class="lc-pts__sum">得点</th><th>順位</th></tr></thead><tbody>${
        ids.map((i) => `<tr><td class="lc-pts__team"><span class="lc-g__no">${i + 1}</span>${esc(nameOf(i))}</td>${st[i].by.map((v, m) => `<td class="${v > 0 && v === maxBy[m] ? 'is-max' : ''}">${v}</td>`).join('')}<td class="lc-pts__sum ${st[i].gw > 0 && st[i].gw === maxPts ? 'is-max' : ''}">${st[i].gw}</td><td class="lc-pts__rank ${done && rankOf.get(i) === 1 ? 'is-champ' : ''}">${done ? `${rankOf.get(i)}位` : ''}</td></tr>`).join('')}</tbody>`;
    }

    // 計算式
    document.getElementById('lc-calc')!.innerHTML = ids.map((i) => {
      if (team) {
        const parts = ids.filter((j) => j !== i && played(i, j)).map((j) => `対${esc(nameOf(j))} ${tot(i, j)}（${(f.matches ?? []).map((lb, m) => `${esc(lb)} ${sc[m][i][j]}`).join(' ＋ ')}）`);
        return `<li><b>${esc(nameOf(i))}</b>：得点 ＝ ${parts.length ? parts.join(' ＋ ') : '—'} ＝ <b>${st[i].gw}</b>　（${(f.matches ?? []).map((lb, m) => `${esc(lb)} ${st[i].by[m]}`).join('・')}）</li>`;
      }
      const t = st[i].gw + st[i].gl;
      return `<li><b>${esc(nameOf(i))}</b>：${st[i].w}勝${st[i].l}敗${st[i].d ? `${st[i].d}分` : ''}　取得ゲーム率 ＝ ${st[i].gw} ÷（${st[i].gw} ＋ ${st[i].gl}）＝ ${t ? `${st[i].gw} ÷ ${t} ＝ ${pct(rate(i))}` : '—（試合なし）'}</li>`;
    }).join('');
    document.getElementById('lc-log')!.innerHTML = log.map((s) => `<li>${esc(s)}</li>`).join('')
      + `<li>結果：${ranking.map((i) => `${rankOf.get(i)}位 ${esc(nameOf(i))}`).join('、')}</li>`;
    document.getElementById('lc-rank-box')!.hidden = !done;
    document.getElementById('lc-rank-wait')!.hidden = done;
    lotNeeded = done && tiedGroups.length > 0;
    lotSync();
  }

  // ---- くじ引き（ルーレット） ----
  // 当たりは crypto.getRandomValues で決め、その区画が上の針に止まるように回す
  let lotPick = new Set<number>();   // 対象のチーム
  let lotDone: number[] = [];        // 決まった順（上の順位から）
  let lotTouched = false;            // 対象を手で選んだか（選んでいなければ同率のチームに合わせる）
  let lotNeeded = false;             // くじ引きが要るか（全試合が入っていて、ルールで決まらないチームがある）
  let spinning = false;
  let rot = 0;
  let lastPool: number[] = [];       // 最後に回したときのチーム（終わったあともルーレットを残す）
  const COLORS = ['#D8232A', '#1A1A1A', '#8E959C', '#B5683A', '#2F6E5F', '#C9A227', '#4A5D8C'];
  const wheel = document.getElementById('lc-wheel') as HTMLCanvasElement;
  const lotPool = () => [...lotPick].filter((i) => i < n && !lotDone.includes(i)).sort((a, b) => a - b);
  function lotSync() {
    // くじ引きが要るときだけ出す。要らなくなったら（結果を直したなど）やり直しの状態に戻す
    const box = document.getElementById('lc-lot')!;
    if (!lotNeeded) {
      box.hidden = true;
      if (!spinning) { lotDone = []; lastPool = []; lotTouched = false; lotPick = new Set(); }
      return;
    }
    box.hidden = false;
    if (!lotTouched && lotDone.length === 0) lotPick = new Set(tiedGroups.flat());
    const teamsBox = document.getElementById('lc-lot-teams')!;
    teamsBox.innerHTML = Array.from({ length: n }, (_, i) =>
      `<label class="lc-lot__team"><input type="checkbox" data-i="${i}" ${lotPick.has(i) ? 'checked' : ''} ${lotDone.length || spinning ? 'disabled' : ''}><span>${esc(nameOf(i))}</span></label>`).join('');
    teamsBox.querySelectorAll<HTMLInputElement>('input').forEach((el) => el.addEventListener('change', () => {
      const i = Number(el.dataset.i);
      if (el.checked) lotPick.add(i); else lotPick.delete(i);
      lotTouched = true; drawWheel(); lotStatus();
    }));
    drawWheel(); lotStatus();
  }
  function lotStatus() {
    const pool = lotPool();
    const now = document.getElementById('lc-lot-now')!;
    const btn = document.getElementById('lc-spin') as HTMLButtonElement;
    btn.disabled = spinning || pool.length < 2;
    now.textContent = spinning ? '回っています…'
      : lotDone.length && pool.length < 2 ? 'くじ引きが終わりました。'
      : pool.length < 2 ? 'くじ引きをするチームを 2 チーム以上選んでください。'
      : `${pool.map(nameOf).join('・')} の中から、${lotDone.length + 1} 番目（上の順位）を決めます。`;
    document.getElementById('lc-lot-result')!.innerHTML = lotDone.map((i, k) => `<li><b>${k + 1}番目</b>　${esc(nameOf(i))}</li>`).join('');
  }
  function drawWheel() {
    const ctx = wheel.getContext('2d')!;
    const S = wheel.width, c = S / 2, R = S / 2 - 8;
    ctx.clearRect(0, 0, S, S);
    const live = lotPool();
    const pool = live.length >= 2 || lotDone.length === 0 ? live : lastPool;
    if (pool.length === 0) {
      ctx.fillStyle = '#f2f2f2'; ctx.beginPath(); ctx.arc(c, c, R, 0, Math.PI * 2); ctx.fill();
      return;
    }
    const seg = (Math.PI * 2) / pool.length;
    pool.forEach((t, k) => {
      const a0 = rot + k * seg, a1 = a0 + seg;
      ctx.beginPath(); ctx.moveTo(c, c); ctx.arc(c, c, R, a0, a1); ctx.closePath();
      ctx.fillStyle = COLORS[t % COLORS.length]; ctx.fill();
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 4; ctx.stroke();
      ctx.save();
      ctx.translate(c, c); ctx.rotate(a0 + seg / 2);
      ctx.fillStyle = '#fff'; ctx.font = `700 ${pool.length > 5 ? 30 : 38}px "Noto Sans JP", sans-serif`;
      ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      const label = nameOf(t);
      ctx.fillText(label.length > 6 ? label.slice(0, 6) + '…' : label, R - 24, 0);
      ctx.restore();
    });
    ctx.beginPath(); ctx.arc(c, c, 40, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();
    ctx.strokeStyle = '#1A1A1A'; ctx.lineWidth = 4; ctx.stroke();
  }
  function randInt(max: number) {
    const a = new Uint32Array(1);
    const lim = Math.floor(0x100000000 / max) * max;
    do crypto.getRandomValues(a); while (a[0] >= lim);
    return a[0] % max;
  }
  function spin() {
    const pool = lotPool();
    if (spinning || pool.length < 2) return;
    spinning = true; lastPool = pool; lotSync();
    const k = randInt(pool.length);
    const seg = (Math.PI * 2) / pool.length;
    const jitter = (randInt(1000) / 1000 - 0.5) * seg * 0.7;
    // 当たりの区画の真ん中が上（-90°）に来る角度。今の角度から 5〜6 回転ぶん先へ
    const target = -Math.PI / 2 - (k + 0.5) * seg + jitter;
    const base = rot % (Math.PI * 2);
    let delta = target - base;
    while (delta < 0) delta += Math.PI * 2;
    delta += Math.PI * 2 * (5 + randInt(2));
    const from = rot, dur = 3600, t0 = performance.now();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const step = (now: number) => {
      const p = reduce ? 1 : Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 4);
      rot = from + delta * e;
      drawWheel();
      if (p < 1) { requestAnimationFrame(step); return; }
      const win = pool[k];
      lotDone.push(win);
      // 残りが 1 チームなら、それが最後
      const rest = lotPool();
      if (rest.length === 1) lotDone.push(rest[0]);
      spinning = false;
      rot = rot % (Math.PI * 2);
      lotSync();
      document.getElementById('lc-lot-now')!.textContent = `当たり：${nameOf(win)}（${lotDone.indexOf(win) + 1} 番目）${rest.length === 1 ? `。残りの ${nameOf(rest[0])} が ${lotDone.length} 番目です。` : ''}`;
    };
    requestAnimationFrame(step);
  }
  document.getElementById('lc-spin')!.addEventListener('click', spin);
  document.getElementById('lc-lot-reset')!.addEventListener('click', () => {
    if (spinning) return;
    lotDone = []; lastPool = []; lotTouched = false; rot = 0; compute();
  });


  document.querySelectorAll<HTMLInputElement>('input[name=lc-n]').forEach((el) => {
    el.checked = Number(el.value) === n;
    el.addEventListener('change', () => { n = Number(el.value); save(); renderNames(); compute(); });
  });
  document.querySelectorAll<HTMLInputElement>('input[name=lc-rule]').forEach((el) => el.addEventListener('change', () => { fmtKey = ''; save(); compute(); }));
  document.getElementById('lc-clear')!.addEventListener('click', () => {
    if (!confirm('入れた試合の結果をすべて消します。よろしいですか？')) return;
    data[fmt().key] = blank();
    save(); compute();
  });
  renderNames(); compute();
</script>
