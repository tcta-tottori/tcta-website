    const odd = k % 2 !== 0, total = odd ? k + 1 : k;
    const rot = Array.from({ length: total - 1 }, (_, i) => i + 1);
    for (let r = 0; r < total - 1; r++) {
      if (rot[0] < k) out.push([0, rot[0]]);
      for (let i = 1; i <= (total - 2) / 2; i++) {
