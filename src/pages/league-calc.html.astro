          reason.set(win, reason.get(win) ?? `直接対決で${nameOf(lose)}に勝ち`);
          reason.set(lose, reason.get(lose) ?? `直接対決で${nameOf(win)}に負け`);
          why.set(win, why.get(win) ?? `直接対決 ○ 対${nameOf(lose)}`);
          why.set(lose, why.get(lose) ?? `直接対決 ● 対${nameOf(win)}`);
          h2hCells.add(`${win}-${lose}`); h2hCells.add(`${lose}-${win}`);
          return [win, lose];
        }
        if (played(g[0], g[1])) { h2hCells.add(`${g[0]}-${g[1]}`); h2hCells.add(`${g[1]}-${g[0]}`); drew.add(g[0]); drew.add(g[1]); }
        log.push(`${names_(g)} が並びましたが、直接対決は${played(g[0], g[1]) ? `同じゲーム数（${tot(g[0], g[1])}-${tot(g[1], g[0])}）な` : 'まだ入っていない'}ので決まりません。`);
      }
      if (keys.length === 0) {
        tiedGroups.push([...g]);
        log.push(`${names_(g)} は決め方のどれでも並んだままです（下のくじ引きで決めます）。`);
        g.forEach((i) => { tied.add(i); reason.set(i, reason.get(i) ?? '同率（くじ引き）'); why.set(i, why.get(i) ?? `${drew.has(i) ? '直接対決 △ → ' : ''}抽選`); });
        return g;
      }
      const [k, ...rest] = keys;
      const groups = new Map<number, number[]>();
      for (const i of g) { const v = Math.round(keyFn[k](i) * 1e9); groups.set(v, [...(groups.get(v) ?? []), i]); }
      if (groups.size === 1) {
        if (g.length >= 3) log.push(`${names_(g)} の ${g.length} チームが並んだので、${keyName[k]}で比べます：${g.map((i) => `${nameOf(i)} ${fmtKeyV(k, i)}`).join('、')}。`);
        return order(g, rest, depth + 1);
      }
      const sorted = [...groups.entries()].sort((a, b) => b[0] - a[0]);
      if (depth > 0) {
        log.push(`${names_(g)} を${keyName[k]}で比べます：${g.map((i) => `${nameOf(i)} ${fmtKeyV(k, i)}`).join('、')}。`);
        for (const [, sg] of sorted) if (sg.length === 1) reason.set(sg[0], reason.get(sg[0]) ?? keyName[k]);
        for (const i of g) why.set(i, why.get(i) ?? `${drew.has(i) ? '直接対決 △ → ' : ''}${shortKey[k]} ${fmtKeyV(k, i)}`);
      }
      return sorted.flatMap(([, sg]) => order(sg, rest, depth + 1));
    };

    tiedGroups = [];
    const first = r === 'games' ? 'rate' : r === 'team' ? 'gw' : 'wins';
    const next = r === 'games' ? ['wins'] : r === 'team' ? ['mix'] : ['rate'];
    log.push(`${keyName[first]}で並べます：${ids.map((i) => `${nameOf(i)} ${fmtKeyV(first, i)}`).join('、')}。`);
    const groups = new Map<number, number[]>();
    for (const i of ids) { const v = Math.round(keyFn[first](i) * 1e9); groups.set(v, [...(groups.get(v) ?? []), i]); }
    const top = [...groups.entries()].sort((a, b) => b[0] - a[0]);
    for (const [, g] of top) if (g.length === 1) reason.set(g[0], keyName[first]);
    const ranking = top.flatMap(([, g]) => order(g, next, 1));
    const rankOf = new Map<number, number>();
    ranking.forEach((i, k) => rankOf.set(i, k + 1));
    const done = missing === 0;
    const hasDraw = st.some((s) => s.d);

    const warn = document.getElementById('lc-warn')!;
    warn.hidden = done;
    warn.textContent = done ? '' : `あと ${missing} ${team ? '対戦' : '試合'}の結果が入ると、順位が出ます。`;

    // 順位の表
    const table = document.getElementById('lc-table')!;
    table.innerHTML = team
      ? `<thead><tr><th>順位</th><th>チーム</th><th>得点</th>${(f.matches ?? []).map((lb) => `<th>${esc(lb)}</th>`).join('')}<th>決め手</th></tr></thead><tbody>${
        ranking.map((i) => `<tr class="${rankOf.get(i) === 1 ? 'is-top' : ''}"><td class="lc-rank">${tied.has(i) ? `${rankOf.get(i)}<small>（同率）</small>` : rankOf.get(i)}位</td><td class="lc-team">${esc(nameOf(i))}</td><td class="lc-rate">${st[i].gw}</td>${st[i].by.map((v) => `<td>${v}</td>`).join('')}<td class="lc-why">${esc(reason.get(i) ?? '')}</td></tr>`).join('')}</tbody>`
      : `<thead><tr><th>順位</th><th>チーム</th><th>勝-敗${hasDraw ? '-分' : ''}</th><th>取得</th><th>失</th><th>取得ゲーム率</th><th>決め手</th></tr></thead><tbody>${
        ranking.map((i) => `<tr class="${rankOf.get(i) === 1 ? 'is-top' : ''}"><td class="lc-rank">${tied.has(i) ? `${rankOf.get(i)}<small>（同率）</small>` : rankOf.get(i)}位</td><td class="lc-team">${esc(nameOf(i))}</td><td>${st[i].w}-${st[i].l}${hasDraw ? `-${st[i].d}` : ''}</td><td>${st[i].gw}</td><td>${st[i].gl}</td><td class="lc-rate">${st[i].gw + st[i].gl ? pct(rate(i)) : '—'}</td><td class="lc-why">${esc(reason.get(i) ?? '')}</td></tr>`).join('')}</tbody>`;

    // リーグ表：大会運営システムのリーグ表と同じ形（角丸の外枠・見出しの下に赤線・自分同士は斜線・勝ちは淡い赤地に赤字）
    const grid = document.getElementById('lc-grid')!;
    const statHead = team
      ? '<th class="lc-g__stat">得点</th>'
      : r === 'games' ? '<th class="lc-g__stat">取得ゲーム率</th>' : '<th class="lc-g__stat">勝敗</th><th class="lc-g__stat">勝率</th>';
    const statCells = (i: number) => {
      const t = st[i].gw + st[i].gl;
      if (team) return `<td class="lc-g__stat"><b class="lc-g__pts">${t ? st[i].gw : ''}</b></td>`;
      if (r === 'games') return `<td class="lc-g__stat">${t ? `<b class="lc-g__rate">${pct(rate(i))}</b><small>${st[i].gw}/${t}ゲーム</small>` : ''}</td>`;
      const pl = st[i].w + st[i].l + st[i].d;
      return `<td class="lc-g__stat"><b>${pl ? `${st[i].w}-${st[i].l}${hasDraw ? `-${st[i].d}` : ''}` : ''}</b></td><td class="lc-g__stat lc-g__sub">${t ? rate(i).toFixed(3) : ''}</td>`;
    };
    grid.classList.toggle('lc-grid--team', team);
    const showWhy = done && why.size > 0;
    grid.innerHTML = `<thead><tr><th class="lc-g__title">リーグ</th>${ids.map((j) => `<th class="lc-g__col">${mq(nameOf(j))}</th>`).join('')}${statHead}${showWhy ? '<th class="lc-g__stat lc-g__why">決め手</th>' : ''}<th class="lc-g__stat">順位</th></tr></thead><tbody>${
      ids.map((i) => {
        const rk = rankOf.get(i);
        const champ = done && rk === 1;
        return `<tr><td class="lc-g__name"><span class="lc-g__no">${i + 1}</span><button type="button" class="lc-g__team lc-namebtn${champ ? ' is-champ' : ''}" data-name="${i}" aria-label="${esc(nameOf(i))}（押して名前を直す）">${fitName(nameOf(i))}</button></td>${ids.map((j) => {
          if (i === j) return '<td class="lc-g__self" aria-hidden="true"></td>';
          const label = `${esc(nameOf(i))} 対 ${esc(nameOf(j))}`;
          if (!played(i, j)) return `<td><button type="button" class="lc-cell lc-cell--empty" data-i="${i}" data-j="${j}" aria-label="${label} のスコアを入れる">入力</button></td>`;
          const a = tot(i, j), b = tot(j, i);
          if (team) {
            // チーム対抗戦：上に対戦の合計（得点）、下に MIX・WD・MD を 1 行ずつ（取った側を赤字）
            const rows = (f.matches ?? []).map((lb, m) => {
              const x = Number(sc[m][i][j]), y = Number(sc[m][j][i]);
              return `<span class="lc-tie__row ${x > y ? 'is-w' : x < y ? 'is-l' : ''}"><i>${esc(lb)}</i><b>${x}-${y}</b></span>`;
            }).join('');
            return `<td class="${a > b ? 'is-win' : a < b ? 'is-lose' : 'is-draw'}${showWhy && h2hCells.has(`${i}-${j}`) ? ' is-h2h' : ''}"><button type="button" class="lc-cell lc-tie" data-i="${i}" data-j="${j}" aria-label="${label} 合計${a}-${b}（押して直す）"><span class="lc-tie__tot">${a}<small>-</small>${b}</span><span class="lc-tie__rows">${rows}</span></button></td>`;
          }
          return `<td class="${a > b ? 'is-win' : a < b ? 'is-lose' : 'is-draw'}${showWhy && h2hCells.has(`${i}-${j}`) ? ' is-h2h' : ''}"><button type="button" class="lc-cell" data-i="${i}" data-j="${j}" aria-label="${label} ${a}-${b}（押して直す）">${a}-${b}</button></td>`;
        }).join('')}${statCells(i)}${showWhy ? `<td class="lc-g__stat lc-g__why">${esc(why.get(i) ?? '')}</td>` : ''}<td class="lc-g__stat lc-g__rank${champ ? ' is-champ' : ''}">${done ? (tied.has(i) ? `${rk}位<small>同率</small>` : `${rk}位`) : ''}</td></tr>`;
      }).join('')}</tbody>`;
    fitMarquee(grid);
    grid.querySelectorAll<HTMLButtonElement>('.lc-cell').forEach((b) => b.addEventListener('click', () => openCell(Number(b.dataset.i), Number(b.dataset.j))));
    grid.querySelectorAll<HTMLButtonElement>('.lc-namebtn').forEach((b) => b.addEventListener('click', () => openName(Number(b.dataset.name))));
    last = { ids, st, rankOf, tied, done, team, f, sc, played, tot, rate, hasDraw, r, why, showWhy };
    if (pv.open) renderPreview();
    const whyNote = document.getElementById('lc-why-note')!;
    whyNote.hidden = !showWhy;
    whyNote.innerHTML = h2hCells.size ? '<span class="lc-why-key"></span>オレンジの枠は、順位を決めるのに使った直接対決の試合です。「決め手」の列に、並んだチームの順位の決め方を出しています。' : '「決め手」の列に、並んだチームの順位の決め方を出しています。';

    // チーム得点（チーム対抗戦だけ）：チームごとに MIX・WD・MD・得点。全対戦が入れば順位も
    const ptsBox = document.getElementById('lc-pts-box')!;
    ptsBox.hidden = !team;
    if (team) {
      const maxBy = (f.matches ?? []).map((_, m) => Math.max(...ids.map((i) => st[i].by[m])));
      const maxPts = Math.max(...ids.map((i) => st[i].gw));
      document.getElementById('lc-pts')!.innerHTML = `<thead><tr><th class="lc-pts__team">チーム</th>${(f.matches ?? []).map((lb, m) => `<th>${esc(lb)}<small>${esc(f.matchNames?.[m] ?? '')}</small></th>`).join('')}<th class="lc-pts__sum">得点</th><th>順位</th></tr></thead><tbody>${
        ids.map((i) => `<tr><td class="lc-pts__team"><span class="lc-g__no">${i + 1}</span>${esc(nameOf(i))}</td>${st[i].by.map((v, m) => `<td class="${v > 0 && v === maxBy[m] ? 'is-max' : ''}">${v}</td>`).join('')}<td class="lc-pts__sum ${st[i].gw > 0 && st[i].gw === maxPts ? 'is-max' : ''}">${st[i].gw}</td><td class="lc-pts__rank ${done && rankOf.get(i) === 1 ? 'is-champ' : ''}">${done ? `${rankOf.get(i)}位` : ''}</td></tr>`).join('')}</tbody>`;
    }

    // 計算式
    document.getElementById('lc-calc')!.innerHTML = ids.map((i) => {
      if (team) {
        const parts = ids.filter((j) => j !== i && played(i, j)).map((j) => `対${esc(nameOf(j))} ${tot(i, j)}（${(f.matches ?? []).map((lb, m) => `${esc(lb)} ${sc[m][i][j]}`).join(' ＋ ')}）`);
        return `<li><b>${esc(nameOf(i))}</b>：得点 ＝ ${parts.length ? parts.join(' ＋ ') : '—'} ＝ <b>${st[i].gw}</b>　（${(f.matches ?? []).map((lb, m) => `${esc(lb)} ${st[i].by[m]}`).join('・')}）</li>`;
      }
      const t = st[i].gw + st[i].gl;
      return `<li><b>${esc(nameOf(i))}</b>：${st[i].w}勝${st[i].l}敗${st[i].d ? `${st[i].d}分` : ''}　取得ゲーム率 ＝ ${st[i].gw} ÷（${st[i].gw} ＋ ${st[i].gl}）＝ ${t ? `${st[i].gw} ÷ ${t} ＝ ${pct(rate(i))}` : '—（試合なし）'}</li>`;
    }).join('');
    document.getElementById('lc-log')!.innerHTML = log.map((s) => `<li>${esc(s)}</li>`).join('')
      + `<li>結果：${ranking.map((i) => `${rankOf.get(i)}位 ${esc(nameOf(i))}`).join('、')}</li>`;
    document.getElementById('lc-rank-box')!.hidden = !done;
    document.getElementById('lc-rank-wait')!.hidden = done;
    lotNeeded = done && tiedGroups.length > 0;
    lotSync();
  }

  // ---- くじ引き（ルーレット） ----
  // 当たりは crypto.getRandomValues で決め、その区画が上の針に止まるように回す
  let lotPick = new Set<number>();   // 対象のチーム
  let lotDone: number[] = [];        // 決まった順（上の順位から）
  let lotTouched = false;            // 対象を手で選んだか（選んでいなければ同率のチームに合わせる）
  let lotNeeded = false;             // くじ引きが要るか（全試合が入っていて、ルールで決まらないチームがある）
  let spinning = false;
  let rot = 0;
  let lastPool: number[] = [];       // 最後に回したときのチーム（終わったあともルーレットを残す）
  const COLORS = ['#D8232A', '#1A1A1A', '#8E959C', '#B5683A', '#2F6E5F', '#C9A227', '#4A5D8C'];
  const wheel = document.getElementById('lc-wheel') as HTMLCanvasElement;
  const lotPool = () => [...lotPick].filter((i) => i < n && !lotDone.includes(i)).sort((a, b) => a - b);
  function lotSync() {
    // くじ引きが要るときだけ出す。要らなくなったら（結果を直したなど）やり直しの状態に戻す
    const box = document.getElementById('lc-lot')!;
    if (!lotNeeded) {
      box.hidden = true;
      if (!spinning) { lotDone = []; lastPool = []; lotTouched = false; lotPick = new Set(); }
      return;
    }
    box.hidden = false;
    if (!lotTouched && lotDone.length === 0) lotPick = new Set(tiedGroups.flat());
    const teamsBox = document.getElementById('lc-lot-teams')!;
    teamsBox.innerHTML = Array.from({ length: n }, (_, i) =>
      `<label class="lc-lot__team"><input type="checkbox" data-i="${i}" ${lotPick.has(i) ? 'checked' : ''} ${lotDone.length || spinning ? 'disabled' : ''}><span>${esc(nameOf(i))}</span></label>`).join('');
    teamsBox.querySelectorAll<HTMLInputElement>('input').forEach((el) => el.addEventListener('change', () => {
      const i = Number(el.dataset.i);
      if (el.checked) lotPick.add(i); else lotPick.delete(i);
      lotTouched = true; drawWheel(); lotStatus();
    }));
    drawWheel(); lotStatus();
  }
  function lotStatus() {
    const pool = lotPool();
    const now = document.getElementById('lc-lot-now')!;
    const btn = document.getElementById('lc-spin') as HTMLButtonElement;
    btn.disabled = spinning || pool.length < 2;
    now.textContent = spinning ? '回っています…'
      : lotDone.length && pool.length < 2 ? 'くじ引きが終わりました。'
      : pool.length < 2 ? 'くじ引きをするチームを 2 チーム以上選んでください。'
      : `${pool.map(nameOf).join('・')} の中から、${lotDone.length + 1} 番目（上の順位）を決めます。`;
    document.getElementById('lc-lot-result')!.innerHTML = lotDone.map((i, k) => `<li><b>${k + 1}番目</b>　${esc(nameOf(i))}</li>`).join('');
  }
  function drawWheel() {
    const ctx = wheel.getContext('2d')!;
    const S = wheel.width, c = S / 2, R = S / 2 - 8;
    ctx.clearRect(0, 0, S, S);
    const live = lotPool();
    const pool = live.length >= 2 || lotDone.length === 0 ? live : lastPool;
    if (pool.length === 0) {
      ctx.fillStyle = '#f2f2f2'; ctx.beginPath(); ctx.arc(c, c, R, 0, Math.PI * 2); ctx.fill();
      return;
    }
    const seg = (Math.PI * 2) / pool.length;
    pool.forEach((t, k) => {
      const a0 = rot + k * seg, a1 = a0 + seg;
      ctx.beginPath(); ctx.moveTo(c, c); ctx.arc(c, c, R, a0, a1); ctx.closePath();
      ctx.fillStyle = COLORS[t % COLORS.length]; ctx.fill();
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 4; ctx.stroke();
      ctx.save();
      ctx.translate(c, c); ctx.rotate(a0 + seg / 2);
      ctx.fillStyle = '#fff'; ctx.font = `700 ${pool.length > 5 ? 30 : 38}px "Noto Sans JP", sans-serif`;
      ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      const label = nameOf(t);
      ctx.fillText(label.length > 6 ? label.slice(0, 6) + '…' : label, R - 24, 0);
      ctx.restore();
    });
    ctx.beginPath(); ctx.arc(c, c, 40, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();
    ctx.strokeStyle = '#1A1A1A'; ctx.lineWidth = 4; ctx.stroke();
  }
  function randInt(max: number) {
    const a = new Uint32Array(1);
    const lim = Math.floor(0x100000000 / max) * max;
    do crypto.getRandomValues(a); while (a[0] >= lim);
    return a[0] % max;
  }
  function spin() {
    const pool = lotPool();
    if (spinning || pool.length < 2) return;
    spinning = true; lastPool = pool; lotSync();
    const k = randInt(pool.length);
    const seg = (Math.PI * 2) / pool.length;
    const jitter = (randInt(1000) / 1000 - 0.5) * seg * 0.7;
    // 当たりの区画の真ん中が上（-90°）に来る角度。今の角度から 5〜6 回転ぶん先へ
    const target = -Math.PI / 2 - (k + 0.5) * seg + jitter;
    const base = rot % (Math.PI * 2);
    let delta = target - base;
    while (delta < 0) delta += Math.PI * 2;
    delta += Math.PI * 2 * (5 + randInt(2));
    const from = rot, dur = 3600, t0 = performance.now();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const step = (now: number) => {
      const p = reduce ? 1 : Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 4);
      rot = from + delta * e;
      drawWheel();
      if (p < 1) { requestAnimationFrame(step); return; }
      const win = pool[k];
      lotDone.push(win);
      // 残りが 1 チームなら、それが最後
      const rest = lotPool();
      if (rest.length === 1) lotDone.push(rest[0]);
      spinning = false;
      rot = rot % (Math.PI * 2);
      lotSync();
      document.getElementById('lc-lot-now')!.textContent = `当たり：${nameOf(win)}（${lotDone.indexOf(win) + 1} 番目）${rest.length === 1 ? `。残りの ${nameOf(rest[0])} が ${lotDone.length} 番目です。` : ''}`;
    };
    requestAnimationFrame(step);
  }
  document.getElementById('lc-spin')!.addEventListener('click', spin);
  document.getElementById('lc-lot-reset')!.addEventListener('click', () => {
    if (spinning) return;
    lotDone = []; lastPool = []; lotTouched = false; rot = 0; compute();
  });


  document.querySelectorAll<HTMLInputElement>('input[name=lc-n]').forEach((el) => {
    el.checked = Number(el.value) === n;
    el.addEventListener('change', () => { n = Number(el.value); save(); renderNames(); compute(); });
  });
  document.querySelectorAll<HTMLInputElement>('input[name=lc-rule]').forEach((el) => el.addEventListener('change', () => { fmtKey = ''; save(); compute(); }));
  document.getElementById('lc-clear')!.addEventListener('click', () => {
    if (!confirm('入れた試合の結果をすべて消します。よろしいですか？')) return;
    data[(league ? `${league}|` : '') + fmt().key] = blank();
    save(); compute();
  });
  // ---- 実際のリーグを選ぶ（大会運営システムの公開の組み合わせを読む）----
  const sel = document.getElementById('lc-league') as HTMLSelectElement;
  let leagues: LeagueData[] = [];
  const sur = (s: string) => String(s ?? '').trim().split(/[\s　]+/)[0] ?? '';
  const teamName = (p: LeagueData['players'][number], doubles: boolean) => (doubles && p.partnerName ? `${sur(p.name)}・${sur(p.partnerName)}` : p.name);
  function applyLeague(name: string, fresh: boolean) {
    save();
    league = name;
    const L = leagues.find((x) => x.name === name);
    const keep = byLeague[name];
    if (L && (fresh || !keep)) {
      const ps = L.players.slice(0, 7);
      n = Math.max(3, Math.min(7, ps.length));
      names = Array.from({ length: 7 }, (_, i) => (ps[i] ? teamName(ps[i], L.type === 'Doubles') : ''));
    } else if (keep) { n = keep.n; names = [...keep.names]; }
    if (L) {
      const fs = formats();
      fmtKey = (fs.find((x) => x.for && L.name.includes(x.for)) ?? fs.find((x) => !x.for) ?? fs[0]).key;
      // 印刷用の見出し（種目とリーグ）
      const m = L.name.match(/^(.*?)[\s　]*([A-Za-zＡ-Ｚ0-9]+)\s*リーグ$/);
      pvEl('pv-title').value = m ? m[1] : L.name;
      pvEl('pv-league').value = m ? m[2].normalize('NFKC') : '';
    }
    document.querySelectorAll<HTMLInputElement>('input[name=lc-n]').forEach((el) => { el.checked = Number(el.value) === n; });
    const note = document.getElementById('lc-league-note')!;
    note.textContent = L ? `${L.name}：${L.players.length} チーム。チーム名は${fromDraw ? 'ドロー（プログラム）' : '大会運営システムの組み合わせ'}から入れています（直すこともできます）。入れた結果はリーグごとにこの端末に残ります。` : 'チーム名とチームの数を自分で入れます。';
    markLeague();
    save(); renderNames(); compute();
  }
  let fromDraw = false;
  const lgs = document.getElementById('lc-lgs')!;
  /** カードの選ばれている印をそろえる */
  function markLeague() {
    lgs.querySelectorAll<HTMLButtonElement>('.lc-lg').forEach((b) => {
      const on = b.dataset.league === league;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-checked', String(on));
    });
  }
  function renderLeagueCards() {
    const short = (nm: string) => nm.replace(/^.*?[\s　]+(?=\S*リーグ$)/, '');
    lgs.innerHTML = leagues.map((l) => `<button type="button" class="lc-lg" role="radio" data-league="${esc(l.name)}">
        <span class="lc-lg__head"><b>${esc(short(l.name))}</b><small>${l.players.length}チーム</small></span>
        ${short(l.name) !== l.name ? `<span class="lc-lg__ev">${esc(l.name.slice(0, l.name.length - short(l.name).length).trim())}</span>` : ''}
        <ol class="lc-lg__teams">${l.players.map((p) => `<li>${esc(teamName(p, l.type === 'Doubles'))}</li>`).join('')}</ol>
      </button>`).join('') + '<button type="button" class="lc-lg lc-lg--free" role="radio" data-league=""><span class="lc-lg__head"><b>自分で入れる</b></span><span class="lc-lg__ev">チーム名 A・B・C…</span></button>';
    lgs.querySelectorAll<HTMLButtonElement>('.lc-lg').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.league ?? '';
      if (v === league) return;
      sel.value = v;
      applyLeague(v, !byLeague[v]);
    }));
    markLeague();
  }
  function showLeagues(list: LeagueData[]) {
    leagues = list;
    if (!leagues.length) return;
    sel.innerHTML = `<option value="">自分で入れる（A・B・C…）</option>${leagues.map((l) => `<option value="${esc(l.name)}">${esc(l.name)}（${l.players.length}チーム）</option>`).join('')}`;
    sel.value = leagues.some((l) => l.name === league) ? league : '';
    renderLeagueCards();
    document.getElementById('lc-league-box')!.hidden = false;
    document.getElementById('lc-league-note')!.textContent = league ? '' : 'リーグを選ぶと、チーム名とチームの数が入ります。';
    if (league) applyLeague(league, false);
  }
  sel.addEventListener('change', () => applyLeague(sel.value, !byLeague[sel.value]));
  // ドロー（プログラム）のチーム名をページに持っている大会（団体戦など）はそれを使う。無ければ運営システムの公開の組み合わせを読む
  const own = JSON.parse(root.dataset.leagues || '[]') as { name: string; teams: string[] }[];
  if (own.length) {
    fromDraw = true;
    showLeagues(own.map((l) => ({ name: l.name, type: 'Team', rankRule: '', players: l.teams.map((t, i) => ({ position: i + 1, name: t, affiliation: '' })) })));
  } else if (root.dataset.api && root.dataset.slug) {
    fetch(`${root.dataset.api}/api/public/leagues/${encodeURIComponent(root.dataset.slug)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => showLeagues((d?.leagues ?? []) as LeagueData[]))
      .catch(() => { /* 読めないときは自分で入れる */ });
  }
  renderNames(); compute();
</script>
