---
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません｜鳥取市テニス協会" description="お探しのページは見つかりませんでした。">
  <section class="page-head page-head--plain">
    <span class="ghost" aria-hidden="true">404</span>
    <div class="container">
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">Not Found</p>
          <h1 class="page-title" style="margin-top:8px">ページが見つかりません</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">お探しのページは移動したか、公開を終了しています。</p>
      <a class="btn btn--outline mt-24 fu" style="animation-delay:.3s" href="index.html">トップページへ <span class="aw">→</span></a>
    </div>
  </section>
</Base>
