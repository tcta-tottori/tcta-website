---
import Base from '../layouts/Base.astro';

const title = "テニス祭り｜鳥取市テニス協会";
const description = "鳥取市テニス協会のテニス祭り（テニスの日）。2026年10月12日（祝）、鳥取県立鳥取産業体育館メインアリーナで開催。キッズテニス、元プロ 加藤季温コーチのテニスクリニック、ピックルボール体験会など。協会登録は不要、どなたでも参加できます。";

// 当日のプログラム（募集要項より・時間順）。参加費の書かれていないものは fee を空にしておく。
const PROGRAM = [
  { time: '9:30〜11:30', name: 'キッズテニス', who: '中学生以下', fee: '500円', note: '受付 9:00〜9:20。ラケットの貸し出しあり。申込時に学年とラケットの有無をお知らせください。' },
  { time: '11:30〜13:00', name: 'コート無料開放', who: 'どなたでも', fee: '無料', note: '2面を開放します。' },
  { time: '11:30〜13:00', name: 'ピックルボール体験会', who: 'どなたでも', fee: '', note: 'ラケットの貸し出しあり。' },
  { time: '13:00〜15:00', name: 'テニスクリニック', who: '参加制限なし・定員30名', fee: '1,000円', note: '元プロテニスプレーヤー 加藤季温コーチが指導します。' },
  { time: '15:10〜', name: 'じゃんけん大会', who: 'クリニック受講生全員', fee: '', note: '豪華景品をご用意しています。' },
  { time: '15:30〜16:30', name: '加藤プロとタイブレークマッチ', who: '参加ペア募集', fee: '', note: '加藤コーチに挑戦するタイブレークマッチです。' },
];

const YOUKOU_PDF = { src: 'assets/pdf/tennis-day/2026-tennis-matsuri-youkou.pdf', kb: 783 };
const YOUKOU_IMG = { src: 'assets/img/tennis-day/2026-youkou.webp', w: 1273, h: 1800 };

// 当日のギャラリー（公式サイトの「2026テニス祭り」から取り込んだもの。写真は tennisday-2026.json）
import GALLERY from '../data/tennisday-2026.json';
let photoNo = 0;
---

<Base
  title={title}
  description={description}
  navActive="tennis-day"
  mobileNavActive="tennis-day"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">EVENT</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">テニス祭り</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">Event</p>
          <h1 class="page-title">テニス祭り</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">2026年10月12日（祝）、鳥取県立鳥取産業体育館メインアリーナで「テニス祭り 鳥取イベント」を開催しました。子ども向けのキッズテニスから、元プロ 加藤季温コーチのクリニック、ピックルボール体験会まで。たくさんの方にお集まりいただき、ありがとうございました。当日の写真と動画をご覧いただけます。</p>
    </div>
  </section>

  <section class="section" id="gallery">
    <div class="container">

      <div class="rv">
        <div class="esec__head">
          <h2 class="sub-head" style="margin-bottom:0">イベントギャラリー</h2>
          <span class="esec__en">Gallery</span>
        </div>
        <p class="note mt-24">先日開催したテニスイベントは、参加者の皆様の熱気に包まれ無事終了しました。たくさんの方にお集まりいただき、誠にありがとうございます。</p>
        <a class="sheet mt-24" href={GALLERY.hero.src} style="display:block">
          <img src={GALLERY.hero.src} alt="2026テニス祭り鳥取イベント" width={GALLERY.hero.w} height={GALLERY.hero.h} loading="lazy" decoding="async">
        </a>
        <div class="video-embed mt-32">
          <iframe src={`https://www.youtube-nocookie.com/embed/${GALLERY.video}`} title="2026テニス祭り鳥取イベント（YouTube）" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <p class="note">※ 動画は協会の YouTube チャンネルで公開しています。</p>
      </div>

      {GALLERY.blocks.map((b) => (
        <div class="rv" style="margin-top:56px" id={`gallery-${b.id}`}>
          <h3 class="sub-head">{b.title}</h3>
          {/* 見出し画像。lead は src・w・h を持つオブジェクトなので、文字として出すと [object Object] になる */}
          {b.lead?.src && (
            <a class="sheet" href={b.lead.src} style="display:block">
              <img src={b.lead.src} alt={`${b.title}の写真`} width={b.lead.w} height={b.lead.h} loading="lazy" decoding="async">
            </a>
          )}
          <div class="gallery">
            {b.photos.map((ph) => (
              <a class="gallery__item" href={ph.src}>
                <img src={ph.src} alt={`${b.title}の写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
              </a>
            ))}
          </div>
        </div>
      ))}

      <p class="note rv">※ 画像をタップすると全画面で表示します。</p>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container">

      <div class="rv">
        <h2 class="sub-head">開催概要</h2>
        <dl class="deflist">
          <div class="deflist__row"><dt class="deflist__key">日時</dt><dd class="deflist__val" style="margin:0">2026年10月12日（月・祝）9:30〜16:30（キッズテニスの受付は 9:00〜）</dd></div>
          <div class="deflist__row"><dt class="deflist__key">会場</dt><dd class="deflist__val" style="margin:0">鳥取県立鳥取産業体育館 メインアリーナ</dd></div>
          <div class="deflist__row"><dt class="deflist__key">参加資格</dt><dd class="deflist__val" style="margin:0">どなたでも参加できます（協会登録は不要です）</dd></div>
          <div class="deflist__row"><dt class="deflist__key">申込</dt><dd class="deflist__val" style="margin:0">キッズテニス・テニスクリニックは事前申込（定員になり次第締切）。募集要項の申込用紙に記入のうえ、下記の問合せ先へお申し込みください。</dd></div>
          <div class="deflist__row"><dt class="deflist__key">主催</dt><dd class="deflist__val" style="margin:0">鳥取市テニス協会（主管：鳥取市テニス協会普及委員会）</dd></div>
          <div class="deflist__row"><dt class="deflist__key">共催・協賛</dt><dd class="deflist__val" style="margin:0">共催：遊ポートテニスクラブ／協賛：テニスショップ・フラシーノ</dd></div>
        </dl>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">当日のプログラム</h2>
        <div class="card-grid card-grid--3 mt-32">
          {PROGRAM.map((p) => (
            <div class="panel">
              <p style="margin:0;font:700 20px/1 var(--flt);letter-spacing:.04em;color:var(--red)">{p.time}</p>
              <p style="margin:12px 0 0;font:700 17px/1.5 var(--fjp);letter-spacing:.02em;color:var(--ink)">{p.name}</p>
              <p style="margin:8px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-800)">対象：{p.who}{p.fee && `／参加費：${p.fee}`}</p>
              <p style="margin:6px 0 0;font:400 13px/1.8 var(--fjp);color:var(--gray-600)">{p.note}</p>
            </div>
          ))}
        </div>
        <p class="note">※ 開催時のプログラムです。</p>
      </div>

      <div class="rv panel panel--tint" style="margin-top:56px">
        <p class="panel__title">コーチ紹介　加藤 季温（かとう としはる）</p>
        <p class="prose" style="margin:0">元プロテニスプレーヤー。兵庫県神戸市出身、株式会社KION 代表取締役。2002年 国体優勝、2007年 全日本テニス選手権優勝、全日本大学テニス選手権3連覇、インターハイ優勝、ユニバーシアード日本代表。日本ランキング最高11位。テニスクリニックとタイブレークマッチで指導・対戦していただきました。</p>
        <a class="ghost-link mt-24" href={GALLERY.coachChannel} target="_blank" rel="noopener noreferrer">加藤コーチの YouTube チャンネル <span class="aw">↗</span></a>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">募集要項・申込用紙（開催時のもの）</h2>
        <p class="note" style="margin-bottom:0">当日の募集要項です。画像をタップすると全画面で表示します。</p>
        <div class="sheets">
          <a class="sheet" href={YOUKOU_IMG.src}>
            <img src={YOUKOU_IMG.src} alt="2026テニス祭り鳥取イベント 募集要項" width={YOUKOU_IMG.w} height={YOUKOU_IMG.h} loading="lazy" decoding="async">
            <span class="sheet__cap">募集要項・申込用紙 <span class="sqbtn" aria-hidden="true">⤢</span></span>
          </a>
        </div>
        <ul class="mt-32">
          <li><a class="dl-item" href={YOUKOU_PDF.src} target="_blank" rel="noopener noreferrer">
            <span class="dl-item__type">PDF</span>
            <span class="dl-item__text">
              <span class="dl-item__title">2026テニス祭り鳥取 募集要項</span>
              <span class="dl-item__note">{YOUKOU_PDF.kb.toLocaleString()}KB／別タブで開きます</span>
            </span>
            <span class="sqbtn" aria-hidden="true">↓</span>
          </a></li>
        </ul>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">お問い合わせ・申込先</h2>
        <dl class="deflist">
          <div class="deflist__row"><dt class="deflist__key">フラシーノラケットワークス</dt><dd class="deflist__val" style="margin:0">TEL 0857-32-5578／FAX 0857-32-5579</dd></div>
          <div class="deflist__row"><dt class="deflist__key">鳥取市テニス協会（普及委員会）</dt><dd class="deflist__val" style="margin:0">安道まり子　090-8362-6190</dd></div>
        </dl>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">鳥取健康テニス</h2>
        <p class="prose" style="max-width:46em">春と秋の年2回、一般の部とジュニアの部に分けて開催しています。協会登録がなくても参加できる大会です。一般はダブルス、ジュニアはシングルスで行います。</p>
        <div class="card-grid card-grid--2 mt-32">
          <div class="panel">
            <p style="margin:0;font:700 15px/1.5 var(--fjp);letter-spacing:.02em;color:var(--ink)">第70回（春期）</p>
            <p style="margin:10px 0 0;font:700 22px/1 var(--flt);letter-spacing:.04em;color:var(--red)">2026.05.02 <span style="font-size:14px">SAT</span></p>
            <p style="margin:12px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-800)">一般：男女ダブルス／ジュニア：男女シングルス</p>
          </div>
          <div class="panel">
            <p style="margin:0;font:700 15px/1.5 var(--fjp);letter-spacing:.02em;color:var(--ink)">第71回（秋期）</p>
            <p style="margin:10px 0 0;font:700 22px/1 var(--flt);letter-spacing:.04em;color:var(--red)">2026.11.07 <span style="font-size:14px">SAT</span></p>
            <p style="margin:12px 0 0;font:400 14px/1.8 var(--fjp);color:var(--gray-800)">一般：男女ダブルス／ジュニア：男女シングルス</p>
          </div>
        </div>
        <p class="note">※ 荒天の場合は中止となります（予備日なし）。</p>
      </div>

    </div>
  </section>
</Base>
