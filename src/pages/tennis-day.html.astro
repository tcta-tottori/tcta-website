---
import Base from '../layouts/Base.astro';
import { TENNISDAY_EVENTS } from '../data/tennisday-archive.js';

// イベント情報のページ。毎年秋の「テニス祭り 鳥取イベント」（テニスの日）を年ごとのボタンで並べ、
// 押すとその回の専用ページ（tennis-day-<年>.html）に飛ぶ。中身（写真・動画・概要）は専用ページにある。
// 鳥取健康テニスは大会なので、ここには載せない（大会情報のページにある）。
const title = "イベント情報｜鳥取市テニス協会";
const description = "鳥取市テニス協会のイベント情報。毎年秋に開催するテニス祭り（テニスの日 鳥取イベント）の各回のページへ。キッズテニス、元プロコーチのテニスクリニック、ピックルボール体験会などの写真と動画をご覧いただけます。";
---

<Base
  title={title}
  description={description}
  navActive="tennis-day"
  mobileNavActive="tennis-day"
>
  {/* 以前はこのページに2026年の写真・動画（#gallery）があった。お知らせなど古いリンクで来たら 2026年の専用ページへ */}
  <script is:inline>
    if (location.hash === '#gallery') location.replace('tennis-day-2026.html#gallery');
  </script>

  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">EVENT</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">イベント情報</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">Event</p>
          <h1 class="page-title">イベント情報</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">協会では毎年秋に、どなたでも参加できる「テニス祭り 鳥取イベント」（テニスの日）を開催しています。各回のボタンを押すと、その回の写真・動画と開催内容のページが開きます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="rv">
        <div class="esec__head">
          <h2 class="sub-head" style="margin-bottom:0">テニス祭り 鳥取イベント</h2>
          <span class="esec__en">Tennis Festival</span>
        </div>
      </div>
      {/* 年ごとのボタン。写真（その回のバナー）・年・名称・日時・会場・内容。カード全体がリンク */}
      <div class="ev-list">
        {TENNISDAY_EVENTS.map((e, i) => (
          <a class="ev-card rv" href={`tennis-day-${e.year}.html`} style={i ? `transition-delay:${i * 0.1}s` : undefined}>
            <span class="ev-card__media">
              <img src={e.hero.src} alt="" width={e.hero.w} height={e.hero.h} loading={i === 0 ? 'eager' : 'lazy'} decoding="async">
            </span>
            <span class="ev-card__body">
              <span class="ev-card__year">{e.year}</span>
              <span class="ev-card__title">{e.title}</span>
              <span class="ev-card__meta">
                <span class="ev-card__row"><span class="ev-card__key">日時</span>{e.date}</span>
                <span class="ev-card__row"><span class="ev-card__key">会場</span>{e.venue}</span>
              </span>
              <span class="ev-card__summary">{e.summary}</span>
              <span class="ev-card__go">写真・動画と開催内容を見る <span class="aw">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
