---
// 大会1件の結果ページ。src/data/results.json の1件から作る。
// build.format:'file' なので出力は result-<id>.html。
// 相対パス（assets/... など）を他のページと同じに保つため、あえて平置きにしている。
import Base from '../layouts/Base.astro';
import { ALL_RESULTS, RESULTS, resultUrl } from '../data/results.js';

export function getStaticPaths() {
  return ALL_RESULTS.map((t) => ({ params: { id: t.id }, props: { t } }));
}

const { t } = Astro.props;

// 同じ年度の前後の大会（ページ下部の行き来に使う）
const year = RESULTS.find((y) => y.nendo === t.nendo);
const idx = year.tournaments.findIndex((x) => x.id === t.id);
const prev = year.tournaments[idx - 1];
const next = year.tournaments[idx + 1];

const title = `${t.title}（${t.yearLabel}）｜大会結果｜鳥取市テニス協会`;
const description = `${t.yearLabel}に行われた${t.title}の結果です。種目ごとの優勝・準優勝と当日の写真を掲載しています。`;
---

<Base
  title={title}
  description={description}
  navActive="tournaments"
  mobileNavActive="tournaments"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">RESULT</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <a href="results.html">大会結果</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <span aria-current="page">{t.title}</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">{t.yearLabel}</p>
          <h1 class="page-title" style="margin-top:8px">{t.title}</h1>
        </div>
      </div>
      {(t.date || t.venue) && (
        <p class="page-lead fu" style="animation-delay:.15s">
          {[t.date, t.venue].filter(Boolean).join('　／　')}
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">

      {t.categories.length > 0 && (
        <div class="rv">
          <h2 class="sub-head">成績</h2>
          <div class="deflist">
            {t.categories.map((c) => (
              <div class="deflist__row">
                <div class="deflist__key">{c.category || '種目'}</div>
                <div class="deflist__val">
                  <ul class="place-list">
                    {c.places.map((p) => (
                      <li>
                        <span class="place-list__award">{p.award}</span>
                        <span class="place-list__name">{p.name || '（掲載なし）'}</span>
                        {p.note && <span class="place-list__note">{p.note}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {t.pdfs.length > 0 && (
        <div class="rv" style="margin-top:56px">
          <h2 class="sub-head">結果PDF</h2>
          <ul>
            {t.pdfs.map((p) => (
              <li><a class="dl-item" href={p} target="_blank" rel="noopener noreferrer">
                <span class="dl-item__type">PDF</span>
                <span class="dl-item__text">
                  <span class="dl-item__title">{t.title} 結果</span>
                  <span class="dl-item__note">別タブで開きます</span>
                </span>
                <span class="sqbtn" aria-hidden="true">→</span>
              </a></li>
            ))}
          </ul>
        </div>
      )}

      {t.photos.length > 0 && (
        <div class="rv" style="margin-top:56px">
          <h2 class="sub-head">当日の写真<span class="gallery__count">{t.photos.length}枚</span></h2>
          <div class="gallery">
            {t.photos.map((src, i) => (
              <a class="gallery__item" href={src} target="_blank" rel="noopener noreferrer">
                <img src={src} alt={`${t.title}の写真 ${i + 1}`} loading="lazy" decoding="async">
              </a>
            ))}
          </div>
          <p class="note">※ 写真をタップすると大きく表示します。</p>
        </div>
      )}

      {t.categories.length === 0 && t.photos.length === 0 && t.pdfs.length === 0 && (
        <div class="panel panel--gray rv">
          <p style="margin:0">この大会は記録が残っていません。</p>
        </div>
      )}

      <nav class="page-nav rv" aria-label="同じ年度の大会">
        {prev
          ? <a class="page-nav__link" href={resultUrl(prev)}><span class="page-nav__dir">← 前の大会</span><span class="page-nav__title">{prev.title}</span></a>
          : <span></span>}
        <a class="ghost-link" href="results.html">大会結果の一覧へ</a>
        {next
          ? <a class="page-nav__link page-nav__link--next" href={resultUrl(next)}><span class="page-nav__dir">次の大会 →</span><span class="page-nav__title">{next.title}</span></a>
          : <span></span>}
      </nav>

    </div>
  </section>
</Base>
