---
import Base from '../layouts/Base.astro';
import { siteData } from '../lib/cms.js';
import { LINE_OFFICIAL } from '../data/links.js';

// 「該当する大会」の選択肢：今年度の大会（大会情報ページと同じ一覧）を開催順に。
// 「第56回」「令和8年度」「2026」などの回数・年度は省いて短くし、同じ名前になる大会（東部地区の単・複など）は種目を添えて分ける
const { SCHEDULE } = await siteData(Astro);
const shortName = (name) => String(name ?? '')
  .replace(/第\d+回\s*/g, '')
  .replace(/(令和|平成)\d+年度\s*/g, '')
  .replace(/^(19|20)\d{2}\s*/, '')
  .trim();
const shortCount = new Map();
for (const t of SCHEDULE) shortCount.set(shortName(t.name), (shortCount.get(shortName(t.name)) ?? 0) + 1);
const EVENT_OPTIONS = [...new Set(
  [...SCHEDULE]
    .sort((a, b) => a.date.localeCompare(b.date))
    .map((t) => (shortCount.get(shortName(t.name)) > 1 && t.event ? `${shortName(t.name)}（${t.event}）` : shortName(t.name))),
)];

const title = "お問い合わせ｜鳥取市テニス協会";
const description = "鳥取市テニス協会へのお問い合わせフォーム。大会・協会登録・水曜テニス教室・コートに関するご質問をお寄せください。";
---

<Base
  title={title}
  description={description}
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">CONTACT</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">お問い合わせ</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">Contact</p>
          <h1 class="page-title">お問い合わせ</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">大会、登録、教室に関するご質問はこちらからお寄せください。LINE公式アカウントからもお問い合わせいただけます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {/* 左にフォーム、右（スマホは下）に LINE 公式アカウントの入口 */}
      <div class="split split--reverse" style="margin-top:0">

        <div class="rv" style="order:2">
          <div class="panel panel--tint">
            <p class="panel__title">LINE公式アカウント</p>
            <p class="prose" style="margin:0">LINEからもお問い合わせいただけます。</p>
            <a class="btn btn--primary" style="margin-top:24px" href={LINE_OFFICIAL.url} target="_blank" rel="noopener noreferrer">LINEを開く <span class="aw">↗</span></a>
          </div>
        </div>

        <div class="rv" style="order:1">
          <form class="form" data-validate novalidate>
            <div class="form__row">
              <label class="form__label" for="f-name">お名前 <span class="form__req">必須</span></label>
              <input class="input" type="text" id="f-name" name="name" data-label="お名前" autocomplete="name" required>
              <p class="field-error" data-error-for="name" role="alert"></p>
            </div>

            <div class="form__row">
              <label class="form__label" for="f-kana">ふりがな <span class="form__opt">任意</span></label>
              <input class="input" type="text" id="f-kana" name="kana" data-label="ふりがな" autocomplete="off">
            </div>

            <div class="form__row">
              <label class="form__label" for="f-mail">メールアドレス <span class="form__req">必須</span></label>
              <p class="form__hint">返信先としてお使いします。</p>
              <input class="input" type="email" id="f-mail" name="email" data-label="メールアドレス" autocomplete="email" required>
              <p class="field-error" data-error-for="email" role="alert"></p>
            </div>

            <div class="form__row">
              <label class="form__label" for="f-type">お問い合わせ種別 <span class="form__req">必須</span></label>
              <select class="select" id="f-type" name="type" data-label="お問い合わせ種別" required>
                <option value="">選択してください</option>
                <option>大会について</option>
                <option>協会登録について</option>
                <option>水曜テニス教室について</option>
                <option>コートについて</option>
                <option>その他</option>
              </select>
              <p class="field-error" data-error-for="type" role="alert"></p>
            </div>

            <div class="form__row">
              <label class="form__label" for="f-event">該当する大会 <span class="form__opt">任意</span></label>
              <select class="select" id="f-event" name="event" data-label="該当する大会">
                <option value="">大会に関するお問い合わせの場合にお選びください</option>
                {EVENT_OPTIONS.map((n) => <option>{n}</option>)}
                <option>その他の大会</option>
              </select>
            </div>

            <div class="form__row">
              <label class="form__label" for="f-body">お問い合わせ内容 <span class="form__req">必須</span></label>
              <textarea class="textarea" id="f-body" name="body" data-label="お問い合わせ内容" required></textarea>
              <p class="field-error" data-error-for="body" role="alert"></p>
            </div>

            <div class="form__row">
              <label class="checkbox" for="f-agree">
                <input type="checkbox" id="f-agree" name="agree" data-label="個人情報の取扱いへの同意" required>
                <span>個人情報の取扱いに同意する <span class="form__req">必須</span><br>
                <span style="font:400 13px/1.7 var(--fjp);color:var(--gray-500)">プライバシーポリシーをご確認ください。</span></span>
              </label>
              <p class="field-error" data-error-for="agree" role="alert"></p>
            </div>

            <button class="btn btn--primary" type="submit">お問い合わせを送信する <span class="ln-arrow" aria-hidden="true"></span></button>
          </form>

          <div class="form-done" data-form-done role="status">
            <h2 class="form-done__title">お問い合わせを受け付けました。</h2>
            <p class="form-done__text">数日以内にご入力のメールアドレスへご返信します。<br>お急ぎの場合はLINE公式アカウントからご連絡ください。</p>
            <a class="btn btn--outline" href="index.html">ホームに戻る</a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Base>
