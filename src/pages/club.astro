---
import Base from '../layouts/Base.astro';
import { RESULTS, resultUrl, summarize } from '../data/results.js';

const title = "クラブ対抗戦｜鳥取市テニス協会";
const description = "鳥取市テニス協会のクラブ対抗戦。令和9年度の編成表と、平成26年度からの各部の優勝クラブを掲載しています。";

// 大会結果アーカイブからクラブ対抗戦だけを取り出し、年度ごとにまとめる。
// id が club-taiko / clubtaiko を含むものがクラブ対抗戦。
const isClub = (t) => /club-?taiko/.test(t.id);
const clubYears = RESULTS
  .map((y) => ({ ...y, tournaments: y.tournaments.filter(isClub) }))
  .filter((y) => y.tournaments.length > 0);

// 「男子1部 → ウィング」のように、部と優勝クラブだけを抜き出す
const champions = (t) =>
  t.categories
    .map((c) => ({
      div: c.category,
      club: (c.places.find((p) => p.award === '優勝') || {}).name,
    }))
    .filter((x) => x.div && x.club);
---

<Base
  title={title}
  description={description}
  navActive="tournaments"
  mobileNavActive="tournaments"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">CLUB LEAGUE</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">クラブ対抗戦</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">Club League</p>
          <h1 class="page-title" style="margin-top:8px">クラブ対抗戦</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">市内のクラブが部ごとに分かれて戦う、年2回のリーグ戦です。前期は男子1部〜8部、後期は女子1部〜5部と男女の予選会を行います。一年を通じて成績が積み上がり、上位クラブは翌年度に昇格します。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="rv">
        <h2 class="sub-head">令和9年度</h2>
        <ul>
          <li><a class="dl-item" href="assets/pdf/club/r9-club-league-lineup.pdf" target="_blank" rel="noopener noreferrer">
            <span class="dl-item__type">PDF</span>
            <span class="dl-item__text">
              <span class="dl-item__title">令和9年度クラブ対抗戦 編成表</span>
              <span class="dl-item__note">部ごとの所属クラブと日程を掲載しています。別タブで開きます。</span>
            </span>
            <span class="sqbtn" aria-hidden="true">→</span>
          </a></li>
        </ul>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">令和8年度</h2>
        <div class="panel panel--gray">
          <p class="panel__title">結果を準備しています</p>
          <p class="prose" style="margin:0">前期（2026年5月10日・男子1部〜8部）と後期（2026年7月12日・女子1部〜4部／男女予選会）の結果は、まとまりしだい掲載します。</p>
        </div>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">これまでの優勝クラブ</h2>
        <p class="sec-head__lead" style="margin-top:8px">旧サイトから引き継いだ記録です。年度をひらくと、その年の各部の優勝クラブが出ます。大会名からは当日の写真もご覧いただけます。</p>

        {clubYears.map((y, i) => (
          <details class="champ" open={i === 0}>
            <summary class="champ__year">{y.label}<span class="champ__count">{y.tournaments.length}件</span></summary>
            <div class="champ__body">
              {y.tournaments.map((t) => {
                const list = champions(t);
                return (
                  <div class="champ__block">
                    <a class="champ__title" href={resultUrl(t)}>{t.title}<span class="aw">→</span></a>
                    {list.length > 0 ? (
                      <ul class="champ__list">
                        {list.map((c) => (
                          <li><span class="champ__div">{c.div}</span><span class="champ__club">{c.club}</span></li>
                        ))}
                      </ul>
                    ) : (
                      <p class="champ__none">{t.photos.length > 0 ? `当日の写真 ${t.photos.length}枚` : '記録は写真のみです'}</p>
                    )}
                  </div>
                );
              })}
            </div>
          </details>
        ))}
      </div>

      <div class="rv panel panel--gray" style="margin-top:56px">
        <p class="panel__title">参加について</p>
        <p class="prose" style="margin:0">クラブ対抗戦への参加には、鳥取市テニス協会への団体登録が必要です。所属クラブがない方は、お問い合わせフォームからご相談ください。</p>
        <a class="ghost-link mt-24" href="contact.html">お問い合わせフォームへ <span class="aw">→</span></a>
      </div>

    </div>
  </section>
</Base>
