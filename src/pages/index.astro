---
import Base from '../layouts/Base.astro';
import TournamentCard from '../components/TournamentCard.astro';
import { TOURNAMENTS, TODAY } from '../data/tournaments.js';

const title = "鳥取市テニス協会｜つなぐ、広がる、テニスの輪。";
const description = "鳥取市テニス協会の公式サイト。年間19の大会と毎週水曜日のテニス教室を運営しています。大会情報・お知らせ・大会カレンダー・コート案内をご覧いただけます。";

// TODAY マーカーを境に、終了した大会と今後の大会に分ける。
const pastTournaments = TOURNAMENTS.filter((t) => t.status === 'past');
const upcomingTournaments = TOURNAMENTS.filter((t) => t.status !== 'past');
---

<Base
  title={title}
  description={description}
  overlay
  home
  navActive="home"
  mobileNavActive="home"
>

  <!-- ============ ヒーロー ============ -->
  <section class="hero">
    <div class="hero__media phv">
      <img class="hero__photo" src="assets/img/hero.png" alt="青空の下、コートでバックハンドを打つ選手">
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__logo" aria-hidden="true">
        <img src="assets/img/logo-white.png" alt="">
        <span class="hero__logo-bar"></span>
      </div>
    </div>
    <div class="container hero__body">
      <div class="hero__inner">
        <h1 class="hero__title">
          <span class="hl"><span>つなぐ、広がる、</span></span>
          <span class="hl"><span style="animation-delay:.14s">テニスの輪。</span></span>
        </h1>
        <p class="hero__en fu" style="animation-delay:.4s">TOTTORI-CITY TENNIS ASSOCIATION</p>
        <p class="hero__lead fu" style="animation-delay:.55s">年間19の大会と、毎週水曜日のテニス教室。鳥取市テニス協会は、市内でテニスを楽しむすべての人のための団体です。はじめての方も、久しぶりの方も、コートでお待ちしています。</p>
        <a class="btn btn--primary hero__cta fu" style="animation-delay:.7s" href="about.html">協会について見る <span class="aw">→</span></a>
      </div>
    </div>
    <div class="hero__square fu" style="animation-delay:1.05s" aria-hidden="true"></div>
    <div class="hero__scroll" aria-hidden="true">
      <span>SCROLL</span>
      <span class="blink"></span>
    </div>
  </section>

  <!-- ============ 大会情報（カルーセル） ============ -->
  <section class="section" id="tournaments" aria-labelledby="tournaments-title">
    <span class="ghost" aria-hidden="true">TOURNAMENT</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Tournament</p>
              <h2 class="sec-head__title" id="tournaments-title">大会情報</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <span class="hint">◀ 終了した大会　／　今後の大会 ▶</span>
          <a class="ghost-link view-all" href="tournaments.html">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </a>
          <span class="carousel__nav">
            <button class="circle-btn" type="button" data-carousel-prev aria-label="前の大会へ">←</button>
            <button class="circle-btn circle-btn--solid" type="button" data-carousel-next aria-label="次の大会へ">→</button>
          </span>
        </div>
      </div>

      <div class="carousel rv" data-carousel tabindex="0" role="group" aria-label="大会カルーセル（横スクロール）">

        <!-- 終了した大会 -->
        {pastTournaments.map((t) => <TournamentCard tournament={t} />)}

        <!-- TODAY -->
        <div class="today-marker" data-carousel-today aria-hidden="true">
          <span class="today-marker__label">TODAY</span>
          <span class="today-marker__line"></span>
          <span class="today-marker__date">{TODAY}</span>
        </div>

        <!-- 今後の大会 -->
        {upcomingTournaments.map((t) => <TournamentCard tournament={t} />)}

      </div>
    </div>
  </section>

  <!-- ============ お知らせ ============ -->
  <section class="section section--flush-top" id="news" aria-labelledby="news-title">
    <span class="ghost ghost--above" aria-hidden="true">NEWS</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">News</p>
              <h2 class="sec-head__title" id="news-title">お知らせ</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <a class="ghost-link view-all" href="#news">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </a>
        </div>
      </div>

      <ul class="news-list">
        <li><a class="news-row rv" href="tournaments.html">
          <span class="news-row__date">
            <span class="news-row__day">08.03</span>
            <span class="news-row__year">2026</span>
          </span>
          <span class="badge badge--outline">大会</span>
          <span class="news-row__title">サマーミックスダブルス大会のドローを公開しました</span>
          <span class="sqbtn" aria-hidden="true">→</span>
        </a></li>
        <li><a class="news-row rv" style="transition-delay:.08s" href="results.html">
          <span class="news-row__date">
            <span class="news-row__day">08.02</span>
            <span class="news-row__year">2026</span>
          </span>
          <span class="badge badge--outline">結果</span>
          <span class="news-row__title">第11回気高カップサマーシングルスの結果を掲載しました</span>
          <span class="sqbtn" aria-hidden="true">→</span>
        </a></li>
        <li><a class="news-row rv" style="transition-delay:.16s" href="club.html">
          <span class="news-row__date">
            <span class="news-row__day">07.21</span>
            <span class="news-row__year">2026</span>
          </span>
          <span class="badge badge--outline">お知らせ</span>
          <span class="news-row__title">令和9年度クラブ対抗戦の編成表を公開しました</span>
          <span class="sqbtn" aria-hidden="true">→</span>
        </a></li>
        <li><a class="news-row rv" style="transition-delay:.24s" href="club.html">
          <span class="news-row__date">
            <span class="news-row__day">07.15</span>
            <span class="news-row__year">2026</span>
          </span>
          <span class="badge badge--outline">結果</span>
          <span class="news-row__title">令和8年度クラブ対抗戦 後期の結果を掲載しました</span>
          <span class="sqbtn" aria-hidden="true">→</span>
        </a></li>
      </ul>
    </div>
  </section>

  <!-- ============ 大会カレンダー ============ -->
  <section class="section section--gray" id="schedule" aria-labelledby="schedule-title">
    <span class="ghost" aria-hidden="true">SCHEDULE</span>
    <span class="deco-circle deco-circle--a" aria-hidden="true"></span>
    <span class="deco-circle deco-circle--b" aria-hidden="true"></span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Schedule</p>
            <h2 class="sec-head__title" id="schedule-title">大会カレンダー</h2>
          </div>
        </div>
        <p class="sec-head__lead">年間の大会日程はGoogleカレンダーで公開しています。ご自分のカレンダーに追加しておくと、予定の変更もそのまま反映されます。</p>
      </div>

      <div class="split">
        <div class="rv">
          <ul class="sch-list">
            <li><a class="sch-item sch-item--next" href="tournaments.html">
              <span class="date-chip"><span class="date-chip__md">08.16</span><span class="date-chip__dow">SUN</span></span>
              <span class="sch-item__text">
                <span class="sch-item__title">サマーミックスダブルス</span>
                <span class="sch-item__place">鳥取市千代テニス場</span>
              </span>
            </a></li>
            <li><a class="sch-item" href="tournaments.html">
              <span class="date-chip"><span class="date-chip__md">08.30</span><span class="date-chip__dow">SUN</span></span>
              <span class="sch-item__text">
                <span class="sch-item__title">第49回ダンロップテニストーナメント</span>
                <span class="sch-item__place">鳥取市千代テニス場</span>
              </span>
            </a></li>
            <li><a class="sch-item" href="tennis-day.html">
              <span class="date-chip"><span class="date-chip__md">10.12</span><span class="date-chip__dow">MON</span></span>
              <span class="sch-item__text">
                <span class="sch-item__title">鳥取市テニス協会 テニス祭り</span>
                <span class="sch-item__place">鳥取産業体育館</span>
              </span>
            </a></li>
            <li><a class="sch-item" href="tournaments.html">
              <span class="date-chip"><span class="date-chip__md">10.18</span><span class="date-chip__dow">SUN</span></span>
              <span class="sch-item__text">
                <span class="sch-item__title">第30回エネトピア杯ミックスダブルス</span>
                <span class="sch-item__place">鳥取市千代テニス場</span>
              </span>
            </a></li>
            <li><a class="sch-item" href="tournaments.html">
              <span class="date-chip"><span class="date-chip__md">11.07</span><span class="date-chip__dow">SAT</span></span>
              <span class="sch-item__text">
                <span class="sch-item__title">第71回鳥取健康テニス（秋期）</span>
                <span class="sch-item__place">鳥取市千代テニス場</span>
              </span>
            </a></li>
          </ul>
          <div class="btn-stack">
            <a class="btn btn--primary" href="#schedule">Googleカレンダーに追加する <span class="aw">→</span></a>
            <a class="btn btn--outline" href="tournaments.html">年間の大会日程を見る</a>
          </div>
        </div>

        <div class="rv" style="transition-delay:.1s">
          <div class="embed embed--calendar">
            <span class="embed__label">Googleカレンダー埋め込み（月表示・大会日程のみ）</span>
            <span class="embed__note">title属性・loading="lazy" 必須／モバイルでは非表示</span>
          </div>
          <p class="embed-caption">パソコンはカレンダー右下の「＋Googleカレンダー」から、スマートフォンは「Googleカレンダーに追加する」ボタンから追加できます（Googleアカウントでのログインが必要です）。追加しておくと、日程の変更や中止も自動で反映されます。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ リンク集 ============ -->
  <section class="section" id="links" aria-labelledby="links-title">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Links</p>
            <h2 class="sec-head__title" id="links-title">リンク集</h2>
          </div>
        </div>
        <p class="sec-head__lead">鳥取市テニス協会に関係する団体・施設のサイトです。</p>
      </div>

      <div class="marquee rv">
        <div class="marquee__track">
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">鳥取県テニス協会</span><span class="link-card__desc">県登録・県大会の情報</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">鳥取県レディーステニス連盟</span><span class="link-card__desc">レディースの大会・活動</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">鳥取市公共施設予約システム</span><span class="link-card__desc">コートの予約はこちら</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">米子市テニス協会</span><span class="link-card__desc">鳥取県西部の大会情報</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">京丹後テニス協会</span><span class="link-card__desc">京都府北部の大会情報</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">琴浦テニスクラブ</span><span class="link-card__desc">東伯郡琴浦町のクラブ</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">テニスショップ フラシーノ</span><span class="link-card__desc">テニス専門店（鳥取市）</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <a class="link-card" href="links.html"><span class="link-card__logo" aria-hidden="true">ロゴ</span><span class="link-card__text"><span class="link-card__name">上海茶楼</span><span class="link-card__desc">中国上海料理（鳥取市）</span></span><span class="link-card__ext" aria-hidden="true">↗</span></a>
          <!-- ループ用の複製 -->
          <div style="display:flex" aria-hidden="true">
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">鳥取県テニス協会</span><span class="link-card__desc">県登録・県大会の情報</span></span><span class="link-card__ext">↗</span></a>
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">鳥取県レディーステニス連盟</span><span class="link-card__desc">レディースの大会・活動</span></span><span class="link-card__ext">↗</span></a>
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">鳥取市公共施設予約システム</span><span class="link-card__desc">コートの予約はこちら</span></span><span class="link-card__ext">↗</span></a>
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">米子市テニス協会</span><span class="link-card__desc">鳥取県西部の大会情報</span></span><span class="link-card__ext">↗</span></a>
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">京丹後テニス協会</span><span class="link-card__desc">京都府北部の大会情報</span></span><span class="link-card__ext">↗</span></a>
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">琴浦テニスクラブ</span><span class="link-card__desc">東伯郡琴浦町のクラブ</span></span><span class="link-card__ext">↗</span></a>
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">テニスショップ フラシーノ</span><span class="link-card__desc">テニス専門店（鳥取市）</span></span><span class="link-card__ext">↗</span></a>
            <a class="link-card" tabindex="-1"><span class="link-card__logo">ロゴ</span><span class="link-card__text"><span class="link-card__name">上海茶楼</span><span class="link-card__desc">中国上海料理（鳥取市）</span></span><span class="link-card__ext">↗</span></a>
          </div>
        </div>
      </div>
      <p class="note">※ 掲載団体・ロゴ使用許諾・分類は公開前に要確認（ホバーで停止）</p>
    </div>
  </section>

  <!-- ============ コート案内 ============ -->
  <section class="section section--gray" id="courts" aria-labelledby="courts-title">
    <span class="ghost" aria-hidden="true">COURT GUIDE</span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Court Guide</p>
            <h2 class="sec-head__title" id="courts-title">コート案内</h2>
          </div>
        </div>
      </div>

      <div class="split">
        <div class="rv">
          <ul class="sch-list">
            <li><a class="court-item" href="#courts">
              <span class="court-pin" aria-hidden="true"></span>
              <span class="sch-item__text">
                <span class="sch-item__title">鳥取市千代テニス場</span>
                <span class="sch-item__place">主会場・令和8年度は19大会中14大会を開催（住所は公開前に確認）</span>
              </span>
              <span class="ar" aria-hidden="true">→</span>
            </a></li>
            <li><a class="court-item" href="#courts">
              <span class="court-pin" aria-hidden="true"></span>
              <span class="sch-item__text">
                <span class="sch-item__title">布勢総合運動公園テニスコート</span>
                <span class="sch-item__place">鳥取県鳥取市布勢146-1（「ヤマタ」表記との統一は要確認）</span>
              </span>
              <span class="ar" aria-hidden="true">→</span>
            </a></li>
            <li><a class="court-item" href="lesson.html">
              <span class="court-pin" aria-hidden="true"></span>
              <span class="sch-item__text">
                <span class="sch-item__title">井原公園テニスコート</span>
                <span class="sch-item__place">鳥取県鳥取市興南町174（毎週水曜日のテニス教室会場）</span>
              </span>
              <span class="ar" aria-hidden="true">→</span>
            </a></li>
            <li><a class="court-item" href="tennis-day.html">
              <span class="court-pin" aria-hidden="true"></span>
              <span class="sch-item__text">
                <span class="sch-item__title">鳥取産業体育館・鳥取市民体育館</span>
                <span class="sch-item__place">冬季の室内大会・テニス祭りの会場（住所は公開前に確認）</span>
              </span>
              <span class="ar" aria-hidden="true">→</span>
            </a></li>
          </ul>
          <p class="embed-caption">コートの予約は鳥取市の公共施設予約システムから行えます。協会が管理・貸出を行っているものではありませんのでご注意ください。</p>
          <a class="ghost-link mt-24" href="links.html">鳥取市公共施設予約システムを開く <span class="aw">↗</span></a>
        </div>

        <div class="rv embed-wrap" style="transition-delay:.1s">
          <div class="embed embed--map">
            <span class="embed__label">Googleマップ埋め込み（掲載4施設のピン表示）</span>
            <span class="embed__note">title="鳥取市テニス協会 利用コートの地図"</span>
          </div>
          <span class="embed-wrap__square" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>
</Base>
