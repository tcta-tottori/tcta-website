---
import Base from '../layouts/Base.astro';
import TournamentCard from '../components/TournamentCard.astro';
import LinkCard from '../components/LinkCard.astro';
import NewsRow from '../components/NewsRow.astro';
import Icon from '../components/Icon.astro';
import { TOURNAMENTS, TODAY } from '../data/tournaments.js';
import { LINKS_ASSOC, LINKS_OTHER } from '../data/links.js';
import { NEWS, NEWS_VISIBLE } from '../data/news.js';
import { COURTS, MAP_ALL, mapEmbed, mapLink } from '../data/courts.js';

const CATCH = 'PLAY BEYOND.';
// 英字は左から1文字ずつ出すので、文字に分解しておく。
// 空白はそのままだと潰れるので、幅を持つ空白に置き換える。
const EN = 'TOTTORI-CITY TENNIS ASSOCIATION';
const EN_CHARS = [...EN];

const title = "鳥取市テニス協会｜つなぐ、広がる、テニスの輪。";
const description = "鳥取市テニス協会の公式サイト。年間19の大会と毎週水曜日のテニス教室を運営しています。大会情報・お知らせ・コート案内をご覧いただけます。";

// マーキーは中身を2組並べ、半分進んだところで巻き戻して継ぎ目なく回している。
// 1組が画面幅に足りないと隙間が空くので、1組あたり8枚以上になるまで並べ直す。
const marqueeHalf = (items) =>
  Array.from({ length: Math.ceil(8 / items.length) }, () => items).flat();

// TODAY マーカーを境に、終了した大会と今後の大会に分ける。
const pastTournaments = TOURNAMENTS.filter((t) => t.status === 'past');
const upcomingTournaments = TOURNAMENTS.filter((t) => t.status !== 'past');
---

<Base
  title={title}
  description={description}
  splash
  home
  navActive="home"
  mobileNavActive="home"
>

  <!-- ============ ヒーロー ============ -->
  <section class="hero">
    <div class="hero__media">
      {/* 写真とベールだけを左から右へ払う。キャッチコピーは払いの対象に含めない
          （含めると1文字ずつの登場が払いに隠れてしまう） */}
      <div class="hero__shot phv">
        <img class="hero__photo" src="assets/img/hero.png" alt="青空の下、コートでバックハンドを打つ選手">
        <div class="hero__scrim" aria-hidden="true"></div>
      </div>
      {/* 冒頭だけの導入。写真の右上に PLAY、続けて左下に BEYOND. を大きく出して消す
          （飾りは付けない）。消えたところで下のキャッチコピーが動き出す。 */}
      <div class="hero__intro" aria-hidden="true">
        <span class="pbi pbi--play">PLAY</span>
        <span class="pbi pbi--beyond">BEYOND.</span>
      </div>
    </div>
    <div class="container hero__body">
      <div class="hero__inner">
        <div class="hero__copy">
          <h1 class="hero__title">
            {/* 文字は1枚だけ。背景のグラデーションを文字型に切り抜いて流し、
                薄いグレー → 赤いスラッシュ → 黒と、面の色だけを変えていく。
                2枚重ねると字がわずかにずれて立体的に見えるので、重ねないこと。 */}
            <span class="pb">
              <span class="visually-hidden">{CATCH}</span>
              <span class="pb__ink" aria-hidden="true">{CATCH}</span>
            </span>
            <span class="hero__sub fu" style="animation-delay:3.15s">テニスで、もっとつながろう。</span>
          </h1>
          {/* 左から1文字ずつ、静かに浮かび上がらせる */}
          <p class="hero__en">
            <span class="visually-hidden">{EN}</span>
            {EN_CHARS.map((c, i) => (
              <span class="hero__en-ch" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>
            ))}
          </p>
          <div class="hero__lead fu" style="animation-delay:3.75s">
            {/* 本文の全域を囲む赤い枠が、左から右へ一度だけ駆け抜ける */}
            <span class="hero__lead-frame" aria-hidden="true"></span>
            <p>大会やテニス教室を通して、世代や経験をこえて誰もがテニスを楽しみ、新しいつながりや交流が生まれる場所をつくっています。</p>
          </div>
        </div>
        <a class="btn btn--primary hero__cta fu" style="animation-delay:3.95s" href="about.html">協会について見る <span class="aw">→</span></a>
      </div>
    </div>
    <div class="hero__square fu" style="animation-delay:4.15s" aria-hidden="true"></div>
    <div class="hero__scroll" aria-hidden="true">
      <span>SCROLL</span>
      <span class="blink"></span>
    </div>
  </section>

  <!-- ============ 大会情報（カルーセル） ============ -->
  <section class="section" id="tournaments" aria-labelledby="tournaments-title">
    <span class="ghost" aria-hidden="true">TOURNAMENT</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Tournament</p>
              <h2 class="sec-head__title" id="tournaments-title">大会情報</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <span class="hint">◀ 終了した大会　／　今後の大会 ▶</span>
          <button class="ghost-link view-all" type="button" data-tall-open aria-expanded="false" aria-controls="tournaments-all">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </button>
          <span class="carousel__nav">
            <button class="circle-btn" type="button" data-carousel-prev aria-label="前の大会へ">←</button>
            <button class="circle-btn circle-btn--solid" type="button" data-carousel-next aria-label="次の大会へ">→</button>
          </span>
        </div>
      </div>

    </div>

    {/* カルーセルは画面いっぱいに流す。コンテナの外に置き、1枚目だけ
        本文と同じ位置から始まるよう内側に余白を取る。 */}
    <div class="carousel rv" data-carousel tabindex="0" role="group" aria-label="大会カルーセル（横スクロール）">

        <!-- 終了した大会 -->
        {pastTournaments.map((t) => <TournamentCard tournament={t} />)}

        <!-- TODAY -->
        <div class="today-marker" data-carousel-today aria-hidden="true">
          <span class="today-marker__label">TODAY</span>
          <span class="today-marker__line"></span>
          <span class="today-marker__date">{TODAY}</span>
        </div>

        <!-- 今後の大会 -->
        {upcomingTournaments.map((t) => <TournamentCard tournament={t} />)}

    </div>

    <div class="container">
      {/* いま何枚目を見ているか。点を押すとその大会まで送る。 */}
      <div class="cdots rv" role="tablist" aria-label="大会カードの位置">
        {TOURNAMENTS.map((t, i) => (
          <button class="cdot" type="button" data-cdot={i} aria-label={`${t.date} ${t.title}`}></button>
        ))}
      </div>
    </div>

    {/* VIEW ALL で開く全件表示。横並びのカードが縦に並び直して出てくる。 */}
    <div class="tall" id="tournaments-all" hidden>
      <div class="tall__panel" role="dialog" aria-modal="true" aria-labelledby="tall-title">
        <div class="container tall__head">
          <div>
            <p class="sec-head__eyebrow">Tournament</p>
            <h2 class="sec-head__title" id="tall-title">大会情報</h2>
          </div>
          <button class="news-all__close" type="button" data-tall-close aria-label="大会情報を閉じる">
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="container tall__body">
          <div class="tall__list">
            {TOURNAMENTS.map((t, i) => (
              <div class="tall__item" style={`--i:${i}`}><TournamentCard tournament={t} /></div>
            ))}
          </div>
          <a class="btn btn--outline tall__more" href="tournaments.html">年間の大会日程・カレンダーを見る <span class="aw">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ お知らせ ============ -->
  <section class="section section--flush-top section--sticky-head" id="news" aria-labelledby="news-title">
    <span class="ghost" aria-hidden="true">NEWS</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">News</p>
              <h2 class="sec-head__title" id="news-title">お知らせ</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <button class="ghost-link view-all" type="button" data-news-open aria-expanded="false" aria-controls="news-all">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </button>
        </div>
      </div>

      {/* 上から4件だけ出す。5件目があるときは、続きがあることが分かるよう
          薄く重ねて見せる（押すと VIEW ALL と同じく全件が開く）。 */}
      <ul class="news-list">
        {NEWS.slice(0, NEWS_VISIBLE).map((n, i) => <NewsRow item={n} delay={i * 0.08} />)}
      </ul>
      {NEWS.length > NEWS_VISIBLE && (
        <div class="news-peek">
          <ul class="news-list news-list--peek" aria-hidden="true">
            <NewsRow item={NEWS[NEWS_VISIBLE]} />
          </ul>
          <button class="news-peek__btn" type="button" data-news-open aria-controls="news-all">
            お知らせをすべて見る（{NEWS.length}件）<span class="aw">↓</span>
          </button>
        </div>
      )}
    </div>

    {/* VIEW ALL で開く全件表示。閉じるボタンは右上。 */}
    <div class="news-all" id="news-all" hidden>
      <div class="news-all__panel" role="dialog" aria-modal="true" aria-labelledby="news-all-title">
        <div class="container news-all__head">
          <div>
            <p class="sec-head__eyebrow">News</p>
            <h2 class="sec-head__title" id="news-all-title">お知らせ</h2>
          </div>
          <button class="news-all__close" type="button" data-news-close aria-label="お知らせを閉じる">
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="container news-all__body">
          <ul class="news-list">
            {NEWS.map((n) => <NewsRow item={n} />)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ リンク集 ============ -->
  <section class="section" id="links" aria-labelledby="links-title">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Links</p>
              <h2 class="sec-head__title" id="links-title">リンク集</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <a class="ghost-link view-all" href="links.html">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </a>
        </div>
      </div>
    </div>

    {/* 2段組み。上段（テニス協会・連盟のHP）は右から左へ、下段（施設・クラブ・
        協賛など）は左から右へ流れる。振り分けは src/data/links.js の row。
        画面いっぱいに流したいので、コンテナの外に置いている。 */}
    <div class="marquee-rows rv">
        <div class="marquee" data-marquee data-marquee-dir="1">
          <div class="marquee__track">
            {marqueeHalf(LINKS_ASSOC).map((l) => <LinkCard link={l} compact />)}
            {/* ループ用の複製。main.js が scrollWidth の半分で巻き戻すので、
                前半とまったく同じ枚数・同じ順で並べること。 */}
            <div style="display:flex" aria-hidden="true">
              {marqueeHalf(LINKS_ASSOC).map((l) => <LinkCard link={l} compact clone />)}
            </div>
          </div>
        </div>
        <div class="marquee" data-marquee data-marquee-dir="-1">
          <div class="marquee__track">
            {marqueeHalf(LINKS_OTHER).map((l) => <LinkCard link={l} compact />)}
            <div style="display:flex" aria-hidden="true">
              {marqueeHalf(LINKS_OTHER).map((l) => <LinkCard link={l} compact clone />)}
            </div>
          </div>
        </div>
    </div>
  </section>

  <!-- ============ コート案内 ============ -->
  <section class="section section--gray section--sticky-head" id="courts" aria-labelledby="courts-title">
    <span class="ghost" aria-hidden="true">COURT GUIDE</span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Court Guide</p>
            <h2 class="sec-head__title" id="courts-title">コート案内</h2>
          </div>
        </div>
      </div>

      <div class="split">
        <div class="rv">
          <ul class="sch-list">
            {COURTS.map((c) => (
              <li><a class="court-item" href={c.href}>
                <Icon name="pin" class="court-pin" />
                <span class="sch-item__text">
                  <span class="sch-item__title">{c.name}</span>
                  <span class="sch-item__place">{c.note}</span>
                </span>
                <span class="ar" aria-hidden="true">→</span>
              </a></li>
            ))}
          </ul>
          <p class="embed-caption">コートの予約は鳥取市の公共施設予約システムから行えます。協会が管理・貸出を行っているものではありませんのでご注意ください。</p>
        </div>

        {/* 施設ごとの地図。上のボタンで切り替える（地図は施設名で引くので緯度経度は持たない）。 */}
        <div class="rv embed-wrap" style="transition-delay:.1s">
          <div class="cmap" data-cmap>
            <div class="cmap__tabs" role="group" aria-label="地図に出す施設">
              {[MAP_ALL, ...COURTS].map((c, i) => (
                <button
                  class:list={['cmap__tab', i === 0 && 'is-active', i === 0 && 'cmap__tab--all']}
                  type="button"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-cmap-tab
                  data-embed={mapEmbed(c.query, c.zoom)}
                  data-link={mapLink(c.query)}
                  data-name={c.name}
                >{c.short}</button>
              ))}
            </div>
            <div class="cmap__frame">
              <iframe
                class="cmap__iframe"
                data-cmap-frame
                src={mapEmbed(MAP_ALL.query, MAP_ALL.zoom)}
                title="鳥取市テニス協会 利用コートの地図"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
              {/* 地図が出せないときの下敷き。iframe が読めない環境ではこれが見える。 */}
              <div class="cmap__fallback" aria-hidden="true">
                <Icon name="pin" class="cmap__fallback-pin" />
                <span class="cmap__fallback-text">地図を読み込んでいます</span>
              </div>
            </div>
            <div class="cmap__bar">
              <span class="cmap__name" data-cmap-name>{MAP_ALL.name}</span>
              <a class="ghost-link cmap__open" data-cmap-link href={mapLink(MAP_ALL.query)} target="_blank" rel="noopener noreferrer">
                Googleマップで開く <span class="aw">↗</span>
              </a>
            </div>
          </div>
          <span class="embed-wrap__square" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>
</Base>
