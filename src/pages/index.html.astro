---
import Base from '../layouts/Base.astro';
import TournamentCard from '../components/TournamentCard.astro';
import LinkCard from '../components/LinkCard.astro';
import NewsRow from '../components/NewsRow.astro';
import Icon from '../components/Icon.astro';
import { siteData } from '../lib/cms.js';
import { today } from '../data/tournaments.js';
import { LINKS_ASSOC, LINKS_OTHER } from '../data/links.js';
import { NEWS_VISIBLE } from '../data/news.js';
import { COURTS, mapData, mapLink } from '../data/courts.js';
import CourtRow from '../components/CourtRow.astro';

/** コート案内の一覧で、最初から見せる施設の数。残りは白いフェードで隠し、ボタンで出す */
const COURT_VISIBLE = 3;

// 大会カード・お知らせは EmDash から（1 リクエストに 1 回だけ読む）
const { TOURNAMENTS, NEWS } = await siteData(Astro);
const TODAY = today();

const CATCH = 'PLAY BEYOND.';
// 英字は左から1文字ずつ出すので、文字に分解しておく。
// 空白はそのままだと潰れるので、幅を持つ空白に置き換える。
const EN = 'TOTTORI-CITY TENNIS ASSOCIATION';
const EN_CHARS = [...EN];

// 本文は行ごとに動かすので、あらかじめ行に分けておく。
// 画面幅まかせの折り返しでは「行ごと」の動きが作れないため、ここで区切る。
const LEAD_LINES = [
  '大会やテニス教室を通して、',
  '世代や経験をこえて誰もがテニスを楽しみ、',
  '新しいつながりや交流が生まれる場所をつくっています。',
];

const title = "鳥取市テニス協会｜つなぐ、広がる、テニスの輪。";
const description = "鳥取市テニス協会の公式サイト。年間19の大会と毎週水曜日のテニス教室を運営しています。大会情報・お知らせ・コート案内をご覧いただけます。";

// マーキーは中身を2組並べ、半分進んだところで巻き戻して継ぎ目なく回している。
// 1組が画面幅に足りないと隙間が空くので、1組あたり8枚以上になるまで並べ直す。
const marqueeHalf = (items) =>
  Array.from({ length: Math.ceil(8 / items.length) }, () => items).flat();

// TODAY マーカーを境に、終了した大会と今後の大会に分ける。
const pastTournaments = TOURNAMENTS.filter((t) => t.status === 'past');
const upcomingTournaments = TOURNAMENTS.filter((t) => t.status !== 'past');
---

<Base
  title={title}
  description={description}
  splash
  home
  navActive="home"
  mobileNavActive="home"
>

  <!-- ============ ヒーロー ============ -->
  <section class="hero">
    <div class="hero__media">
      {/* 写真とベールだけを左から右へ払う。キャッチコピーは払いの対象に含めない
          （含めると1文字ずつの登場が払いに隠れてしまう） */}
      <div class="hero__shot phv">
        <img class="hero__photo" src="assets/img/hero.png" alt="青空の下、コートでバックハンドを打つ選手">
        <div class="hero__scrim" aria-hidden="true"></div>
      </div>
    </div>
    <div class="container hero__body">
      <div class="hero__inner">
        <div class="hero__copy">
          <h1 class="hero__title">
            {/* 導入もこの2語が兼ねる。写真の右上に PLAY、左下に BEYOND. を大きく出して
                それぞれ赤 → 黒に塗り替え、消さずにそのまま1行へ合流させる。
                読み上げ用の文字は別に1つだけ置き、見える方は2語に分けてある。 */}
            <span class="pb">
              <span class="visually-hidden">{CATCH}</span>
              <span class="pb__ink" aria-hidden="true"><span class="pbw pbw--play">PLAY</span> <span class="pbw pbw--beyond">BEYOND.</span></span>
            </span>
            <span class="hero__sub fu" style="animation-delay:var(--sub-in)">テニスで、もっとつながろう。</span>
          </h1>
          {/* 左から1文字ずつ、静かに浮かび上がらせる */}
          <p class="hero__en">
            <span class="visually-hidden">{EN}</span>
            {EN_CHARS.map((c, i) => (
              <span class="hero__en-ch" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>
            ))}
          </p>
          {/* 行ごとに下から起き上がる。
              行はあらかじめ分けてある（画面幅まかせの折り返しでは行ごとに動かせないため）。 */}
          <div class="hero__lead">
            <p class="hero__lead-p">
              {LEAD_LINES.map((line, i) => (
                <span class="hl hero__lead-line" style={`--i:${i}`}><span>{line}</span></span>
              ))}
            </p>
          </div>
        </div>
        <a class="btn btn--primary hero__cta fu" style="animation-delay:var(--rest-in)" href="about.html">協会について見る <span class="aw">→</span></a>
      </div>
    </div>
    <div class="hero__square fu" style="animation-delay:var(--rest-in)" aria-hidden="true"></div>
    <div class="hero__scroll" aria-hidden="true">
      <span>SCROLL</span>
      <span class="blink"></span>
    </div>
  </section>

  <!-- ============ 大会情報（カルーセル） ============ -->
  <section class="section" id="tournaments" aria-labelledby="tournaments-title">
    <span class="ghost" aria-hidden="true">TOURNAMENT</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Tournament</p>
              <h2 class="sec-head__title" id="tournaments-title">大会情報</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <span class="hint">◀ 終了した大会　／　今後の大会 ▶</span>
          <button class="ghost-link view-all" type="button" data-tall-open aria-expanded="false" aria-controls="tournaments-all">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </button>
          <span class="carousel__nav">
            <button class="circle-btn" type="button" data-carousel-prev aria-label="前の大会へ">←</button>
            <button class="circle-btn circle-btn--solid" type="button" data-carousel-next aria-label="次の大会へ">→</button>
          </span>
        </div>
      </div>

    </div>

    {/* カルーセルは画面いっぱいに流す。コンテナの外に置き、1枚目だけ
        本文と同じ位置から始まるよう内側に余白を取る。 */}
    <div class="carousel rv" data-carousel tabindex="0" role="group" aria-label="大会カルーセル（横スクロール）">

        <!-- 終了した大会 -->
        {pastTournaments.map((t) => <TournamentCard tournament={t} />)}

        <!-- TODAY -->
        <div class="today-marker" data-carousel-today aria-hidden="true">
          <span class="today-marker__label">TODAY</span>
          <span class="today-marker__line"></span>
          <span class="today-marker__date">{TODAY}</span>
        </div>

        <!-- 今後の大会 -->
        {upcomingTournaments.map((t) => <TournamentCard tournament={t} />)}

    </div>

    <div class="container">
      {/* いま何枚目を見ているか。点を押すとその大会まで送る。 */}
      <div class="cdots rv" role="tablist" aria-label="大会カードの位置">
        {TOURNAMENTS.map((t, i) => (
          <button class="cdot" type="button" data-cdot={i} aria-label={`${t.date} ${t.title}`}></button>
        ))}
      </div>
    </div>

    {/* VIEW ALL で開く全件表示。横並びのカードが縦に並び直して出てくる。 */}
    <div class="tall" id="tournaments-all" hidden>
      <div class="tall__panel" role="dialog" aria-modal="true" aria-labelledby="tall-title">
        <div class="container tall__head">
          <div>
            <p class="sec-head__eyebrow">Tournament</p>
            <h2 class="sec-head__title" id="tall-title">大会情報</h2>
          </div>
          <button class="close-x" type="button" data-tall-close aria-label="大会情報を閉じる">
            <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
          </button>
        </div>
        <div class="container tall__body">
          <div class="tall__list">
            {TOURNAMENTS.map((t, i) => (
              <div class="tall__item" style={`--i:${i}`}><TournamentCard tournament={t} /></div>
            ))}
          </div>
          <a class="btn btn--outline tall__more" href="tournaments.html">年間の大会日程・カレンダーを見る <span class="aw">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ お知らせ ============ -->
  <section class="section section--flush-top" id="news" aria-labelledby="news-title">
    <span class="ghost" aria-hidden="true">NEWS</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">News</p>
              <h2 class="sec-head__title" id="news-title">お知らせ</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <button class="ghost-link view-all" type="button" data-news-open aria-expanded="false" aria-controls="news-all">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </button>
        </div>
      </div>

      {/* 上から3件だけ出す（NEWS_VISIBLE）。4件目があるときは、続きがあることが分かるよう
          薄くフェードさせて見せる（押すと VIEW ALL と同じく全件が開く）。 */}
      <ul class="news-list">
        {NEWS.slice(0, NEWS_VISIBLE).map((n, i) => <NewsRow item={n} delay={i * 0.08} />)}
      </ul>
      {NEWS.length > NEWS_VISIBLE && (
        <div class="news-peek">
          <ul class="news-list news-list--peek" aria-hidden="true">
            <NewsRow item={NEWS[NEWS_VISIBLE]} />
          </ul>
          <button class="news-peek__btn" type="button" data-news-open aria-controls="news-all">
            お知らせをすべて見る（{NEWS.length}件）<span class="aw">↓</span>
          </button>
        </div>
      )}
    </div>

    {/* VIEW ALL で開く全件表示。閉じるボタンは右上。 */}
    <div class="news-all" id="news-all" hidden>
      <div class="news-all__panel" role="dialog" aria-modal="true" aria-labelledby="news-all-title">
        <div class="container news-all__head">
          <div>
            <p class="sec-head__eyebrow">News</p>
            <h2 class="sec-head__title" id="news-all-title">お知らせ</h2>
          </div>
          <button class="close-x" type="button" data-news-close aria-label="お知らせを閉じる">
            <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
          </button>
        </div>
        <div class="container news-all__body">
          <ul class="news-list">
            {NEWS.map((n) => <NewsRow item={n} />)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ コート案内 ============ -->
  <section class="section section--gray" id="courts" aria-labelledby="courts-title">
    <span class="ghost" aria-hidden="true">COURT GUIDE</span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Court Guide</p>
            <h2 class="sec-head__title" id="courts-title">コート案内</h2>
          </div>
        </div>
      </div>

      {/* まず地図、次に施設の一覧。横に並ぶ幅では地図を左の広い側に置く（split--reverse）。 */}
      <div class="split split--reverse">
        {/* 施設ごとの地図。上のボタンで切り替える（緯度経度とコートの輪郭は courts.js / court-shapes.json）。 */}
        <div class="rv embed-wrap">
          <div class="cmap" data-cmap>
            {/* 施設の切り替え。左端に「すべて」を固定し、区切りの右に施設を1行で並べる（はみ出す分は横にスクロール） */}
            <div class="cmap__tabs" role="group" aria-label="地図に出す施設">
              <button class="cmap__tab cmap__tab--all" type="button" aria-pressed="false" data-cmap-all>すべて</button>
              <div class="cmap__tabs-scroll">
                {COURTS.map((c, i) => (
                  <button
                    class:list={['cmap__tab', i === 0 && 'is-active']}
                    type="button"
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    data-cmap-tab={i}
                    data-link={mapLink(c)}
                    data-name={c.name}
                  >{c.short}</button>
                ))}
              </div>
            </div>
            <div class="cmap__frame">
              {/* 地図は Leaflet で自前に描く（サイトの白・グレー・赤に合わせるため）。
                  タイルは OpenStreetMap。テニスコートの面を赤く塗り、その重心にピンを立てる。
                  上のボタンでその施設のコート全体が入るように寄り、「すべて」で全施設を一望する。 */}
              <div class="cmap__map" data-cmap-map data-courts={JSON.stringify(COURTS.map(mapData))} role="img" aria-label="利用コートの地図"></div>
              {/* 選んだ施設の写真と、その右にサーフェス・面数。地図の左上に重ねる（courts.js の image / surface / courts。
                  「すべて」のときは JS が隠す） */}
              <div class="cmap__photo" data-cmap-photo hidden={!COURTS[0].image}>
                <img class="cmap__photo-img" data-cmap-photo-img src={COURTS[0].image ?? ''} alt="" width="960" height="540" decoding="async">
                <span class="cmap__photo-text">
                  <span class="cmap__photo-surface" data-cmap-surface>{COURTS[0].surface ?? ''}</span>
                  <span class="cmap__photo-faces" data-cmap-faces>{COURTS[0].courts ? `${COURTS[0].courts}面` : ''}</span>
                </span>
              </div>
              {/* 現在地。地図の左下に重ねる。押すと位置情報の許可を求め、許可されれば青い点で出す（main.js の initCourtMap）。
                  位置情報が使えない環境では JS が隠す。 */}
              <button class="cmap__locate" type="button" aria-pressed="false" data-cmap-locate>
                <span class="cmap__locate-dot" aria-hidden="true"></span>現在地
              </button>
              {/* 地図が出せないときの下敷き。タイルが読めない環境ではこれが見える。 */}
              <div class="cmap__fallback" aria-hidden="true">
                <Icon name="pin" class="cmap__fallback-pin" />
                <span class="cmap__fallback-text">地図を読み込んでいます</span>
              </div>
            </div>
            <div class="cmap__bar">
              <span class="cmap__name" data-cmap-name>{COURTS[0].name}</span>
              <span class="cmap__msg" data-cmap-msg role="status" aria-live="polite"></span>
              <a class="ghost-link cmap__open" data-cmap-link href={mapLink(COURTS[0])} target="_blank" rel="noopener noreferrer">
                Googleマップで開く <span class="aw">↗</span>
              </a>
            </div>
          </div>
          <span class="embed-wrap__square" aria-hidden="true"></span>
        </div>
        <div class="rv" style="transition-delay:.1s">
          {/* 最初は3件だけ。4件目以降はお知らせと同じ白いフェードで隠し、ボタンで全部出す（main.js の initCourtList） */}
          <ul class="sch-list">
            {COURTS.slice(0, COURT_VISIBLE).map((c) => <CourtRow court={c} />)}
          </ul>
          {COURTS.length > COURT_VISIBLE && (
            <div class="court-more" data-court-more>
              <ul class="sch-list court-more__rest" id="court-more-rest">
                {COURTS.slice(COURT_VISIBLE).map((c) => <CourtRow court={c} />)}
              </ul>
              <div class="court-more__peek" aria-hidden="true"></div>
              <button class="news-peek__btn court-more__btn" type="button" data-court-more-btn aria-expanded="false" aria-controls="court-more-rest">
                すべての施設を見る（{COURTS.length}施設）<span class="aw">↓</span>
              </button>
            </div>
          )}
          <a class="ghost-link mt-24" href="courts.html">施設の詳細（住所・予約先・電話番号）を見る <span class="aw">→</span></a>
          <p class="embed-caption">施設を押すと、コート案内のページでその施設の詳細が見られます。鳥取市の施設の予約は鳥取市公共施設予約システムから、八頭町の施設は電話でお申し込みください。協会が管理・貸出を行っているものではありませんのでご注意ください。</p>
        </div>

      </div>
    </div>
  </section>
  <!-- ============ リンク集 ============ -->
  <section class="section" id="links" aria-labelledby="links-title">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Links</p>
              <h2 class="sec-head__title" id="links-title">リンク集</h2>
            </div>
          </div>
        </div>
        <div class="sec-bar__aside">
          <a class="ghost-link view-all" href="links.html">
            <span class="view-all__label">VIEW ALL</span><span class="sqbtn">→</span>
          </a>
        </div>
      </div>
    </div>

    {/* 2段組み。上段（テニス協会・連盟のHP）は右から左へ、下段（施設・クラブ・
        協賛など）は左から右へ流れる。振り分けは src/data/links.js の row。
        画面いっぱいに流したいので、コンテナの外に置いている。 */}
    <div class="marquee-rows rv">
        <div class="marquee" data-marquee data-marquee-dir="1">
          <div class="marquee__track">
            {marqueeHalf(LINKS_ASSOC).map((l) => <LinkCard link={l} compact />)}
            {/* ループ用の複製。main.js が scrollWidth の半分で巻き戻すので、
                前半とまったく同じ枚数・同じ順で並べること。 */}
            <div style="display:flex" aria-hidden="true">
              {marqueeHalf(LINKS_ASSOC).map((l) => <LinkCard link={l} compact clone />)}
            </div>
          </div>
        </div>
        <div class="marquee" data-marquee data-marquee-dir="-1">
          <div class="marquee__track">
            {marqueeHalf(LINKS_OTHER).map((l) => <LinkCard link={l} compact />)}
            <div style="display:flex" aria-hidden="true">
              {marqueeHalf(LINKS_OTHER).map((l) => <LinkCard link={l} compact clone />)}
            </div>
          </div>
        </div>
    </div>
  </section>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
</Base>
