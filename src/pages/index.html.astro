---
import Base from '../layouts/Base.astro';
import TournamentCard from '../components/TournamentCard.astro';
import LiteToggle from '../components/LiteToggle.astro';
import LinkCard from '../components/LinkCard.astro';
import NewsRow from '../components/NewsRow.astro';
import Icon from '../components/Icon.astro';
import { siteData } from '../lib/cms.js';
import { today } from '../data/tournaments.js';
import { LINK_ROWS, LINK_GROUPS } from '../data/links.js';
import { NEWS_VISIBLE } from '../data/news.js';
import { COURTS_HOME, CITY_RESERVE } from '../data/courts.js';
import CourtMap from '../components/CourtMap.astro';
import ScheduleCalendar from '../components/ScheduleCalendar.astro';

// 大会カード・お知らせは EmDash から（1 リクエストに 1 回だけ読む）
const { TOURNAMENTS, NEWS } = await siteData(Astro);
const TODAY = today();

const CATCH = 'PLAY BEYOND.';
// 英字は左から1文字ずつ出すので、文字に分解しておく。
// 空白はそのままだと潰れるので、幅を持つ空白に置き換える。
const EN = 'TOTTORI-CITY TENNIS ASSOCIATION';
const EN_CHARS = [...EN];

// 本文は行ごとに動かすので、あらかじめ行に分けておく。
// 画面幅まかせの折り返しでは「行ごと」の動きが作れないため、ここで区切る。
const LEAD_LINES = [
  '大会やテニス教室を通して、',
  '世代や経験をこえて誰もがテニスを楽しみ、',
  '新しいつながりや交流が生まれる場所をつくっています。',
];

const title = "鳥取市テニス協会｜つなぐ、広がる、テニスの輪。";
const description = "鳥取市テニス協会の公式サイト。年間19の大会と毎週水曜日のテニス教室を運営しています。大会情報・お知らせ・コート案内をご覧いただけます。";

// マーキーは中身を2組並べ、半分進んだところで巻き戻して継ぎ目なく回している。
// 1組が画面幅に足りないと隙間が空くので、1組あたり8枚以上になるまで並べ直す。
const marqueeHalf = (items) =>
  Array.from({ length: Math.ceil(8 / items.length) }, () => items).flat();

// TODAY マーカーを境に、終了した大会と今後の大会に分ける。
const pastTournaments = TOURNAMENTS.filter((t) => t.status === 'past');
const upcomingTournaments = TOURNAMENTS.filter((t) => t.status !== 'past');
---

<Base
  title={title}
  description={description}
  splash
  home
  navActive="home"
  mobileNavActive="home"
>

  <!-- ============ ヒーロー ============ -->
  <section class="hero">
    <div class="hero__media">
      {/* 写真とベールだけを左から右へ払う。キャッチコピーは払いの対象に含めない
          （含めると1文字ずつの登場が払いに隠れてしまう） */}
      <div class="hero__shot phv">
        {/* 動画（横断幕の前の参加者の集合。正方形・12秒・音なしでくり返す。人は写真のまま止め、雲と木だけが動く）。読み込むまでと、動きを減らす設定では最初のコマ（poster）を出す */}
        <video class="hero__photo hero__video" autoplay muted loop playsinline preload="auto" poster="assets/img/hero-poster.webp"
          aria-label="鳥取市テニス協会の横断幕の前で、大会の参加者がそろった集合の動画" width="1254" height="1254">
          <source src="assets/video/hero.mp4" type="video/mp4">
        </video>
        {/* 軽量モードでは動画を読みに行かない（読み込みが始まる前に、ここで外して最初のコマ＝poster だけにする） */}
        <script is:inline>
          (function () {
            if (!document.documentElement.classList.contains('is-lite')) return;
            var v = document.querySelector('.hero__video');
            if (!v) return;
            v.removeAttribute('autoplay'); v.preload = 'none';
            v.querySelectorAll('source').forEach(function (s) { s.parentNode.removeChild(s); });
            v.load();
          })();
        </script>
        <div class="hero__scrim" aria-hidden="true"></div>
      </div>
    </div>
    <div class="container hero__body">
      <div class="hero__inner">
        <div class="hero__copy">
          <h1 class="hero__title">
            {/* 導入もこの2語が兼ねる。写真の右上に PLAY、左下に BEYOND. を大きく出して
                それぞれ赤 → 黒に塗り替え、消さずにそのまま1行へ合流させる。
                読み上げ用の文字は別に1つだけ置き、見える方は2語に分けてある。 */}
            <span class="pb">
              <span class="visually-hidden">{CATCH}</span>
              <span class="pb__ink" aria-hidden="true"><span class="pbw pbw--play">PLAY</span> <span class="pbw pbw--beyond">BEYOND.</span></span>
            </span>
            <span class="hero__sub fu" style="animation-delay:var(--sub-in)">テニスで、もっとつながろう。</span>
          </h1>
          {/* 左から1文字ずつ、静かに浮かび上がらせる */}
          <p class="hero__en">
            <span class="visually-hidden">{EN}</span>
            {EN_CHARS.map((c, i) => (
              <span class="hero__en-ch" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>
            ))}
          </p>
          {/* 行ごとに下から起き上がる。
              行はあらかじめ分けてある（画面幅まかせの折り返しでは行ごとに動かせないため）。 */}
          <div class="hero__lead">
            <p class="hero__lead-p">
              {LEAD_LINES.map((line, i) => (
                <span class="hl hero__lead-line" style={`--i:${i}`}><span>{line}</span></span>
              ))}
            </p>
          </div>
        </div>
        <a class="btn btn--primary hero__cta fu" style="animation-delay:var(--rest-in)" href="about.html">協会について見る <span class="ln-arrow" aria-hidden="true"></span></a>
        {/* 軽量モードの切り替え（「協会について見る」の下） */}
        <div class="hero__lite fu" style="animation-delay:var(--rest-in)"><LiteToggle /></div>
      </div>
    </div>
    <div class="hero__square fu" style="animation-delay:var(--rest-in)" aria-hidden="true"></div>
    <div class="hero__scroll" aria-hidden="true">
      <span>SCROLL</span>
      <span class="blink"></span>
    </div>
  </section>

  <!-- ============ 大会情報（カルーセル） ============ -->
  {/* 縦にスクロールすると、この区画が画面に止まったまま大会カードが横に流れる（main.js の initCarouselPin）。
      ヒーローから入ると TODAY の線が伸びて日付が出て、続けてカードが出る。カードを右端まで送ったら次の区画（お知らせ）へ。
      カードは指・トラックパッドの横スクロールでも送れる。上へ戻ると TODAY まで戻ってヒーローへ（終了した大会へは横に送ったときだけ） */}
  <section class="section section--gray section--cards" id="tournaments" aria-labelledby="tournaments-title">
    <div class="hpin-track"><div class="hpin">
    {/* 背景の英字も止める区画の中に置く（止まっているあいだ一緒に止まる） */}
    <span class="ghost" aria-hidden="true">TOURNAMENT</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Tournament</p>
              <h2 class="sec-head__title" id="tournaments-title">大会情報</h2>
            </div>
          </div>
        </div>
      </div>
      {/* 左右に送れることを、線の矢印（.ln-arrow）で示す。送るのは指（横スクロール）か下の点で */}
      {/* 「終了した大会｜今後の大会」。矢印はそれぞれの文字の下。赤い縦線の延長上に TODAY の線がくるよう、カードの初めの位置を合わせる（main.js の initCarousel） */}
      <p class="hint hint--lr sec-hint rv">
        <span class="hint__item hint__item--past">終了した大会<span class="ln-arrow ln-arrow--left" aria-hidden="true"></span></span>
        <span class="hint__bar" data-today-anchor aria-hidden="true"></span>
        <span class="hint__item">今後の大会<span class="ln-arrow" aria-hidden="true"></span></span>
      </p>

    </div>

    {/* カルーセルは画面いっぱいに流す。コンテナの外に置き、1枚目だけ
        本文と同じ位置から始まるよう内側に余白を取る。 */}
    <div class="carousel" data-carousel tabindex="0" role="group" aria-label="大会カルーセル（横スクロール）">

        <!-- 終了した大会 -->
        {pastTournaments.map((t) => <TournamentCard tournament={t} />)}

        <!-- TODAY -->
        <div class="today-marker" data-carousel-today aria-hidden="true">
          <span class="today-marker__label">TODAY</span>
          <span class="today-marker__line"></span>
          <span class="today-marker__date">{TODAY}</span>
        </div>

        <!-- 今後の大会 -->
        {upcomingTournaments.map((t) => <TournamentCard tournament={t} />)}

    </div>

    <div class="container">
      {/* カードの下の右端に VIEW ALL（大会情報のページへ） */}
      <div class="sec-more rv">
        <a class="view-all" href="tournaments.html">
          <span class="view-all__label">VIEW ALL</span><span class="ln-arrow" aria-hidden="true"></span>
        </a>
      </div>
    </div>
    </div></div>

  </section>

  <!-- ============ お知らせ ============ -->
  <section class="section" id="news" aria-labelledby="news-title">
    <span class="ghost" aria-hidden="true">NEWS</span>
    <div class="container">
      {/* 全件は4件目（薄くした行）の右端の VIEW ALL で開く（ヘッダーは残したまま、その下にお知らせの見出しと全件を出す）。 */}
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">News</p>
            <h2 class="sec-head__title" id="news-title">お知らせ</h2>
          </div>
        </div>
      </div>

      {/* 上から3件だけ出す（NEWS_VISIBLE）。4件目があるときは、続きがあることが分かるよう
          薄くフェードさせて見せる（VIEW ALL を押すと全件が開く）。 */}
      <ul class="news-list">
        {/* 画面に入ったらすぐ出す（0.1 秒おいて、1行ずつ 0.08 秒ずらす。以前は 0.5 秒＋0.12 秒ずつで遅く感じた） */}
        {NEWS.slice(0, NEWS_VISIBLE).map((n, i) => <NewsRow item={n} delay={0.1 + i * 0.08} />)}
      </ul>
      {NEWS.length > NEWS_VISIBLE && (
        <div class="news-peek">
          <ul class="news-list news-list--peek" aria-hidden="true">
            <NewsRow item={NEWS[NEWS_VISIBLE]} delay={0.1 + NEWS_VISIBLE * 0.08} />
          </ul>
          <div class="news-peek__more">
            <button class="view-all" type="button" data-news-open aria-expanded="false" aria-controls="news-all" aria-label={`お知らせをすべて見る（${NEWS.length}件）`}>
              <span class="view-all__label">VIEW ALL</span><span class="ln-arrow" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      )}
    </div>

    {/* VIEW ALL で開く全件表示。サイトのヘッダー（ロゴ・メニュー）は残し、その下に見出しと全件を出す。閉じるボタンは見出しの右。 */}
    <div class="news-all" id="news-all" hidden>
      <div class="news-all__panel" role="dialog" aria-modal="true" aria-labelledby="news-all-title">
        <div class="container news-all__head">
          <div>
            <p class="sec-head__eyebrow">News</p>
            <h2 class="sec-head__title" id="news-all-title">お知らせ</h2>
          </div>
          <button class="close-x" type="button" data-news-close aria-label="お知らせを閉じる">
            <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
          </button>
        </div>
        <div class="container news-all__body">
          <ul class="news-list">
            {NEWS.map((n, i) => <NewsRow item={n} index={i} reveal={false} />)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ コート案内 ============ -->
  <!-- ============ イベントカレンダー（大会・テニスイベント・水曜テニス） ============ -->
  <section class="section section--gray" id="calendar" aria-labelledby="calendar-title">
    <span class="ghost" aria-hidden="true">CALENDAR</span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Calendar</p>
            <h2 class="sec-head__title" id="calendar-title">イベントカレンダー</h2>
          </div>
        </div>
      </div>
      <p class="sec-head__lead rv">大会・テニスイベント・水曜テニス教室の日程を月ごとに並べています。大会のエントリー締切とドロー会議の日も載せています。</p>
      <div class="rv"><ScheduleCalendar extras /></div>
    </div>
  </section>

  <section class="section section--gray" id="courts" aria-labelledby="courts-title">
    <span class="ghost" aria-hidden="true">COURT GUIDE</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Court Guide</p>
              <h2 class="sec-head__title" id="courts-title">コート案内</h2>
            </div>
          </div>
        </div>
      </div>

      {/* 施設ごとの地図。上のボタンで切り替える（緯度経度とコートの輪郭は courts.js / court-shapes.json）。
          施設の一覧は置かず、VIEW ALL からコート案内のページへ */}
      <div class="rv embed-wrap mt-32">
        {/* VIEW ALL（コート案内のページへ）は地図の中の右上に置く（CourtMap の viewAll） */}
        <CourtMap courts={COURTS_HOME} viewAll="courts.html" />
        <span class="embed-wrap__square" aria-hidden="true"></span>
      </div>
      {/* 地図の下に、市のテニスコートの予約先（鳥取市公共施設予約システム。courts.js の CITY_RESERVE）へのボタン */}
      <div class="rv mt-24">
        <a class="btn btn--primary" href={CITY_RESERVE.url} target="_blank" rel="noopener noreferrer">テニスコートの予約はこちら <span class="ln-arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
  <!-- ============ リンク集 ============ -->
  <section class="section" id="links" aria-labelledby="links-title">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <div class="sec-bar rv">
        <div class="sec-head">
          <div class="sec-head__row">
            <span class="sec-head__mark" aria-hidden="true"></span>
            <div>
              <p class="sec-head__eyebrow">Links</p>
              <h2 class="sec-head__title" id="links-title">リンク集</h2>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* 3段組み。リンク集の並び順のまま3つに分け（src/data/links.js の LINK_ROWS）、
        上の段から 右へ／左へ／右へ と交互に流す。画面いっぱいに流したいので、コンテナの外に置いている。 */}
    {/* data-link-order：リンク集のページの並び（分類ごとの配列）のバナー。VIEW ALL を押したとき、この順に並べ替えてから移る（main.js の initLinksLeave） */}
    <div class="marquee-rows rv" data-link-order={JSON.stringify(LINK_GROUPS.map((g) => g.items.map((l) => l.banner).filter(Boolean)).filter((g) => g.length))}>
      {LINK_ROWS.map((row, i) => (
        <div class="marquee" data-marquee data-marquee-dir={i % 2 === 0 ? '1' : '-1'}>
          <div class="marquee__track">
            {marqueeHalf(row).map((l) => <LinkCard link={l} compact />)}
            {/* ループ用の複製。main.js が scrollWidth の半分で巻き戻すので、
                前半とまったく同じ枚数・同じ順で並べること。 */}
            <div style="display:flex" aria-hidden="true">
              {marqueeHalf(row).map((l) => <LinkCard link={l} compact clone />)}
            </div>
          </div>
        </div>
      ))}
    </div>
    {/* バナーの下の右端に VIEW ALL（リンク集のページへ） */}
    <div class="container">
      <div class="sec-more rv">
        <a class="view-all" href="links.html">
          <span class="view-all__label">VIEW ALL</span><span class="ln-arrow" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
</Base>
