              <td><span class="name">第61回鳥取市テニス協会会長杯（春季）</span><br><span style="font:400 13px/1.6 var(--fjp);color:var(--gray-500)">団体戦</span></td>
              <td class="col-date">4月29日（祝）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 5/6</span></td>
              <td class="col-place">鳥取市千代テニス場</td>
              <td class="col-note">4/10</td>
              <td class="col-reg"><span class="meta-row__key" style="width:auto;padding:4px 10px">市登録</span></td>
            </tr>
            <tr class="is-ended" data-tags="done free">
              <td class="col-no">05</td>
