      <div class="rv" style="margin-top:64px">
        <h2 class="sub-head">令和9年度（先行案内）</h2>
        <div class="table-scroll">
          <table class="data-table">
            <caption class="visually-hidden">令和9年度 大会（先行案内）</caption>
          <thead>
            <tr>
              <th scope="col" class="col-no">NO</th>
              <th scope="col" class="col-badge">状態</th>
