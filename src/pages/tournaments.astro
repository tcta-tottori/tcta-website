---
import Base from '../layouts/Base.astro';
import ScheduleCalendar from '../components/ScheduleCalendar.astro';

const title = "大会情報｜鳥取市テニス協会";
const description = "令和8年度（2026年度）に鳥取市テニス協会が主催・主管する全19大会の一覧。エントリー締切・会場・登録区分を掲載しています。";
---

<Base
  title={title}
  description={description}
  navActive="tournaments"
  mobileNavActive="tournaments"
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">TOURNAMENT</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">大会情報</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">Tournament</p>
          <h1 class="page-title" style="margin-top:8px">大会情報</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">令和8年度（2026年度）に鳥取市テニス協会が主催・主管する大会の一覧です。エントリー締切、会場、必要な登録区分をあわせて掲載しています。日程は天候等により変更になる場合があります。</p>
    </div>
  </section>

  <!-- ============ 月ごとのカレンダー ============ -->
  <section class="section section--gray" id="calendar" aria-labelledby="cal-title">
    <span class="ghost" aria-hidden="true">CALENDAR</span>
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Calendar</p>
            <h2 class="sec-head__title" id="cal-title">大会カレンダー</h2>
          </div>
        </div>
      </div>
      <p class="sec-head__lead rv">令和8年度の大会を月ごとに並べています。赤いマスが開催日です。年間の日程はGoogleカレンダーでも公開しています。</p>

      <ScheduleCalendar />

      <div class="btn-stack rv mt-40">
        <a class="btn btn--primary" href="#calendar">Googleカレンダーに追加する <span class="aw">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="r8-title">
    <div class="container">
      <div class="sec-head rv">
        <div class="sec-head__row">
          <span class="sec-head__mark" aria-hidden="true"></span>
          <div>
            <p class="sec-head__eyebrow">Schedule R8</p>
            <h2 class="sec-head__title" id="r8-title">令和8年度 大会一覧</h2>
          </div>
        </div>
      </div>

      <div class="chips mt-32 rv" data-filter-group data-filter-target="#r8-list" role="group" aria-label="大会一覧の絞り込み">
        <button class="chip is-active" type="button" data-filter="all" aria-pressed="true">すべて（19）</button>
        <button class="chip" type="button" data-filter="open" aria-pressed="false">受付中（1）</button>
        <button class="chip" type="button" data-filter="done" aria-pressed="false">終了（9）</button>
      </div>

      <div class="table-scroll rv">
        <table class="data-table" id="r8-list">
          <caption class="visually-hidden">令和8年度 大会一覧</caption>
          <thead>
            <tr>
              <th scope="col" class="col-no">NO</th>
              <th scope="col" class="col-badge">状態</th>
              <th scope="col">大会名・種目</th>
              <th scope="col" class="col-date">期日・予備日</th>
              <th scope="col" class="col-place">会場</th>
              <th scope="col" class="col-note">締切</th>
              <th scope="col" class="col-reg">登録区分</th>
            </tr>
          </thead>
          <tbody>
            <tr class="is-ended" data-tags="done ken">
              <td class="col-no">01</td>
              <td class="col-badge"><span class="badge badge--muted">終了</span></td>
              <td><span class="name">第56回東部地区テニス選手権</span><br><span style="font:400 13px/1.6 var(--fjp);color:var(--gray-500)">男女シングルス</span></td>
              <td class="col-date">3月22日（日）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 3/28</span></td>
              <td class="col-place">鳥取市千代テニス場</td>
              <td class="col-note">3/6</td>
              <td class="col-reg"><span class="meta-row__key" style="width:auto;padding:4px 10px">県登録</span></td>
            </tr>
            <tr class="is-ended" data-tags="done ken">
              <td class="col-no">02</td>
              <td class="col-badge"><span class="badge badge--muted">終了</span></td>
              <td><span class="name">第56回東部地区テニス選手権</span><br><span style="font:400 13px/1.6 var(--fjp);color:var(--gray-500)">男女ダブルス</span></td>
              <td class="col-date">3月29日（日）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 4/4</span></td>
              <td class="col-place">鳥取市千代テニス場</td>
              <td class="col-note">3/13</td>
              <td class="col-reg"><span class="meta-row__key" style="width:auto;padding:4px 10px">県登録</span></td>
            </tr>
            <tr class="is-ended" data-tags="done shi">
              <td class="col-no">03</td>
              <td class="col-badge"><span class="badge badge--muted">終了</span></td>
              <td><span class="name">佐々木杯テニス大会</span><br><span style="font:400 13px/1.6 var(--fjp);color:var(--gray-500)">ミックスダブルス</span></td>
              <td class="col-date">4月5日（日）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 4/11</span></td>
              <td class="col-place">鳥取市千代テニス場</td>
              <td class="col-note">3/20</td>
              <td class="col-reg"><span class="meta-row__key" style="width:auto;padding:4px 10px">市登録</span></td>
            </tr>
            <tr class="is-ended" data-tags="done shi">
