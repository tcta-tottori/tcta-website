              <td class="col-date">8月2日（日）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 8/8</span></td>
              <td class="col-place">鳥取市千代テニス場</td>
              <td class="col-note">7/17</td>
              <td class="col-reg"><span class="meta-row__key" style="width:auto;padding:4px 10px">県登録</span></td>
            </tr>
            <tr data-tags="closed shi">
              <td class="col-no">10</td>
              <td class="col-badge"><span class="badge badge--muted">受付終了</span></td>
              <td><span class="name">サマーミックスダブルス</span><br><span style="font:400 13px/1.6 var(--fjp);color:var(--gray-500)">ミックスダブルス</span></td>
              <td class="col-date">8月16日（日）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 9/6</span></td>
              <td class="col-place">鳥取市千代テニス場</td>
              <td class="col-note">7/31</td>
              <td class="col-reg"><span class="meta-row__key" style="width:auto;padding:4px 10px">市登録</span></td>
            </tr>
            <tr data-tags="closed ken">
              <td class="col-no">11</td>
              <td class="col-badge"><span class="badge badge--muted">受付終了</span></td>
              <td><span class="name">第49回ダンロップテニストーナメント</span><br><span style="font:400 13px/1.6 var(--fjp);color:var(--gray-500)">男女ダブルス</span></td>
              <td class="col-date">8月30日（日）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 9/5</span></td>
              <td class="col-place">鳥取市千代テニス場</td>
              <td class="col-note">8/12</td>
              <td class="col-reg"><span class="meta-row__key" style="width:auto;padding:4px 10px">県登録</span></td>
            </tr>
            <tr class="is-open" data-tags="open shi">
              <td class="col-no">12</td>
              <td class="col-badge"><span class="badge badge--open">受付中</span></td>
              <td><span class="name">第30回エネトピア杯ミックスダブルス</span><br><span style="font:400 13px/1.6 var(--fjp);color:var(--gray-500)">ミックスダブルス</span></td>
              <td class="col-date">10月18日（日）<br><span style="font:400 12px/1.6 var(--fjp);color:var(--gray-500)">予備日 10/24</span></td>
