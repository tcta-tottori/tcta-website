---
import Base from '../layouts/Base.astro';

const title = "リンク集｜鳥取市テニス協会";
const description = "鳥取市テニス協会に関係する団体・施設のリンク集。鳥取県テニス協会、公共施設予約システム、近隣協会など。";
---

<Base
  title={title}
  description={description}
>
  <!-- ============ ページヘッダー ============ -->
  <section class="page-head">
    <span class="ghost" aria-hidden="true">LINKS</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">リンク集</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true" style="margin-top:8px"></span>
        <div>
          <p class="page-title__en" style="margin:0">Links</p>
          <h1 class="page-title" style="margin-top:8px">リンク集</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">鳥取市テニス協会に関係する団体・施設のサイトです。すべて外部サイトが開きます。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="rv">
        <h2 class="sub-head">関係団体</h2>
        <div class="link-grid">
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">鳥取県テニス協会</span>
              <span class="link-card__desc">県登録・県大会に関する情報はこちら</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">鳥取県レディーステニス連盟</span>
              <span class="link-card__desc">レディースの大会・活動情報</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">施設の予約</h2>
        <div class="link-grid">
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">鳥取市公共施設予約システム</span>
              <span class="link-card__desc">市内のテニスコートの予約はこちらから</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">近隣のテニス協会・加盟クラブ</h2>
        <div class="link-grid">
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">米子市テニス協会</span>
              <span class="link-card__desc">鳥取県西部の大会情報</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">京丹後テニス協会</span>
              <span class="link-card__desc">京都府北部の大会情報</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">琴浦テニスクラブ</span>
              <span class="link-card__desc">東伯郡琴浦町のテニスクラブ</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="rv" style="margin-top:56px">
        <h2 class="sub-head">協賛・関連 <span class="todo-note">分類・正式名称は公開前に要確認</span></h2>
        <div class="link-grid">
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">テニスショップ フラシーノ</span>
              <span class="link-card__desc">鳥取市南吉方のテニス専門店</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
          <a class="link-card" href="#" rel="noopener noreferrer">
            <span class="link-card__logo" aria-hidden="true">ロゴ</span>
            <span class="link-card__text">
              <span class="link-card__name">上海茶楼</span>
              <span class="link-card__desc">鳥取市の中国上海料理店</span>
            </span>
            <span class="link-card__ext" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <p class="note">※ ロゴ画像の使用許諾と掲載団体の追加・削除は公開前に確認してください。リンク切れ防止のため年1回の定期確認を運用手順に含めます。</p>
    </div>
  </section>
</Base>
