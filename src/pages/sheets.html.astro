---
// リーグ表・審判用紙（印刷・PDF で保存）。大会の要項・ドローのページの下の入口（LeagueCalcLink.astro）から開く。
//   sheets.html?e=<大会の slug>
// リーグ表：大会運営システムに入っている組み合わせ（公開の /api/public/leagues/<slug>。league-rules.js に leagues を書いた大会はそちら）
//   から、リーグごとに名前入りのリーグ表を作る。組み合わせが無くても、人数を選んで空のリーグ表を作れる。
// 審判用紙：選んだリーグの試合ごとに名前入りで作るか、空欄（手書き用）を枚数分作る。
// 印刷の窓を開いて印刷画面を出す。印刷画面で「PDF に保存」を選ぶとダウンロードになる（src/lib/sheet-print.ts）。
// これからの大会も、運営システムにドローを入れれば（tournament-data スキル）ここにリーグが出る。
import Base from '../layouts/Base.astro';
import { siteData } from '../lib/cms.js';
import { RULE_TEXT, leagueRuleOf } from '../data/league-rules.js';
import { TOURNAMENT_APP, catalogIdOf } from '../data/live.js';

const slug = Astro.url.searchParams.get('e') ?? '';
const site = await siteData(Astro);
const ev = slug ? site.eventBySlug(slug) : null;
const conf = ev ? leagueRuleOf(ev.slug) : null;
const cfg = {
  api: ev ? TOURNAMENT_APP : '',
  slug: ev ? catalogIdOf(ev.slug) : '',
  tournament: ev?.name ?? '',
  date: String(ev?.date ?? '').slice(0, 10),
  rule: conf?.rule ?? '',
  team: conf?.rule === 'team' ? (conf.formats?.[0] ?? null) : null,
  orderNote: conf?.sheetNote ?? '',
  leagues: conf?.leagues ?? [],
  steps: Object.fromEntries(Object.entries(RULE_TEXT).map(([k, r]) => [k, r.steps])),
};
const title = `リーグ表・審判用紙${ev ? `（${ev.name}）` : ''}｜鳥取市テニス協会`;
const description = '大会のリーグ表と審判用紙を、印刷したり PDF で保存したりできるページです。組み合わせの入った大会は名前入りで作れます。';
---

<Base title={title} description={description} navActive="tournaments" mobileNavActive="tournaments">
  <section class="page-head">
    <span class="ghost" aria-hidden="true">SHEETS</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <a href="tournaments.html">大会情報</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        {ev && <><a href={ev.url}>{ev.displayName}</a><span class="breadcrumb__sep" aria-hidden="true">›</span></>}
        <span aria-current="page">リーグ表・審判用紙</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">Score Sheets</p>
          <h1 class="page-title">リーグ表・審判用紙</h1>
        </div>
      </div>
      <p class="page-lead fu" style="animation-delay:.15s">
        大会で使うリーグ表と審判用紙を印刷できます。印刷の画面で「PDF に保存」を選ぶと、ファイルとしてダウンロードできます。
        {ev && <><br /><b>{ev.name}</b> の組み合わせが入っていれば、名前入りで作れます。</>}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--result">
      <div class="lc sh" id="sh" data-cfg={JSON.stringify(cfg)}>
        {/* リーグ表 */}
        <div class="lc-box rv">
          <h2 class="lc-h sh-h"><span class="sh-h__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 4v16M15 4v16" /></svg>
          </span>リーグ表</h2>
          <div id="sh-league-area" hidden>
            <div class="sh-bar">
              <p class="sh-bar__text" id="sh-count"></p>
              <div class="sh-bar__btns">
                <button type="button" class="sh-mini" id="sh-all">すべて選ぶ</button>
                <button type="button" class="sh-mini" id="sh-none">すべて外す</button>
              </div>
            </div>
            <div class="sh-groups" id="sh-groups"></div>
          </div>
          <p class="sh-empty" id="sh-empty">{ev ? '組み合わせを読み込んでいます…' : '大会のページから開くと、その大会の組み合わせで名前入りのリーグ表を作れます。'}</p>
          <div class="sh-blank">
            <label class="sh-check"><input type="checkbox" id="sh-blank-on" /><span>空のリーグ表（手書き用）も作る</span></label>
            <label class="sh-inline">人数
              <select id="sh-blank-n">{[3, 4, 5, 6, 7].map((k) => <option value={k} selected={k === 4}>{k}名</option>)}</select>
            </label>
            <label class="sh-inline">枚数
              <select id="sh-blank-c">{[1, 2, 3, 4, 5, 6, 8, 10].map((k) => <option value={k}>{k}枚</option>)}</select>
            </label>
          </div>
          <div class="sh-go">
            <label class="sh-inline">用紙
              <select id="sh-league-paper">
                <option value="a4-landscape" selected>A4 横</option><option value="a4-portrait">A4 縦</option><option value="b4-landscape">B4 横</option><option value="a3-landscape">A3 横</option><option value="b5-landscape">B5 横</option>
              </select>
            </label>
            <button type="button" class="btn btn--primary sh-print" id="sh-league-print">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M6 14h12v7H6z" /></svg>
              リーグ表を印刷・PDF保存
            </button>
          </div>
        </div>

        {/* 審判用紙 */}
        <div class="lc-box rv">
          <h2 class="lc-h sh-h"><span class="sh-h__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><path d="M14 3v6h6M8 13h8M8 17h5" /></svg>
          </span>審判用紙</h2>
          <div class="lc-seg sh-mode" role="radiogroup" aria-label="審判用紙の作り方">
            <label class="lc-seg__opt" id="sh-mode-named-opt"><input type="radio" name="sh-mode" value="named" /><span>名前入り（リーグの試合ごと）</span></label>
            <label class="lc-seg__opt"><input type="radio" name="sh-mode" value="blank" checked /><span>空欄（手書き用）</span></label>
          </div>
          <p class="lc-note" id="sh-ref-note">大会名と開催日だけを入れた、空欄の審判用紙を作ります。</p>
          <div class="sh-go">
            <label class="sh-inline" id="sh-ref-count-wrap">枚数
              <select id="sh-ref-count">{[1, 2, 4, 6, 8, 10, 16, 20, 30].map((k) => <option value={k}>{k}枚</option>)}</select>
            </label>
            <label class="sh-inline">用紙
              <select id="sh-ref-paper">
                <option value="b5-landscape" selected>B5 横</option><option value="a4-landscape">A4 横</option><option value="b5-portrait">B5 縦</option><option value="a4-portrait">A4 縦</option>
              </select>
            </label>
            <button type="button" class="btn btn--primary sh-print" id="sh-ref-print">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M6 14h12v7H6z" /></svg>
              審判用紙を印刷・PDF保存
            </button>
          </div>
        </div>

        {/* PDF で保存する方法 */}
        <div class="lc-box sh-how rv">
          <h2 class="lc-h">PDF で保存（ダウンロード）するには</h2>
          <ol class="sh-how__list">
            <li>上のボタンを押すと、用紙を並べた画面が別に開き、印刷の画面が出ます。</li>
            <li>プリンターの選択で「PDF に保存」（iPhone は左右に広げるか共有から「ファイルに保存」）を選びます。</li>
            <li>用紙の大きさ・向きは、選んだ用紙（リーグ表は A4 横、審判用紙は B5 横など）のまま、余白は「既定」で保存してください。</li>
          </ol>
          <p class="lc-note">印刷の画面が出ないときは、ブラウザのポップアップを許可してから、もう一度押してください。</p>
        </div>

        {ev && <p class="rv"><a class="ghost-link" href={ev.url}>← {ev.displayName} のページへ</a></p>}
      </div>
    </div>
  </section>
</Base>

<script>
  import { leagueSheetHtml, refereeSheetHtml, openPrint, matchOrder, CIRCLED, reiwaDate, splitLeagueName, type SheetPlayer } from '../lib/sheet-print';

  type Player = { position: number; name: string; affiliation: string; partnerName?: string; partnerAffiliation?: string };
  type League = { name: string; type: string; rankRule: string; format?: string; courts?: string[]; players: Player[] };
  type Cfg = { api: string; slug: string; tournament: string; date: string; rule: string; team: { total: number; matches?: string[] } | null; orderNote: string; leagues: { name: string; teams: string[] }[]; steps: Record<string, string[]> };

  const root = document.getElementById('sh')!;
  const cfg = JSON.parse(root.dataset.cfg || '{}') as Cfg;
  let leagues: League[] = [];
  let date = cfg.date;
  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const sur = (s: string) => String(s ?? '').trim().split(/[\s　]+/)[0] ?? '';
  const KEY = `tcta-sheets:${cfg.slug || 'free'}`;
  const load = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
  const store = (patch: Record<string, unknown>) => { try { localStorage.setItem(KEY, JSON.stringify({ ...load(), ...patch })); } catch { /* */ } };

  const playerOf = (p: Player, team: boolean): SheetPlayer => {
    if (team) return { names: p.name, affs: '', short: p.name };
    if (p.partnerName) return { names: `${p.name}\n${p.partnerName}`, affs: `${p.affiliation || ''}\n${p.partnerAffiliation || ''}`, short: `${sur(p.name)}・${sur(p.partnerName)}` };
    return { names: p.name, affs: p.affiliation || '', short: sur(p.name) };
  };
  const isTeam = (l: League) => l.type === 'Team' || !!cfg.team;
  const ruleOf = (l?: League) => cfg.rule || (l && (l.rankRule === 'games' || l.rankRule === 'wins') ? l.rankRule : 'wins');
  const formatOf = (l?: League) => (cfg.team ? `${(cfg.team.matches ?? []).join('・')} 各 合計${cfg.team.total}ゲーム` : l?.format ?? '');
  const courtText = (l: League) => (l.courts?.length ? `No.${l.courts.join('・')} コート` : '');
  const orderNote = (team: boolean) => cfg.orderNote || `1番目の${team ? 'チーム' : '選手（ペア）'}が進行管理をお願いします。`;
  const orderText = (k: number) => matchOrder(k).map(([a, b]) => `${CIRCLED[a]}-${CIRCLED[b]}`).join(' ');

  // ---- リーグの一覧（種目ごとにまとめ、チェックで選ぶ）----
  const groupsEl = document.getElementById('sh-groups')!;
  function selected(): League[] {
    const on = new Set([...groupsEl.querySelectorAll<HTMLInputElement>('input[type=checkbox]:checked')].map((x) => x.value));
    return leagues.filter((l) => on.has(l.name));
  }
  function updateCount() {
    const k = selected().length;
    document.getElementById('sh-count')!.textContent = `${leagues.length} リーグ中 ${k} リーグを選んでいます`;
    groupsEl.querySelectorAll<HTMLLabelElement>('.sh-lg').forEach((el) => el.classList.toggle('is-on', (el.querySelector('input') as HTMLInputElement).checked));
    store({ off: leagues.filter((l) => !selected().includes(l)).map((l) => l.name) });
    renderRefNote();
  }
  function showLeagues(list: League[]) {
    leagues = list.filter((l) => l.players.length >= 2);
    const empty = document.getElementById('sh-empty')!;
    if (!leagues.length) {
      if (cfg.slug) empty.textContent = 'この大会の組み合わせ（リーグ）は、まだ入っていません。下の「空のリーグ表」で、手書き用のリーグ表を作れます。';
      (document.getElementById('sh-blank-on') as HTMLInputElement).checked = true;
      document.querySelector<HTMLInputElement>('input[name=sh-mode][value=named]')!.disabled = true;
      document.getElementById('sh-mode-named-opt')!.classList.add('is-off');
      return;
    }
    empty.hidden = true;
    document.getElementById('sh-league-area')!.hidden = false;
    const off = new Set<string>(load().off ?? []);
    const groups = new Map<string, League[]>();
    for (const l of leagues) {
      const [t] = splitLeagueName(l.name);
      const k = t || 'リーグ';
      groups.set(k, [...(groups.get(k) ?? []), l]);
    }
    groupsEl.innerHTML = [...groups].map(([t, ls]) => `<div class="sh-group"><p class="sh-group__title">${esc(t)}</p><div class="sh-lgs">${ls.map((l) => {
      const [, lg] = splitLeagueName(l.name);
      const team = isTeam(l);
      return `<label class="sh-lg"><input type="checkbox" value="${esc(l.name)}" ${off.has(l.name) ? '' : 'checked'}><span class="sh-lg__head"><b>${esc(lg ? `${lg}リーグ` : l.name)}</b><small>${l.players.length}${team ? 'チーム' : l.type === 'Doubles' ? 'ペア' : '名'}</small></span><span class="sh-lg__names">${l.players.map((p) => `<span>${esc(team ? p.name : playerOf(p, false).short)}</span>`).join('<i>／</i>')}</span></label>`;
    }).join('')}</div></div>`).join('');
    groupsEl.querySelectorAll('input').forEach((x) => x.addEventListener('change', updateCount));
    const radio = document.querySelector<HTMLInputElement>('input[name=sh-mode][value=named]')!;
    if (load().mode !== 'blank') radio.checked = true;
    updateCount();
  }
  document.getElementById('sh-all')!.addEventListener('click', () => { groupsEl.querySelectorAll<HTMLInputElement>('input').forEach((x) => { x.checked = true; }); updateCount(); });
  document.getElementById('sh-none')!.addEventListener('click', () => { groupsEl.querySelectorAll<HTMLInputElement>('input').forEach((x) => { x.checked = false; }); updateCount(); });

  // ---- 審判用紙の作り方の説明 ----
  const mode = () => (document.querySelector<HTMLInputElement>('input[name=sh-mode]:checked')?.value ?? 'blank');
  function renderRefNote() {
    const named = mode() === 'named';
    const n = selected().reduce((a, l) => a + matchOrder(l.players.length).length, 0);
    document.getElementById('sh-ref-note')!.textContent = named
      ? `上で選んだリーグの試合ごとに、種目・リーグ・コート・試合方法・選手名を入れた審判用紙を作ります（${n} 試合分）。`
      : '大会名と開催日だけを入れた、空欄の審判用紙を作ります。';
    document.getElementById('sh-ref-count-wrap')!.hidden = named;
  }
  document.querySelectorAll<HTMLInputElement>('input[name=sh-mode]').forEach((x) => x.addEventListener('change', () => { store({ mode: mode() }); renderRefNote(); }));

  // ---- 印刷 ----
  const popupNG = () => alert('印刷の画面を開けませんでした。ブラウザのポップアップを許可してから、もう一度押してください。');
  document.getElementById('sh-league-print')!.addEventListener('click', () => {
    const pages: ((W: number, H: number) => string)[] = [];
    for (const l of selected()) {
      const team = isTeam(l);
      const [t, lg] = splitLeagueName(l.name);
      const ps = [...l.players].sort((a, b) => a.position - b.position).map((p) => playerOf(p, team));
      pages.push((W, H) => leagueSheetHtml({
        title: t || l.name, league: lg, court: courtText(l), tournament: cfg.tournament, format: formatOf(l),
        players: ps, order: orderText(ps.length), orderNote: orderNote(team), rules: cfg.steps[ruleOf(l)] ?? [],
      }, W, H));
    }
    if ((document.getElementById('sh-blank-on') as HTMLInputElement).checked) {
      const n = Number((document.getElementById('sh-blank-n') as HTMLSelectElement).value);
      const c = Number((document.getElementById('sh-blank-c') as HTMLSelectElement).value);
      for (let k = 0; k < c; k++) {
        pages.push((W, H) => leagueSheetHtml({
          title: '', league: '', court: '', tournament: cfg.tournament, format: formatOf(leagues[0]),
          players: Array.from({ length: n }, () => ({ names: '', affs: '', short: '' })), order: orderText(n), orderNote: orderNote(!!cfg.team), rules: cfg.steps[ruleOf(leagues[0])] ?? [],
        }, W, H));
      }
    }
    if (!pages.length) { alert('リーグを選ぶか、「空のリーグ表も作る」にチェックを入れてください。'); return; }
    if (!openPrint(`リーグ表 ${cfg.tournament}`.trim(), (document.getElementById('sh-league-paper') as HTMLSelectElement).value, pages)) popupNG();
  });
  document.getElementById('sh-ref-print')!.addEventListener('click', () => {
    const pages: ((W: number, H: number) => string)[] = [];
    const d = reiwaDate(date);
    const side = (p: Player | undefined, no: number, team: boolean) => {
      if (!p) return { no: '', names: '', affs: '' };
      const x = playerOf(p, team);
      return { no: String(no), names: x.names, affs: x.affs };
    };
    if (mode() === 'named') {
      for (const l of selected()) {
        const team = isTeam(l);
        const [t, lg] = splitLeagueName(l.name);
        const ps = [...l.players].sort((a, b) => a.position - b.position);
        const method = (formatOf(l) || '').replace(/・/g, '\n').replace(/（/g, '\n（').replace(/\n+/g, '\n').trim();
        for (const [a, b] of matchOrder(ps.length)) {
          pages.push((W, H) => refereeSheetHtml({
            tournament: cfg.tournament, date: d, event: lg ? `${t}\n${lg}リーグ` : l.name, round: 'リーグ戦',
            court: l.courts?.[0] ?? '', method, left: side(ps[a], a + 1, team), right: side(ps[b], b + 1, team),
          }, W, H));
        }
      }
      if (!pages.length) { alert('上の「リーグ表」で、審判用紙を作るリーグを選んでください。'); return; }
    } else {
      const c = Number((document.getElementById('sh-ref-count') as HTMLSelectElement).value);
      for (let k = 0; k < c; k++) {
        pages.push((W, H) => refereeSheetHtml({ tournament: cfg.tournament, date: d, event: '', round: '', court: '', method: '', left: { no: '', names: '', affs: '' }, right: { no: '', names: '', affs: '' } }, W, H));
      }
    }
    if (!openPrint(`審判用紙 ${cfg.tournament}`.trim(), (document.getElementById('sh-ref-paper') as HTMLSelectElement).value, pages)) popupNG();
  });

  // ---- 組み合わせを読む ----
  if (cfg.leagues.length) {
    showLeagues(cfg.leagues.map((l) => ({ name: l.name, type: 'Team', rankRule: '', players: l.teams.map((t, i) => ({ position: i + 1, name: t, affiliation: '' })) })));
  } else if (cfg.api && cfg.slug) {
    fetch(`${cfg.api}/api/public/leagues/${encodeURIComponent(cfg.slug)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => { if (d?.date) date = String(d.date).slice(0, 10); showLeagues((d?.leagues ?? []) as League[]); })
      .catch(() => showLeagues([]));
  } else {
    showLeagues([]);
  }
  renderRefNote();
</script>
