---
// 入賞者の行。順位は種目の枠と同じ形のバッジ（順位ごとの色：金・銀・銅・緑、それ以外は灰色）、名前は太字、「選手」「ペア」は普通の太さ。
// 写真の下の1行（.rblock__caption）と、写真1枚ごとの名前（.gallery__cap）で使う。
// 名前の表記（シングルスはフルネーム、ダブルスは苗字だけ）は award.js でそろえる。
//   items    … 成績の配列 [{ award, name, note }]
//   texts    … 「優勝 ○○ 選手」の文字列の配列（管理画面のラベルから拾ったもの）
//   text     … 同じものを「　」でつないだ1本の文字列
//   category … 種目名（ダブルス／ミックスなら、ペアの名前を苗字だけにする）
import { parseAward, placeToAward, awardBadge, isPairCategory } from '../data/award.js';
const { items = null, texts = null, text = null, category = '' } = Astro.props;
const pair = isPairCategory(category);
const list = items ? items.map((p) => placeToAward(p, pair))
  : texts ? texts.map((t) => parseAward(t, '', pair))
  : String(text ?? '').split('　').filter(Boolean).map((t) => parseAward(t, '', pair));
const shown = list.filter((a) => a.award || a.name);
---

{shown.length > 0 && (
  <span class="awards">
    {shown.map((a) => {
      const b = a.award ? awardBadge(a.award) : null;
      return (
        <span class="award">
          {a.prefix && <span class="award__pre">{a.prefix}</span>}
          {a.award && <span class:list={['award__badge', `award__badge--${b.rank}`]}>{b.label}</span>}
          {a.name && <span class="award__who"><b class="award__name">{a.name}</b>{a.suffix && <span class="award__suffix">{a.suffix}</span>}{a.note && <span class="award__note">{a.note}</span>}</span>}
        </span>
      );
    })}
  </span>
)}
