---
// 入賞者の行。順位は画像のバッジ（優勝・準優勝・3位・4位。それ以外は文字）、名前は太字、「選手」「ペア」は普通の太さ。
// 写真の下の1行（.rblock__caption）と、写真1枚ごとの名前（.gallery__cap）で使う。
//   items … 成績の配列 [{ award, name, note }]
//   texts … 「優勝 ○○ 選手」の文字列の配列（管理画面のラベルから拾ったもの）
//   text  … 同じものを「　」でつないだ1本の文字列
import { parseAward, placeToAward, awardBadge } from '../data/award.js';
const { items = null, texts = null, text = null } = Astro.props;
const list = items ? items.map(placeToAward)
  : texts ? texts.map((t) => parseAward(t))
  : String(text ?? '').split('　').filter(Boolean).map((t) => parseAward(t));
const shown = list.filter((a) => a.award || a.name);
---

{shown.length > 0 && (
  <span class="awards">
    {shown.map((a) => {
      const b = a.award ? awardBadge(a.award) : null;
      return (
        <span class="award">
          {a.prefix && <span class="award__pre">{a.prefix}</span>}
          {a.award && (b
            ? <img class="award__badge" src={b.img} alt={b.alt} width={b.w} height={b.h} loading="lazy" decoding="async" />
            : <span class="award__badge award__badge--text">{a.award}</span>)}
          {a.name && <span class="award__who"><b class="award__name">{a.name}</b>{a.suffix && <span class="award__suffix">{a.suffix}</span>}{a.note && <span class="award__note">{a.note}</span>}</span>}
        </span>
      );
    })}
  </span>
)}
