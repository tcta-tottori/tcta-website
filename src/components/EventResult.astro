---
// 大会1件の「結果」の中身（EmDash の大会）。大会ページ（event-*.html）と結果だけのページ（result-*.html）で共用。
// どの大会も同じ構成で出す（旧サイトの結果ページと同じ）。
//   クラブ対抗戦 … 部ごとに リーグ表 → 優勝クラブの写真 → 優勝クラブの名前（ClubDivisions）
//   それ以外    … 種目ごとに 結果表 → 入賞者の写真（1枚ずつ名前つき）→ 入賞者の名前の1行（event-result.js）
// 成績の表は別に出さない（名前は写真の下にある）。
//
//   e          … events.js の大会1件
//   layout     … event-result.js の eventResultLayout(e)。省略すればここで作る
//   club       … club-event.js の clubEventLayout(e)。省略すればここで作る
//   restPhotos … どの種目にも付かなかった当日の写真を、この中に「当日の写真」として出すか（既定 true）。
//                大会ページは自分の節として出すので false を渡す
import ClubDivisions from './ClubDivisions.astro';
import SheetList from './SheetList.astro';
import AwardLine from './AwardLine.astro';
import { clubEventLayout } from '../data/club-event.js';
import { eventResultLayout } from '../data/event-result.js';

const { e, restPhotos: showRest = true } = Astro.props;
const club = Astro.props.club === undefined ? clubEventLayout(e) : Astro.props.club;
const layout = club ? null : Astro.props.layout === undefined ? eventResultLayout(e) : Astro.props.layout;
const result = e.sections.find((s) => s.key === 'result');
const anchor = (label, i) => `blk-${i}-${String(label).replace(/[^0-9A-Za-z぀-ヿ一-鿿]/g, '')}`;
const rest = layout?.restPhotos ?? [];
let photoNo = 0;
---

{club && (
  <>
    <ClubDivisions club={club} name={e.name} />
    {result?.pdfs.length > 0 && <div class="rv"><SheetList pdfs={result.pdfs} alt="" /></div>}
  </>
)}

{!club && layout && (
  <>
    {/* 種目のボタンは 1 行に並べ、収まらない分は横スクロール（.hscroll。端を透かして「→SCROLL」） */}
    {(layout.blocks.length > 1 || (showRest && rest.length > 0)) && (
      <nav class="jump jump--scroll hscroll rv" data-hscroll style="margin-top:0" aria-label="種目へ移動">
        <div class="jump__track hscroll__track">
          {layout.blocks.map((b, i) => <a class="jump__link" href={`#${anchor(b.label, i)}`}>{b.label || '結果'}</a>)}
          {showRest && rest.length > 0 && <a class="jump__link" href="#photos">当日の写真<span class="jump__n">{rest.length}</span></a>}
        </div>
        <span class="hscroll__hint" aria-hidden="true"><span class="hscroll__arrow"></span>SCROLL</span>
      </nav>
    )}
    {layout.blocks.map((b, i) => (
      <section class="division rv" id={anchor(b.label, i)}>
        {/* 見出しは置かない（種目名はリーグ表・ドロー表の画像の中にある）。入賞者の名前は写真1枚ずつの下に */}
        <div class="rblock">
          {/* 結果表（ドロー表・リーグ表） */}
          {b.sheets.length > 0 && (
            <div class:list={['rblock__sheet', b.sheets.length > 1 && 'sheets sheets--result']}>
              {b.sheets.map((sh) => (
                <a class="sheet sheet--result" href={sh.src}>
                  <img src={sh.src} alt={`${e.name} ${b.label || '結果'}${sh.label && sh.label !== b.label ? ' ' + sh.label : ''}`} width={sh.w} height={sh.h} loading="lazy" decoding="async">
                </a>
              ))}
            </div>
          )}
          {/* その下に入賞者の写真。写真1枚ずつの下に「種目 ｜ 優勝 ○○」。
              写真のラベルに名前があればそれ、無ければ成績（優勝 → 準優勝 → …）を写真の順に1つずつ。
              写真より成績が多いぶん（写真の無い入賞者）は、写真のあとに1行ずつ */}
          {(() => {
            const own = b.photos.some((ph) => ph.caption);
            const caps = b.photos.map((ph, k) => (own ? ph.caption : b.captions[k]) ?? null);
            const rest = own ? [] : b.captions.slice(b.photos.length);
            return (
              <>
                {b.photos.length > 0 && (
                  <div class="rblock__photos division__photos">
                    <div class="gallery gallery--winners">
                      {b.photos.map((ph, k) => (
                        <a class="gallery__item" href={ph.src}>
                          <img src={ph.src} alt={`${e.name} ${b.label}${caps[k] ? ' ' + caps[k] : ''} 入賞者の写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
                          {caps[k] && <span class="gallery__cap">{b.label && <span class="rblock__cat">{b.label}</span>}<AwardLine texts={[caps[k]]} category={b.label} /></span>}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
                {rest.map((c) => (
                  <p class="rblock__caption">{b.label && <span class="rblock__cat">{b.label}</span>}<AwardLine texts={[c]} category={b.label} /></p>
                ))}
              </>
            );
          })()}
        </div>
      </section>
    ))}
    {layout.restSheets.length > 0 && (
      <div class="rv" style="margin-top:48px">
        <h2 class="sub-head">そのほかの結果表</h2>
        <SheetList images={layout.restSheets} alt={`${e.name} 結果`} />
      </div>
    )}
    {result?.pdfs.length > 0 && <div class="rv"><SheetList pdfs={result.pdfs} alt="" /></div>}
    {showRest && rest.length > 0 && (
      <div class="rv" id="photos" style="margin-top:64px">
        <div class="esec__head"><h2 class="sub-head" style="margin-bottom:0">当日の写真</h2><span class="gallery__count">{rest.length}枚</span></div>
        <div class="gallery">
          {rest.map((ph) => (
            <a class="gallery__item" href={ph.src}>
              <img src={ph.src} alt={`${e.name}の写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
            </a>
          ))}
        </div>
      </div>
    )}
  </>
)}

{/* 結果の画像も成績も無い（PDF だけなど） */}
{!club && !layout && result && <div class="rv"><SheetList images={result.images} pdfs={result.pdfs} alt={`${e.name} 結果`} /></div>}
