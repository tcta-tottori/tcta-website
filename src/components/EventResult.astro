---
// 大会1件の「結果」の中身（EmDash の大会）。大会ページ（event-*.html）と結果だけのページ（result-*.html）で共用。
// どの大会も同じ構成で出す（旧サイトの結果ページと同じ）。
//   クラブ対抗戦 … 部ごとに リーグ表 → 優勝クラブの写真 → 優勝クラブの名前（ClubDivisions）
//   それ以外    … 種目ごとに 結果表 → 入賞者の写真（1枚ずつ名前つき）→ 入賞者の名前の1行（event-result.js）
// 成績の表は別に出さない（名前は写真の下にある）。
//
//   e          … events.js の大会1件
//   layout     … event-result.js の eventResultLayout(e)。省略すればここで作る
//   club       … club-event.js の clubEventLayout(e)。省略すればここで作る
//   restPhotos … どの種目にも付かなかった当日の写真を、この中に「当日の写真」として出すか（既定 true）。
//                大会ページは自分の節として出すので false を渡す
import ClubDivisions from './ClubDivisions.astro';
import SheetList from './SheetList.astro';
import AwardLine from './AwardLine.astro';
import { clubEventLayout } from '../data/club-event.js';
import { eventResultLayout } from '../data/event-result.js';
import { LIVE_DRAW_URL, LIVE_ORDER_URL } from '../data/live.js';
import { EXTRA_RESULT_VIDEOS } from '../data/official-extra.js';

const { e, restPhotos: showRest = true } = Astro.props;
const club = Astro.props.club === undefined ? clubEventLayout(e) : Astro.props.club;
const layout = club ? null : Astro.props.layout === undefined ? eventResultLayout(e) : Astro.props.layout;
const result = e.sections.find((s) => s.key === 'result');
const anchor = (label, i) => `blk-${i}-${String(label).replace(/[^0-9A-Za-z぀-ヿ一-鿿]/g, '')}`;
const rest = layout?.restPhotos ?? [];
let photoNo = 0;
const note = e.resultNote ?? null;
const video = EXTRA_RESULT_VIDEOS[e.slug] ?? null;
---

{/* 結果の欄のいちばん上：大会の動画（YouTube） */}
{video && (
  <div class="result-video rv">
    <div class="video-embed">
      <iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={`${video.title}（YouTube）`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <p class="note">※ 動画は協会の YouTube チャンネルで公開しています。<a href={`https://youtu.be/${video.id}`} target="_blank" rel="noopener">YouTube で見る</a></p>
  </div>
)}

{/* 結果の欄の上のお知らせ（確認中の種目など） */}
{note?.notice && (
  <aside class="rev-notice result-notice rv" aria-label="結果についてのお知らせ">
    <p class="rev-notice__head">お知らせ</p>
    <p class="result-notice__text">{note.notice}</p>
  </aside>
)}

{club && (
  <>
    <ClubDivisions club={club} name={e.name} />
    {result?.pdfs.length > 0 && <div class="rv"><SheetList pdfs={result.pdfs} alt="" /></div>}
  </>
)}

{!club && layout && (
  <>
    {/* 種目のボタンは 1 行に並べ、収まらない分は横スクロール（.hscroll。端を透かして「→SCROLL」） */}
    {(layout.blocks.length > 1 || (showRest && rest.length > 0)) && (
      <nav class="jump jump--scroll hscroll rv" data-hscroll style="margin-top:0" aria-label="種目へ移動">
        <div class="jump__track hscroll__track">
          {layout.blocks.map((b, i) => <a class="jump__link" href={`#${anchor(b.label, i)}`}>{b.label || '結果'}</a>)}
          {showRest && rest.length > 0 && <a class="jump__link" href="#photos">当日の写真<span class="jump__n">{rest.length}</span></a>}
        </div>
        <span class="hscroll__hint" aria-hidden="true"><span class="hscroll__arrow"></span>SCROLL</span>
      </nav>
    )}
    {layout.blocks.map((b, i) => (
      <section class="division rv" id={anchor(b.label, i)}>
        {/* 見出しは置かない（種目名はリーグ表・ドロー表の画像の中にある）。入賞者の名前は写真1枚ずつの下に */}
        <div class="rblock">
          {(() => {
            // 写真1枚ずつの下に「種目 ｜ 優勝 ○○」。写真のラベルに名前があればそれ、無ければ成績（優勝 → 準優勝 → …）を写真の順に1つずつ。
            // 写真より成績が多いぶん（写真の無い入賞者）は、写真のあとに1行ずつ
            const own = b.photos.some((ph) => ph.caption);
            const caps = new Map(b.photos.map((ph, k) => [ph, (own ? ph.caption : b.captions[k]) ?? null]));
            // 写真に名前の説明がある大会（入賞者を写真で見せる大会）は、写真の無い入賞者・種目には文字も出さない
            const photoCaptioned = layout.blocks.some((x) => x.photos.some((ph) => ph.caption));
            const rest = own || photoCaptioned ? [] : b.captions.slice(b.photos.length);
            // 写真に after（結果表のファイル名）があれば、その結果表のすぐ下に置く（「1位・2位トーナメント」の表の下に、その入賞者の写真など）
            const base = (src) => String(src).replace(/^.*\//, '').replace(/\.\w+$/, '');
            const placed = new Set();
            const groups = b.sheets.map((sh) => {
              const photos = b.photos.filter((ph) => ph.after && ph.after === base(sh.src));
              photos.forEach((ph) => placed.add(ph));
              return { sheet: sh, photos };
            });
            const tail = b.photos.filter((ph) => !placed.has(ph));
            const photosOf = (list) => list.length > 0 && (
              <div class="rblock__photos division__photos rblock__photos--big">
                <div class="gallery gallery--winners">
                  {list.map((ph) => (
                    <a class="gallery__item" href={ph.src}>
                      <img src={ph.src} alt={`${e.name} ${b.label}${caps.get(ph) ? ' ' + caps.get(ph) : ''} 入賞者の写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
                      {caps.get(ph) && <span class="gallery__cap">{b.label && <span class="rblock__cat">{b.label}</span>}<AwardLine texts={[caps.get(ph)]} category={b.label} /></span>}
                    </a>
                  ))}
                </div>
              </div>
            );
            const sheetsOf = (list) => (
              <div class:list={['rblock__sheet', list.length > 1 && 'sheets sheets--result']}>
                {list.map((sh) => (
                  <a class="sheet sheet--result" href={sh.src}>
                    <img src={sh.src} alt={`${e.name} ${b.label || '結果'}${sh.label && sh.label !== b.label ? ' ' + sh.label : ''}`} width={sh.w} height={sh.h} loading="lazy" decoding="async">
                  </a>
                ))}
              </div>
            );
            const interleave = placed.size > 0;
            return (
              <>
                {/* 結果表（ドロー表・リーグ表）。写真の置き場所の指定があれば、表ごとにその下へ写真を入れる */}
                {interleave
                  ? groups.map((g) => (<>{sheetsOf([g.sheet])}{photosOf(g.photos)}</>))
                  : b.sheets.length > 0 && sheetsOf(b.sheets)}
                {photosOf(tail)}
                {rest.map((c) => (
                  <p class="rblock__caption">{b.label && <span class="rblock__cat">{b.label}</span>}<AwardLine texts={[c]} category={b.label} /></p>
                ))}
              </>
            );
          })()}
        </div>
      </section>
    ))}
    {layout.restSheets.length > 0 && (
      <div class="rv" style="margin-top:48px">
        <h2 class="sub-head">そのほかの結果表</h2>
        <SheetList images={layout.restSheets} alt={`${e.name} 結果`} />
      </div>
    )}
    {result?.pdfs.length > 0 && <div class="rv"><SheetList pdfs={result.pdfs} alt="" /></div>}
    {showRest && rest.length > 0 && (
      <div class="rv" id="photos" style="margin-top:64px">
        <div class="esec__head"><h2 class="sub-head" style="margin-bottom:0">当日の写真</h2><span class="gallery__count">{rest.length}枚</span></div>
        <div class="gallery">
          {rest.map((ph) => (
            <a class="gallery__item" href={ph.src}>
              <img src={ph.src} alt={`${e.name}の写真 ${++photoNo}`} width={ph.w} height={ph.h} loading="lazy" decoding="async">
            </a>
          ))}
        </div>
      </div>
    )}
  </>
)}

{/* 結果の画像も成績も無い（PDF だけなど） */}
{!club && !layout && result && <div class="rv"><SheetList images={result.images} pdfs={result.pdfs} alt={`${e.name} 結果`} /></div>}

{/* 結果の欄の下に、大会運営システムの観戦ページ（ドロー・対戦順）への案内 */}
{note?.live && (
  <section class="live-box result-live rv" aria-labelledby="result-live-title">
    <div class="live-box__head">
      <h2 class="live-box__title" id="result-live-title">観戦ページ</h2>
      <span class="live-box__en">LIVE VIEW</span>
    </div>
    <p class="live-box__lead">大会運営システムの観戦ページで、当日のドロー表・リーグ表と対戦順を見られます（次の大会の運営が始まると、その大会の表示に切り替わります）。</p>
    <div class="live-box__btns">
      <a class="btn btn--primary" href={LIVE_DRAW_URL} target="_blank" rel="noopener">ドロー・結果を見る <span class="ln-arrow" aria-hidden="true"></span></a>
      <a class="btn btn--outline" href={LIVE_ORDER_URL} target="_blank" rel="noopener">対戦順・進み具合 <span class="ln-arrow" aria-hidden="true"></span></a>
    </div>
  </section>
)}
