---
// 共通のアイコン。線ではなく面で描いてあるので、色は色指定を継ぐ（currentColor）。
// 大きさは font-size に合わせて 1em で出す（size を渡せば固定もできる）。
//
//   list … 箇条書き（種目に添える）
//   pin  … 地図のピン（会場・コートに添える）
//   calendar … カレンダー（日程に添える）
//   youtube / instagram / twitter / facebook … 協会の SNS（フッター・リンク集）
//   line … LINE 公式アカウント（フッター）。公式マークと同じ、吹き出しに LINE の文字をくり抜いた形
const { name, size = '1em', class: cls = '' } = Astro.props;

const PATHS = {
  list: `
    <circle cx="4.2" cy="6" r="2.4"/>
    <circle cx="4.2" cy="12" r="2.4"/>
    <circle cx="4.2" cy="18" r="2.4"/>
    <rect x="9.6" y="4.7" width="12.2" height="2.6" rx="1.3"/>
    <rect x="9.6" y="10.7" width="12.2" height="2.6" rx="1.3"/>
    <rect x="9.6" y="16.7" width="12.2" height="2.6" rx="1.3"/>
  `,
  // しずく形の外側と、中をくり抜く円。evenodd で円の内側を抜いている。
  pin: `
    <path fill-rule="evenodd" d="M12 22.4c-.3 0-.5-.1-.7-.3C10.6 21.3 4 13.9 4 9.4a8 8 0 1 1 16 0c0 4.5-6.6 11.9-7.3 12.7-.2.2-.4.3-.7.3Zm0-16.5a3.7 3.7 0 1 0 0 7.4 3.7 3.7 0 0 0 0-7.4Z"/>
  `,
  // 上に2本の留め具、中に日付のマス目。評価の順で枠の中をくり抜いている。
  calendar: `
    <path fill-rule="evenodd" d="M7 2.2a1.2 1.2 0 0 1 1.2 1.2V5h7.6V3.4a1.2 1.2 0 1 1 2.4 0V5h.6A3.2 3.2 0 0 1 22 8.2v10.6a3.2 3.2 0 0 1-3.2 3.2H5.2A3.2 3.2 0 0 1 2 18.8V8.2A3.2 3.2 0 0 1 5.2 5h.6V3.4A1.2 1.2 0 0 1 7 2.2ZM4.4 10v8.8c0 .4.4.8.8.8h13.6c.4 0 .8-.4.8-.8V10H4.4Z"/>
    <rect x="6.5" y="12" width="3" height="2.6" rx=".5"/>
    <rect x="10.5" y="12" width="3" height="2.6" rx=".5"/>
    <rect x="14.5" y="12" width="3" height="2.6" rx=".5"/>
    <rect x="6.5" y="15.8" width="3" height="2.6" rx=".5"/>
    <rect x="10.5" y="15.8" width="3" height="2.6" rx=".5"/>
  `,
  // 角丸の画面に再生の三角をくり抜いたもの
  youtube: `
    <path fill-rule="evenodd" d="M12 4.5c3.1 0 6.1.1 7.6.4a2.7 2.7 0 0 1 1.9 1.9c.4 1.5.5 3.4.5 5.2s-.1 3.7-.5 5.2a2.7 2.7 0 0 1-1.9 1.9c-1.5.3-4.5.4-7.6.4s-6.1-.1-7.6-.4a2.7 2.7 0 0 1-1.9-1.9C2.1 15.7 2 13.8 2 12s.1-3.7.5-5.2a2.7 2.7 0 0 1 1.9-1.9c1.5-.3 4.5-.4 7.6-.4ZM10 8.7v6.6l5.6-3.3L10 8.7Z"/>
  `,
  // 角丸の枠と、中のレンズ、右上の点
  instagram: `
    <path fill-rule="evenodd" d="M7.6 2.5h8.8a5.1 5.1 0 0 1 5.1 5.1v8.8a5.1 5.1 0 0 1-5.1 5.1H7.6a5.1 5.1 0 0 1-5.1-5.1V7.6a5.1 5.1 0 0 1 5.1-5.1Zm0 2.2a2.9 2.9 0 0 0-2.9 2.9v8.8a2.9 2.9 0 0 0 2.9 2.9h8.8a2.9 2.9 0 0 0 2.9-2.9V7.6a2.9 2.9 0 0 0-2.9-2.9H7.6ZM12 7.3a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4Zm0 2.2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm5.1-3.4a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"/>
  `,
  twitter: `
    <path d="M17.8 3h3.3l-7.3 8.3L22.4 21h-6.7l-5.2-6.4L4.5 21H1.2l7.8-8.9L.8 3h6.9l4.7 5.9L17.8 3Zm-1.2 16.1h1.8L6.7 4.8H4.8l11.8 14.3Z"/>
  `,
  facebook: `
    <path d="M13.6 21.5v-7.4h2.6l.4-3h-3V9.2c0-.9.3-1.5 1.5-1.5h1.6V5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.6v7.4h3Z"/>
  `,
  // LINE の公式マークの形。横長の吹き出し（左下にしっぽ）に「LINE」の文字をくり抜いてある（evenodd）。
  // 色は他のアイコンと同じく周りの文字から継ぐ（フッターでは白、リンク集では赤）。
  line: `
    <path fill-rule="evenodd" d="M12 2.5C6.2 2.5 1.5 6.3 1.5 11c0 4.2 3.7 7.7 8.8 8.4.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1.1.9.6 1.2-.5 6.3-3.7 8.6-6.4 1.6-1.7 2.4-3.5 2.4-5.4C22.5 6.3 17.8 2.5 12 2.5ZM4.6 8.3h1.4v4.1h2.6v1.3H4.6V8.3Zm4.8 0h1.4v5.4H9.4V8.3Zm2.3 0h1.4l2.2 3.3V8.3h1.3v5.4h-1.3l-2.3-3.4v3.4h-1.3V8.3Zm4.8 0h3.1v1.3h-1.8v.8h1.8v1.2h-1.8v.8h1.8v1.3h-3.1V8.3Z"/>
  `,
};
---

<svg
  class:list={['ico', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
