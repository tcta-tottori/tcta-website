---
// 大会当日の「結果速報」の欄（大会ページのいちばん上）。
// 大会運営システム（tournament/）の観戦ページへ案内する。運営の端末でスコアを入れると、観戦ページのドロー表・リーグ表に数秒で入る。
// 観戦ページは HP 掲載用の固定の部屋（TCTA01。tournament/src/features/sync/syncStore.ts の PUBLIC_ROOM）を見る。
// 運営の端末はこの部屋で同期しておく（設定 → 端末どうしの同期）。
//
// 出すのは、開催中（開催日の 9:00〜18:00。schedule.js の liveStatus）と、開催日のうちの終わったあと。
// 翌日からは、結果表・成績（いつもの結果の欄）に任せて出さない。
import { todayJST } from '../data/schedule.js';
import { LIVE_DRAW_URL, LIVE_ORDER_URL } from '../data/live.js';
import { NO_LIVE } from '../data/official-extra.js';

const { e } = Astro.props;
// 結果を掲載したら（結果の欄に何かあれば）、開催日のうちでも出さない（速報を終えたあと）
const hasResult = (e.sections ?? []).some((s) => s.key === 'result' && ((s.images?.length ?? 0) + (s.pdfs?.length ?? 0) > 0));
// 結果の欄に観戦ページの案内を出す大会（EXTRA_RESULT_NOTES の live）は、ここでは出さない（二重になるため）
// 速報を取りやめた大会（official-extra.js の NO_LIVE）は出さない
const show = !NO_LIVE.includes(e.slug) && !e.resultNote?.live && (e.status === 'live' || (e.date === todayJST() && e.status === 'done' && !hasResult));
---

{show && (
  <section class="live-box rv" id="live" aria-labelledby="live-title">
    <div class="live-box__head">
      <span class="live-box__dot" aria-hidden="true"></span>
      <h2 class="live-box__title" id="live-title">結果速報</h2>
      <span class="live-box__en">LIVE RESULTS</span>
    </div>
    <p class="live-box__lead">
      試合の結果は、決まりしだい観戦ページのドロー表に入ります（数秒で反映）。
      すべての試合が終わったあと、このページに結果表と入賞者を掲載します。
    </p>
    <div class="live-box__btns">
      <a class="btn btn--primary" href={LIVE_DRAW_URL} target="_blank" rel="noopener">ドロー・結果速報を見る <span class="ln-arrow" aria-hidden="true"></span></a>
      <a class="btn btn--outline" href={LIVE_ORDER_URL} target="_blank" rel="noopener">対戦順・進み具合 <span class="ln-arrow" aria-hidden="true"></span></a>
    </div>
  </section>
)}
