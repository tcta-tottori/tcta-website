---
// 大会1件の「要項」「ドロー」「結果」それぞれの独立したページの土台。
// 見出し（■ ENGLISH ／ 日本語）、パンくず、期日・会場、訂正のお知らせ、本文（slot）、大会ページへの戻り、の順。
import Base from '../layouts/Base.astro';
import EventMeta from './EventMeta.astro';
import RevisionNotice from './RevisionNotice.astro';

// revisionKeys … 本文の上に出す訂正の種類（['draw'] など。RevisionNotice.astro）
const { e, label, en, ghost = en.toUpperCase(), revisionKeys = [] } = Astro.props;
const title = `${e.displayName} ${label}｜大会情報｜鳥取市テニス協会`;
const description = `${e.label}に${e.place}で行われる${e.name}（${e.event}）の${label}です。`;
---

<Base title={title} description={description} navActive="tournaments" mobileNavActive="tournaments">
  <section class="page-head">
    <span class="ghost" aria-hidden="true">{ghost}</span>
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="index.html">ホーム</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <a href="tournaments.html">大会情報</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <a href={e.url}>{e.displayName}</a><span class="breadcrumb__sep" aria-hidden="true">›</span>
        <span aria-current="page">{label}</span>
      </nav>
      <div class="page-title-row fu">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <div>
          <p class="page-title__en">{en}</p>
          <h1 class="page-title">{e.name}　{label}</h1>
        </div>
      </div>
      {/* 受付状態のバッジと、日程・会場・種目（大会情報の一覧と同じ形。ピクトグラムは無し） */}
      <p class="page-lead page-lead--tags fu" style="animation-delay:.15s">
        <span class={`badge ${e.badge.badge}`}>{e.badge.label}</span>
      </p>
      <div class="fu" style="animation-delay:.2s"><EventMeta e={e} /></div>
    </div>
  </section>

  <section class="section">
    <div class="container container--result">
      <RevisionNotice revisions={e.revisions} keys={revisionKeys} />
      <slot />
      <nav class="page-nav rv" aria-label="大会のページへ">
        <a class="page-nav__link" href={e.url}><span class="page-nav__dir">← 大会のページ</span><span class="page-nav__title">{e.displayName}</span></a>
        <a class="ghost-link" href="tournaments.html">大会一覧へ</a>
        <span></span>
      </nav>
    </div>
  </section>
</Base>
