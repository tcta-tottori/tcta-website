---
// 令和8年度の大会を、月ごとのカレンダーで見せる。
// 大会のある月だけを並べ、開催日のマスを赤くする。マスの下にその月の大会を出すので、
// 「いつ・何があるか」がカレンダーを見たまま分かる。
import { SCHEDULE, STATUS_LABEL, byMonth, monthGrid } from '../data/schedule.js';

const DOW = ['日', '月', '火', '水', '木', '金', '土'];
const months = byMonth(SCHEDULE).map((m) => ({ ...m, ...monthGrid(m) }));
---

<div class="cal">
  {months.map((m) => (
    <section class="cal__month rv" aria-label={`${m.year}年${m.month}月の大会`}>
      <header class="cal__head">
        <span class="cal__num">{String(m.month).padStart(2, '0')}</span>
        <span class="cal__meta">
          <span class="cal__en">{m.en}</span>
          <span class="cal__year">{m.year}</span>
        </span>
        <span class="cal__count">{m.items.length}大会</span>
      </header>

      <div class="cal__grid" role="presentation">
        {DOW.map((d, i) => (
          <span class:list={['cal__dow', i === 0 && 'is-sun', i === 6 && 'is-sat']}>{d}</span>
        ))}
        {m.cells.map((c) => (
          c === null
            ? <span class="cal__cell cal__cell--empty"></span>
            : <span
                class:list={[
                  'cal__cell',
                  c.items.length && 'is-on',
                  c.dow === 0 && 'is-sun',
                  c.dow === 6 && 'is-sat',
                ]}
                title={c.items.length ? c.items.map((t) => t.name).join(' / ') : undefined}
              >{c.day}</span>
        ))}
      </div>

      <ul class="cal__list">
        {m.items.map((t) => (
          <li class="cal__item">
            <span class="cal__item-day">{String(Number(t.date.slice(8))).padStart(2, '0')}</span>
            <span class="cal__item-body">
              <span class="cal__item-name">{t.name}</span>
              <span class="cal__item-sub">{t.event}</span>
            </span>
            <span class={`badge ${STATUS_LABEL[t.status].badge} cal__item-badge`}>{STATUS_LABEL[t.status].label}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
