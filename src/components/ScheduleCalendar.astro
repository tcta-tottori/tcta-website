---
// 令和8年度の大会を、月ごとのカレンダーで見せる。開催日のほかに、エントリー締切とドロー会議の日も載せる。
//   開催日 … 赤いマス
//   締切 … 黒い点（申込締切の日。schedule.js の dueDate）
//   ドロー会議 … 赤い枠の点（締切の週の土曜 18:00 から、テニスショップ フラシーノ。drawMeetingDate）
// 同じ日に締切やドロー会議が重なる大会は、1件にまとめて大会名を並べる。
// 出すのは1か月ぶんだけ。前後のボタンで月を移す（main.js の initCalendar）。
// 全月ぶんのマス目は最初から書き出しておき、表示の切り替えだけをJSが行うので、
// JSが動かない環境でも先頭の月は読める。
//
// extras を付けると（トップページ）、大会のほかに次のものも載せる。
//   イベント … 管理画面の「イベント情報」のうち、開催日の入ったもの（テニス祭りなど）。黒いマス
//   水曜テニス … 水曜テニス教室（毎週水曜 18:00〜21:00・井原公園）。水曜のマスに緑の点。マスの下の一覧には月の頭に1行だけ
import { siteData } from '../lib/cms.js';
import { STATUS_LABEL, monthGrid, todayJST, dueDate, drawMeetingDate, DRAW_MEETING } from '../data/schedule.js';

interface Props {
  /** テニスイベントと水曜テニスも載せる（トップページ） */
  extras?: boolean;
}
const { extras = false } = Astro.props;
const { SCHEDULE: MAIN, ROWS = [], EVENT_INFO = [], eventForSchedule } = await siteData(Astro);
// extras（トップ）は、協会主催の大会に加えて、同じ年度の預かりの大会（鳥大オープンなど）も載せる。
// 預かりの大会には協会のドロー会議は付けない（締切は付ける）
const nendo = MAIN[0]?.nendo;
const SCHEDULE = extras
  ? [...MAIN, ...ROWS.filter((t) => t.kind === 'extra' && t.nendo === nendo)].sort((a, b) => a.date.localeCompare(b.date))
  : MAIN;
// 大会の行き先：大会のページ（要項・ドロー・結果がまとまっている）。ページの無い大会は外のページ（市民体育祭など）
const goOf = (t) => {
  const e = eventForSchedule?.(t);
  if (e) return { href: e.url, ext: false };
  if (t.externalUrl) return { href: t.externalUrl, ext: true };
  return null;
};
const extAttrs = (g) => (g?.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {});

// 水曜テニス教室（lesson.html の開催概要と同じ）
const LESSON = { name: '水曜テニス教室', when: '毎週水曜 18:00〜21:00', place: '井原公園テニスコート', href: 'lesson.html' };
// 水曜テニス教室を開く期間（この範囲の水曜にだけ印を付ける）。年度ごとに決まったら足す。
// 令和8年度は 4月下旬〜10月で終了（開始日は lesson.html の「4月下旬〜」から 4/22 とした）。令和9年度はまだ決まっていないので入れない
const LESSON_PERIODS = [
  { from: '2026-04-22', to: '2026-10-31' },
];
const isLessonDay = (iso) => LESSON_PERIODS.some((p) => iso >= p.from && iso <= p.to);
// イベント（開催日のあるもの）を日付ごとに
const events = new Map();
if (extras) {
  for (const e of EVENT_INFO) {
    if (!e.date || !/^\d{4}-\d{2}-\d{2}$/.test(e.date)) continue;
    if (!events.has(e.date)) events.set(e.date, []);
    events.get(e.date).push(e);
  }
}

const DOW = ['日', '月', '火', '水', '木', '金', '土'];

// 締切・ドロー会議を日付ごとにまとめる（日付 → 大会の一覧）
const dues = new Map();
const draws = new Map();
const push = (map, iso, t) => { if (!map.has(iso)) map.set(iso, []); map.get(iso).push(t); };
for (const t of SCHEDULE) {
  const due = dueDate(t.due, t.date);
  if (!due) continue;
  push(dues, due, t);
  const draw = t.kind === 'main' ? drawMeetingDate(due, t.date) : null;
  if (draw) push(draws, draw, t);
}

// 月は、大会・締切・ドロー会議のどれかがある月をすべて並べる
// extras（トップ）のときは、さかのぼれるのは先月まで（それより前の月は出さない）。
// 描いたページが残っていても合うよう、main.js の initCalendar も見た時点の日付で先月より前の月を外す（data-cal-from）
const prevMonthKey = (iso) => {
  const [y, m] = iso.slice(0, 7).split('-').map(Number);
  return m === 1 ? `${y - 1}-12` : `${y}-${String(m - 1).padStart(2, '0')}`;
};
const fromKey = extras ? prevMonthKey(todayJST()) : '';
const keys = [...new Set([...SCHEDULE.map((t) => t.date), ...dues.keys(), ...draws.keys(), ...events.keys()].map((iso) => iso.slice(0, 7)))]
  .filter((k) => k >= fromKey)
  .sort();
const months = keys.map((key) => {
  const [year, month] = key.split('-').map(Number);
  const games = SCHEDULE.filter((t) => t.date.startsWith(key)).sort((a, b) => a.date.localeCompare(b.date));
  const grid = monthGrid({ year, month, items: games });
  const cells = grid.cells.map((c) => c && {
    ...c,
    dues: dues.get(c.iso) ?? [],
    draws: draws.get(c.iso) ?? [],
    events: events.get(c.iso) ?? [],
    lesson: extras && c.dow === 3 && isLessonDay(c.iso),
  });
  // マスの下の一覧。日付順で、同じ日はドロー会議 → 締切 → イベント → 大会の順。水曜テニスは月の頭に1行だけ
  const evs = [...events].filter(([iso]) => iso.startsWith(key));
  const entries = [
    ...(cells.some((c) => c && c.lesson) ? [{ iso: '', kind: 'lesson', order: 0 }] : []),
    ...[...draws].filter(([iso]) => iso.startsWith(key)).map(([iso, list]) => ({ iso, kind: 'draw', order: 0, list })),
    ...[...dues].filter(([iso]) => iso.startsWith(key)).map(([iso, list]) => ({ iso, kind: 'due', order: 1, list })),
    ...evs.flatMap(([iso, list]) => list.map((e) => ({ iso, kind: 'event', order: 2, e }))),
    ...games.map((t) => ({ iso: t.date, kind: 'game', order: 3, t })),
  ].sort((a, b) => a.iso.localeCompare(b.iso) || a.order - b.order);
  const evCount = evs.reduce((n, [, list]) => n + list.length, 0);
  return { key, year, month, en: grid.en, cells, entries, count: games.length, evCount };
});
// 最初に出す月は今月（日本時間）。今月に何も無ければその次の月、年度の最後より後なら最後の月。
// 今日のマス（.is-today）は点滅させる。描いたページが残っていても合うよう、main.js の initCalendar が見た時点の日付で付け直す
const today = todayJST();
const start = months.findIndex((m) => m.key >= today.slice(0, 7));
const initial = start < 0 ? months.length - 1 : start;
// 大会がまだ 1 件も無いとき（配備直後など）は、カレンダーを出さずに一言だけ出す
const first = months[initial];

const names = (list) => list.map((t) => t.name).join('・');
const day = (iso) => String(Number(iso.slice(8))).padStart(2, '0');
// マスに載せる説明（マウスを載せたときの小さな吹き出し）
const cellTitle = (c) => [
  ...c.items.map((t) => t.name),
  ...c.events.map((e) => e.title),
  ...(c.lesson ? [`${LESSON.name}（${LESSON.when.replace('毎週水曜 ', '')}）`] : []),
  ...(c.dues.length ? [`締切：${names(c.dues)}`] : []),
  ...(c.draws.length ? [`ドロー会議 ${DRAW_MEETING.time}〜：${names(c.draws)}`] : []),
].join(' / ') || undefined;
const countText = (m) => (m.evCount ? `${m.count}大会・${m.evCount}イベント` : `${m.count}大会`);
---

{!first && <p class="note">大会が登録されるとカレンダーが表示されます。</p>}
{first && (

<div class="cal" data-calendar data-cal-initial={initial} data-cal-from={extras ? 'prev' : undefined}>
  <div class="cal__bar">
    <button class="circle-btn" type="button" data-cal-prev aria-label="前の月へ" disabled>←</button>
    <p class="cal__label" data-cal-label aria-live="polite">
      <span class="cal__num">{String(first.month).padStart(2, '0')}</span>
      <span class="cal__meta">
        <span class="cal__en">{first.en}</span>
        <span class="cal__year">{first.year}</span>
      </span>
    </p>
    <button class="circle-btn circle-btn--solid" type="button" data-cal-next aria-label="次の月へ">→</button>
    <span class="cal__count" data-cal-count>{countText(first)}</span>
  </div>

  {/* 凡例 */}
  <ul class="cal__legend">
    <li><span class="cal__key cal__key--game" aria-hidden="true"></span>大会</li>
    {extras && <li><span class="cal__key cal__key--event" aria-hidden="true"></span>イベント</li>}
    {extras && <li><span class="cal__mk cal__mk--lesson" aria-hidden="true"></span>水曜テニス</li>}
    <li><span class="cal__mk cal__mk--due" aria-hidden="true"></span>エントリー締切</li>
    <li><span class="cal__mk cal__mk--draw" aria-hidden="true"></span>ドロー会議（{DRAW_MEETING.time}〜 {DRAW_MEETING.place}）</li>
  </ul>

  {months.map((m, i) => (
    <section
      class="cal__month"
      data-cal-month={i}
      data-key={m.key}
      data-month={String(m.month).padStart(2, '0')}
      data-en={m.en}
      data-year={m.year}
      data-count={countText(m)}
      aria-label={`${m.year}年${m.month}月の大会`}
      hidden={i !== initial}
    >
      <div class="cal__grid" role="presentation">
        {DOW.map((d, j) => (
          <span class:list={['cal__dow', j === 0 && 'is-sun', j === 6 && 'is-sat']}>{d}</span>
        ))}
        {m.cells.map((c) => (
          c === null
            ? <span class="cal__cell cal__cell--empty"></span>
            : <span
                class:list={[
                  'cal__cell',
                  c.items.length && 'is-on',
                  !c.items.length && c.events.length && 'is-ev',
                  c.dow === 0 && 'is-sun',
                  c.dow === 6 && 'is-sat',
                  c.iso === today && 'is-today',
                ]}
                data-date={c.iso}
                data-has={(c.items.length || c.events.length || c.dues.length || c.draws.length || c.lesson) ? '' : undefined}
                data-lesson={c.lesson ? '' : undefined}
                title={cellTitle(c)}
                aria-current={c.iso === today ? 'date' : undefined}
              >
                {c.day}
                {(c.dues.length > 0 || c.draws.length > 0 || c.lesson || (c.items.length > 0 && c.events.length > 0)) && (
                  <span class="cal__mks" aria-hidden="true">
                    {c.dues.length > 0 && <span class="cal__mk cal__mk--due"></span>}
                    {c.draws.length > 0 && <span class="cal__mk cal__mk--draw"></span>}
                    {c.items.length > 0 && c.events.length > 0 && <span class="cal__mk cal__mk--event"></span>}
                    {c.lesson && <span class="cal__mk cal__mk--lesson"></span>}
                  </span>
                )}
              </span>
        ))}
      </div>

      {/* 一覧の行は押すとその大会・イベントのページへ（行全体が押せる：.cal__item-link--go の ::after を行に広げる）。
          締切・ドロー会議で大会が2つ以上のときは、大会名ごとに押せる。data-date はマスを押したときの吹き出し（main.js）が使う */}
      <ul class="cal__list">
        {m.entries.map((x) => {
          if (x.kind === 'lesson') return (
            <li class="cal__item cal__item--lesson cal__item--go" data-lesson>
              <span class="cal__item-day cal__item-day--wk">毎週<br>水</span>
              <span class="cal__item-body">
                <span class="cal__item-name"><span class="cal__tag cal__tag--lesson">水曜テニス</span><a class="cal__item-link cal__item-link--go" href={LESSON.href}>{LESSON.name}</a></span>
                <span class="cal__item-sub">{LESSON.when.replace('毎週水曜 ', '')}／{LESSON.place}</span>
              </span>
              <span class="cal__item-arrow" aria-hidden="true">›</span>
            </li>
          );
          if (x.kind === 'event') return (
            <li class:list={['cal__item cal__item--event', x.e.href && 'cal__item--go']} data-date={x.iso}>
              <span class="cal__item-day">{day(x.iso)}</span>
              <span class="cal__item-body">
                <span class="cal__item-name"><span class="cal__tag cal__tag--event">イベント</span>{x.e.href ? <a class="cal__item-link cal__item-link--go" href={x.e.href}>{x.e.title}</a> : x.e.title}</span>
                {x.e.place && <span class="cal__item-sub">{x.e.place}</span>}
              </span>
              {x.e.href && <span class="cal__item-arrow" aria-hidden="true">›</span>}
            </li>
          );
          if (x.kind === 'game') {
            const g = goOf(x.t);
            return (
              <li class:list={['cal__item', g && 'cal__item--go']} data-date={x.iso}>
                <span class="cal__item-day">{day(x.iso)}</span>
                <span class="cal__item-body">
                  <span class="cal__item-name">{g ? <a class="cal__item-link cal__item-link--go" href={g.href} {...extAttrs(g)}>{x.t.name}</a> : x.t.name}</span>
                  <span class="cal__item-sub">{x.t.event}／{x.t.place}</span>
                </span>
                <span class={`badge ${STATUS_LABEL[x.t.status].badge} cal__item-badge`}>{STATUS_LABEL[x.t.status].label}</span>
                {g && <span class="cal__item-arrow" aria-hidden="true">›</span>}
              </li>
            );
          }
          // 締切・ドロー会議。大会が1つなら行全体、2つ以上なら大会名ごとに押せる
          const gos = x.list.map((t) => ({ t, g: goOf(t) }));
          const one = gos.length === 1 && gos[0].g;
          return (
            <li class:list={[`cal__item cal__item--${x.kind}`, one && 'cal__item--go']} data-date={x.iso}>
              <span class="cal__item-day">{day(x.iso)}</span>
              <span class="cal__item-body">
                <span class="cal__item-name">
                  <span class={`cal__tag cal__tag--${x.kind}`}>{x.kind === 'due' ? 'エントリー締切' : 'ドロー会議'}</span>
                  {x.kind === 'draw' && <span class="cal__item-when">{DRAW_MEETING.time}〜　{DRAW_MEETING.short}</span>}
                </span>
                <span class="cal__item-sub">
                  {gos.map(({ t, g }, k) => (
                    <>{k > 0 && '・'}{g ? <a class:list={['cal__item-link', one && 'cal__item-link--go']} href={g.href} {...extAttrs(g)}>{t.name}</a> : t.name}</>
                  ))}
                </span>
              </span>
              {one && <span class="cal__item-arrow" aria-hidden="true">›</span>}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>
)}
