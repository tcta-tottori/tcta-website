---
import { NAV } from '../config/nav.js';

interface Props {
  /** 現在地として強調するナビの key */
  active?: string;
  /** トップページではコート案内・お知らせがページ内アンカーになる */
  onHome?: boolean;
}

const { active, onHome = false } = Astro.props;

/** トップページでは index.html#courts → #courts に落とす */
const resolve = (href: string) =>
  onHome && href.startsWith('index.html#') ? href.slice('index.html'.length) : href;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="index.html" aria-label="鳥取市テニス協会 ホーム">
      {/* 白地を抜いた透過のロゴ（logo-cut.png。元は logo.png）。スマホではヘッダーの帯を出さず、ロゴとメニューのボタンだけを浮かせて固定する。
          logo-cut-white.png は同じロゴの白抜き（赤い四角はそのまま）。スマホのメニュー（黒地）を開いているあいだだけ重ねて出す。
          スマホでは、文字の部分（logo-cut-ink.png の形）を「裏の色を白黒に分けて反転した色」で塗る（.site-header__logo-ink）。
          白っぽい地の上では黒、赤・黒の地や黒い文字と重なったところだけ白になる。赤い四角（logo-cut-red.png）はそのまま上に重ねる */}
      <img class="site-header__logo-img" src="assets/img/logo-cut.png" alt="鳥取市テニス協会 TOTTORI-CITY TENNIS ASSOCIATION" width="679" height="217">
      <span class="site-header__logo-ink" aria-hidden="true"></span>
      <img class="site-header__logo-red" src="assets/img/logo-cut-red.png" alt="" width="679" height="217">
      <img class="site-header__logo-w" src="assets/img/logo-cut-white.png" alt="" width="679" height="217">
    </a>
    <nav class="nav" aria-label="グローバルナビゲーション">
      {NAV.map((item) => (
        <a
          class:list={['nav__link', item.en && 'nav__link--en', active === item.key && 'is-active']}
          href={resolve(item.href)}
        >{item.label}</a>
      ))}
    </nav>
    <a class="header-contact" href="contact.html">お問い合わせ</a>
    <button class="hamburger" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
      <span class="visually-hidden">メニューを開く</span>
    </button>
  </div>
</header>
