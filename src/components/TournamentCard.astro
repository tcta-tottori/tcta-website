---
// 大会カード1枚。src/data/tournaments.js の buildCards が組んだ1件をそのまま受け取る。
// 上に種目のピクトグラム（src/data/event-icons.js。種目の文言から選ぶ）、
// 下に 日程チップ＋大会名、種目・会場、いちばん下に大会の進み具合に応じた案内。
// 写真は使わない（種目が一目で分かるようにするため。管理画面の「カードの写真」は無視される）。
import Icon from './Icon.astro';
import { STATUS, dateChip } from '../data/tournaments.js';
import { eventIcons, ICON_SIZE } from '../data/event-icons.js';

const { tournament } = Astro.props;
const { date, title, event, venue, status, action } = tournament;
const badge = STATUS[status];
const chip = dateChip(date);
const icons = eventIcons(event);

// 遷移先が未定（結果待ちなど）のときはリンクにせず、案内だけ出す。
const Tag = action.href ? 'a' : 'div';
---

<Tag
  class:list={['tcard', `tcard--${status}`, !action.href && 'tcard--nolink']}
  {...(action.href ? { href: action.href } : {})}
>
  <div class="tcard__media" aria-hidden="true">
    {icons.length > 0
      ? <span class="tcard__icons" data-n={icons.length}>
          {icons.map((ic) => <img class="tcard__icon" src={ic.src} alt="" width={ICON_SIZE} height={ICON_SIZE} loading="lazy" decoding="async">)}
        </span>
      : <span class="tcard__icons tcard__icons--empty"><Icon name="list" class="tcard__icon-fallback" /></span>}
  </div>

  <div class="tcard__body">
    <div class="tcard__head">
      <span class="date-chip date-chip--card">
        <span class="date-chip__md">{chip.md}</span>
        <span class="date-chip__dow">{chip.dow}</span>
      </span>
      <h3 class="tcard__title">{title}</h3>
    </div>

    <div class="tcard__foot">
      <p class="tcard__event"><Icon name="list" class="tcard__ico" />{event}</p>
      <p class="tcard__venue"><Icon name="pin" class="tcard__ico" />{venue}</p>
      <div class="tcard__action">
        <span class={`badge ${badge.badge}`}>{badge.label}</span>
        <span class="tcard__go">{action.label}{action.href && <span class="aw">→</span>}</span>
      </div>
    </div>
  </div>
</Tag>
