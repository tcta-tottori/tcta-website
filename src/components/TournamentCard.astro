---
// 大会カード1枚。src/data/tournaments.js の buildCards が組んだ1件をそのまま受け取る。
// 日程チップ＋大会名、次の段に種目・会場（短い表記で1行ずつ、上揃えで折り返さない）、
// 種目のピクトグラム（src/data/event-icons.js。種目の文言から選ぶ）は文字の下のレイヤーに右下寄せで置く（重なってもよい）、
// いちばん下に状態のバッジ（受付中なら横に申込締切）と大会の進み具合に応じた案内、の順。カードの高さは固定（CSS）。
// 写真は使わない（種目が一目で分かるようにするため。管理画面の「カードの写真」は無視される）。
import Icon from './Icon.astro';
import { STATUS, dateChip, shortEvent } from '../data/tournaments.js';
import EventIcon from './EventIcon.astro';
import { eventIcons } from '../data/event-icons.js';

const { tournament } = Astro.props;
const { date, title, event, venue, status, due, action } = tournament;
const badge = STATUS[status];
const chip = dateChip(date);
const icons = eventIcons(event);
// 種目は短い表記で1行に。長いときは文字を少し小さくし、ピクトグラムは文字の下の行に下がる（CSS）
const eventLabel = shortEvent(event);
const len = eventLabel.length > 10 ? 'long' : 'short';

// 遷移先が未定（結果待ちなど）のときはリンクにせず、案内だけ出す。
const Tag = action.href ? 'a' : 'div';
---

<Tag
  class:list={['tcard', `tcard--${status}`, !action.href && 'tcard--nolink']}
  {...(action.href ? { href: action.href } : {})}
>
  <div class="tcard__body">
    <div class="tcard__head">
      <span class="date-chip date-chip--card">
        <span class="date-chip__md">{chip.md}</span>
        <span class="date-chip__dow">{chip.dow}</span>
      </span>
      <h3 class="tcard__title">{title}</h3>
    </div>

    <div class="tcard__foot">
      {/* 左に種目・会場の文字、右に種目のピクトグラム（同じ段に並べる） */}
      <div class="tcard__info" data-len={len}>
        <div class="tcard__text">
          <p class="tcard__event"><Icon name="list" class="tcard__ico" /><span class="tcard__line">{eventLabel}</span></p>
          <p class="tcard__venue"><Icon name="pin" class="tcard__ico" /><span class="tcard__line">{venue}</span></p>
        </div>
        {icons.length > 0 && (
          <span class="tcard__icons" data-n={icons.length} aria-hidden="true">
            {icons.map((ic) => <EventIcon icon={ic} class="tcard__icon" />)}
          </span>
        )}
      </div>
      <div class="tcard__action">
        {/* 受付中は、バッジの横に申込締切 */}
        <span class="tcard__status">
          <span class={`badge ${badge.badge}`}>{badge.label}</span>
          {status === 'open' && due && <span class="tcard__due"><small>締切</small>{due}</span>}
        </span>
        <span class="tcard__go">{action.label}{action.href && <span class="aw">→</span>}</span>
      </div>
    </div>
  </div>
</Tag>
