---
// 大会カード1枚。src/data/tournaments.js の1件をそのまま受け取る。
// 写真の上に文字を重ねる構成：
//   左上に日程チップ（上に日付・下に曜日）、その横に大会名、
//   下に種目・会場、いちばん下に大会の進み具合に応じた案内。
import { STATUS, dateChip, cardAction } from '../data/tournaments.js';

const { tournament } = Astro.props;
const { date, title, event, venue, status, image, imageAlt } = tournament;
const badge = STATUS[status];
const chip = dateChip(date);
const action = cardAction(tournament);

// 遷移先が未定（結果待ちなど）のときはリンクにせず、案内だけ出す。
const Tag = action.href ? 'a' : 'div';
---

<Tag
  class:list={['tcard', status === 'past' && 'tcard--past', !action.href && 'tcard--nolink']}
  {...(action.href ? { href: action.href } : {})}
>
  <div class="tcard__media">
    {image
      ? <img src={image} alt={imageAlt ?? ''} loading="lazy">
      : <span class="tcard__media-empty" aria-hidden="true"></span>}
    <span class="tcard__scrim" aria-hidden="true"></span>
  </div>

  <div class="tcard__head">
    <span class="date-chip date-chip--on-photo">
      <span class="date-chip__md">{chip.md}</span>
      <span class="date-chip__dow">{chip.dow}</span>
    </span>
    <h3 class="tcard__title">{title}</h3>
  </div>

  <div class="tcard__foot">
    <p class="tcard__event">{event}</p>
    <p class="tcard__venue">{venue}</p>
    <div class="tcard__action">
      <span class={`badge ${badge.badge}`}>{badge.label}</span>
      <span class="tcard__go">{action.label}{action.href && <span class="aw">→</span>}</span>
    </div>
  </div>
</Tag>
