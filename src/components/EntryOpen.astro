---
// トップ「大会情報」の見出しの直下に出す「エントリー受付中」の帯。
// 旧サイトはトップを開くとすぐ「大会エントリー受付中／○/○締切」が見えていた（docs/content.md §1.3）。
// いまのトップはカードのバッジを横に送って探すか VIEW ALL を開かないと分からなかったので、
// 受付中の大会だけをここに抜き出し、1大会1行で締切と並べる。カルーセル・一覧表示・VIEW ALL はそのまま。
//
// 中身はトップの大会カードと同じ（src/data/tournaments.js の buildCards）。状態が「受付中」のものを締切の近い順に。
// 1行：日程チップ ＋ 大会名・種目 ＋ 締切（曜日を添える）＋ 「要項を見る」。行のどこを押しても要項（outline-<slug>.html）へ。
// 要項がまだ無い大会は大会のページ（action.href）へ、それも無ければ押せない行にする。
// 受付中の大会が無いときも帯は消さず、その旨を1行だけ薄く出す（「いまは無い」と分かることも目的のため）。
import { dateChip, shortEvent } from '../data/tournaments.js';
import { dueDate } from '../data/schedule.js';

const { items = [] } = Astro.props;

const DOW_JA = ['日', '月', '火', '水', '木', '金', '土'];

/**
 * 大会名の折り返してよい位置（大会情報ページの一覧 TournamentList.astro と同じ）。
 * 「第56回」「令和8年度」の後ろ、「テニス」「シングルス」などの前、「協会」の後ろ、「（」の前、空白の後ろ。
 * CSS（word-break: keep-all）で文字の途中では折り返さないので、ここで区切った位置（<wbr>）でだけ行が変わる。
 */
const nameParts = (name) =>
  String(name ?? '').split(/(?<=第\d+回)|(?<=年度)|(?<=協会)|(?=（)|(?<=.)(?=テニス|シングルス|ダブルス|ミックス)|(?<=\s)/u).filter(Boolean);
const isoOf = (t) => dueDate(t.due, t.date.replace(/\./g, '-'));

/** 締切の表記。'11/6' → '11/6（金）'。読めない形（「別記」「11/27（金）20:00」など）は管理画面の文言のまま */
function dueLabel(t) {
  const iso = isoOf(t);
  if (!iso) return t.due;
  const [y, m, d] = iso.split('-').map(Number);
  return `${m}/${d}（${DOW_JA[new Date(y, m - 1, d).getDay()]}）`;
}

const rows = items
  .filter((t) => t.status === 'open')
  .map((t) => {
    const outline = (t.buttons ?? []).find((b) => b.key === 'outline' && b.href);
    const href = outline?.href ?? t.action?.href ?? null;
    const external = outline ? !!outline.external : /^https?:/.test(href ?? '');
    return { t, chip: dateChip(t.date), href, external, due: dueLabel(t), event: shortEvent(t.event) };
  })
  // 締切の近い順（読めない締切は後ろ）。同じ締切なら大会の日付順
  .sort((a, b) => (isoOf(a.t) ?? '9999').localeCompare(isoOf(b.t) ?? '9999') || a.t.date.localeCompare(b.t.date));
---

<div class="entry-open rv" role="region" aria-labelledby="entry-open-title">
  <div class="entry-open__head">
    <p class="entry-open__eyebrow">Entry Open</p>
    <h3 class="entry-open__title" id="entry-open-title">
      エントリー受付中の大会{rows.length > 0 && <span class="entry-open__count"><span class="entry-open__num">{rows.length}</span>件</span>}
    </h3>
  </div>

  {rows.length > 0 ? (
    <ul class="entry-open__list">
      {rows.map(({ t, chip, href, external, due, event }) => {
        const Row = href ? 'a' : 'div';
        const attrs = href ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) } : {};
        return (
          <li class="entry-open__item">
            <Row class:list={['entry-open__row', !href && 'entry-open__row--nolink']} {...attrs}>
              <span class="date-chip date-chip--card entry-open__date">
                <span class="date-chip__md">{chip.md}</span>
                <span class="date-chip__dow">{chip.dow}</span>
              </span>
              <span class="entry-open__main">
                <span class="entry-open__name">{nameParts(t.title).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}</span>
                {event && <span class="entry-open__event">{event}</span>}
              </span>
              <span class="entry-open__due">
                <span class="badge badge--open">受付中</span>
                {due && <span class="entry-open__due-date"><small>締切</small>{due}</span>}
              </span>
              {href && <span class="entry-open__go">要項を見る<span class="ln-arrow" aria-hidden="true"></span></span>}
            </Row>
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="entry-open__none">現在エントリーを受け付けている大会はありません。受付が始まると、ここに大会名と締切を出します。</p>
  )}
</div>
