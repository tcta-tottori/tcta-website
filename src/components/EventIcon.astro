---
// 種目のピクトグラム1つ（src/data/event-icons.js の1件）。
// 選手の絵は、画面に入ったとき（.rv に .on が付いたとき）に一度だけスイングし、ボールが飛んでくる。
// 団体戦は6人を1人ずつに切り分け、応援のように順に跳ねる。動きは style.css の .evicon。
// 大きさは外側（.tcard__icons / .tl-item__event-icons）が高さで決める。幅は絵に合わせて自動。
// ボールは絵の中の大きさだと小さすぎて動きが見えないので、1.6 倍にしてある。
import { BALL_SRC } from '../data/event-icons.js';

const { icon, class: cls } = Astro.props;
const ratio = `${icon.w} / ${icon.h}`;
---

<span class:list={['evicon', `evicon--${icon.key}`, cls]} style={`aspect-ratio:${ratio}`} aria-hidden="true">
  {icon.figures
    ? icon.figures.map(([l, r], i) => (
        <img
          class="evicon__fig"
          src={icon.src} alt="" width={icon.w} height={icon.h} loading="lazy" decoding="async"
          style={`--i:${i};clip-path:inset(0 ${(100 - r).toFixed(1)}% 0 ${l}%)`}
        >
      ))
    : (
      <>
        <img class="evicon__player" src={icon.src} alt="" width={icon.w} height={icon.h} loading="lazy" decoding="async">
        {icon.ball && (
          <img
            class="evicon__ball"
            src={BALL_SRC} alt="" width="40" height="40" loading="lazy" decoding="async"
            style={`left:${icon.ball[0]}%;top:${icon.ball[1]}%;height:${(icon.ball[2] * 1.6).toFixed(1)}%`}
          >
        )}
      </>
    )}
</span>
