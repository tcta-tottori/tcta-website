---
// 申込用紙のボタン（要項のページ・大会ページの「申込用紙」）。形はサイトの PDF 共通のボタン（PdfButton.astro）。
// 1つのPDF（または紙面の画像）につき1つ。「大会名 申込用紙」と、その下に中身の名前と大きさを出す。
// 押すと別タブではなく、このページの中で全画面に開く（main.js の initPdfViewer。ダウンロード・印刷のボタン付き）。
// JS が動かない環境では、ふつうのリンクとして PDF そのものを開く。
// section: 申込用紙の { images, pdfs }（events.js。領収証つきの紙は entry-forms.js でここへ集めてある）
import PdfButton from './PdfButton.astro';
const { e, section } = Astro.props;
const forms = [
  ...(section?.pdfs ?? []).map((p) => ({ type: 'pdf', src: p.src, label: p.label, note: `PDF・${p.kb.toLocaleString()}KB` })),
  ...(section?.images ?? []).map((img) => ({ type: 'image', src: img.src, label: img.label ?? '', note: '画像' })),
];
const title = `${e.name} 申込用紙`;
// 中身の名前は、「申込用紙」だけ（見出しと同じ）なら出さない
const showLabel = (f) => !!f.label && f.label !== '申込用紙';
// ダウンロードしたときのファイル名（大会名＋申込用紙。2つ以上あるときは中身の名前も添える）。
const ext = (src) => (String(src).match(/\.([a-z0-9]+)(?:[?#].*)?$/i)?.[1] ?? 'pdf').toLowerCase();
// 中身の名前に「申込用紙」が入っているときは、大会名にそのまま続ける（「申込用紙_申込用紙…」と重ねない）
const fileName = (f) => {
  const tail = forms.length > 1 && f.label ? (f.label.includes('申込用紙') ? f.label : `申込用紙_${f.label}`) : '申込用紙';
  return `${e.name}_${tail}.${ext(f.src)}`.replace(/[\\/:*?"<>|\s]+/g, '_');
};
---

{forms.length > 0 && (
  <ul class="pdfbtns">
    {forms.map((f) => (
      <li>
        <PdfButton
          href={f.src}
          type={f.type}
          title={e.name}
          kind="申込用紙"
          note={`${showLabel(f) ? `${f.label}／` : ''}${f.note}`}
          viewTitle={title}
          sub={showLabel(f) ? f.label : ''}
          filename={fileName(f)}
        />
      </li>
    ))}
  </ul>
)}
