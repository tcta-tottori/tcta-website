---
import { MOBILE_NAV } from '../config/nav.js';
import DecoSquares from './DecoSquares.astro';
import SnsLinks from './SnsLinks.astro';

interface Props {
  /** 現在地として強調するナビの key */
  active?: string;
}

const { active } = Astro.props;

/** お問い合わせも同じ行として並べる（フッターと同じく、矢印やボタンは付けない） */
const ITEMS = [...MOBILE_NAV, { key: 'contact', label: 'お問い合わせ', href: 'contact.html' }];
---

<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  {/* フッターと同じ黒地＋漂う四角。開くときは黒地が画面の下からせり上がり、覆い終わってから
      各行の文字がそれぞれの下線（見えない線）の下から出てくる（style.css の .mobile-nav）。
      --i が上から何番目か（2列なので左→右、上→下の順）。文字の出る遅れはこの値から CSS が計算する。 */}
  <DecoSquares class="mobile-nav__deco" />
  <nav class="mobile-nav__grid" aria-label="モバイルナビゲーション">
    {ITEMS.map((item, i) => (
      <a
        class:list={['mobile-nav__link', active === item.key && 'is-active']}
        href={item.href}
        style={`--i:${i}`}
      ><span class="mobile-nav__tx"><span>{item.label}</span></span></a>
    ))}
  </nav>
  {/* 下端に寄せる：SNS と著作権の表記（フッターと同じ） */}
  <div class="mobile-nav__foot">
    <div class="mobile-nav__sns" style={`--i:${ITEMS.length}`}><SnsLinks /></div>
    {/* 著作権の表記の上に、キャッチコピー（トップのヒーローと同じ書体） */}
    <p class="mobile-nav__copy mobile-nav__tagline" style={`--i:${ITEMS.length + 1}`}><span class="tagline">PLAY BEYOND.</span></p>
    <p class="mobile-nav__copy" style={`--i:${ITEMS.length + 2}`}><span>© Tottori-City Tennis Association All Rights Reserved.</span></p>
  </div>
</div>
