---
// 大会一覧。src/lib/cms.js の SCHEDULE（schedule.js の形）をそのまま受け取る。
// 表示は2通り。大会情報ページの切り替えボタンで選ぶ（main.js の initViewSwitch。選んだ方を覚えておく）。
//
// ■ 縮小表示（初め。.tl--rows のとき .tlx を出す）
//   1大会1行の表。左端の「大会名」の列だけを固定し、右へ横スクロールすると
//   日程・状態・登録区分・種目・会場・締切・予備日・要項／申込用紙／ドロー／結果・備考 が順に見える。
//   項目名の行（.tlx__head）は下へスクロールしても画面の上端についてくる（横スクロールは本体と連動。main.js の initTlx）。
//   大会名は「第56回｜東部地区｜テニス選手権」のように意味の切れ目でだけ折り返す（nameParts と <wbr>）。
//
// ■ 拡大表示（.tl__cards。下の1大会1ブロックの形）
//
//   大会名（左に赤い縦線）＋ 受付状態・登録区分のバッジ
//   日付（カレンダー印）／会場（地図のピン）
//   要項・申込用紙・ドロー・結果 の4つのボタン（素材の無いものは灰色で押せない）
//   備考（締切・予備日・荒天時の扱い・外部の申込先）
//
// ボタンの行き先：要項 → outline-<slug>.html、ドロー → draw-<slug>.html、結果 → result-<slug>.html（それぞれ独立したページ）、
// 申込用紙 → PDF を直接（別タブ）。素材の無い大会は4つとも押せない状態で出す（大会名から大会ページへは行ける）。
import Icon from './Icon.astro';
import { REG_LABEL, STATUS_LABEL, dateCell } from '../data/schedule.js';
import EventIcon from './EventIcon.astro';
import Venue from './Venue.astro';
import { eventIcons } from '../data/event-icons.js';
import { siteData } from '../lib/cms.js';
import { eventButtons } from '../data/event-buttons.js';

const { items, id, caption } = Astro.props;
const { eventForSchedule } = await siteData(Astro);

/** 日程。トップの大会カード・個別ページと同じ「2026.10.18 ＋ SUN」。期間・祝日は一言添える。 */
function dateText(t) {
  const c = dateCell(t);
  return { ymd: `${t.date.slice(0, 4)}.${c.md}`, dow: c.dow, note: c.note };
}

/** 備考の文言。締切・予備日・荒天時の扱い・外部の申込先を並べる。 */
function notes(t, e) {
  const list = [];
  if (t.due && t.due !== '—') list.push({ text: `エントリー締切 ${t.due}` });
  if (t.spareDate) list.push({ text: `予備日 ${t.spareDate}${t.spareVenue ? `（${t.spareVenue}）` : ''}` });
  else if (t.spareNote) list.push({ text: t.spareNote });
  if (e?.link) list.push({ text: e.link.label, href: e.link.url, external: true });
  return list;
}

/**
 * 大会名の折り返してよい位置。「第56回」「令和8年度」の後ろ、「テニス」「シングルス」などの前、「協会」の後ろ、「（」の前、空白の後ろ。
 * 例）第61回鳥取市テニス協会会長杯（春季） → 第61回｜鳥取市｜テニス協会｜会長杯｜（春季）
 * CSS（word-break: keep-all）で文字の途中では折り返さないので、ここで区切った位置でだけ行が変わる。
 */
const nameParts = (name) =>
  String(name ?? '').split(/(?<=第\d+回)|(?<=年度)|(?<=協会)|(?=（)|(?<=.)(?=テニス|シングルス|ダブルス|ミックス)|(?<=\s)/u).filter(Boolean);

/** 予備日の欄（予備日＋予備会場、無ければ補足） */
const spareText = (t) => (t.spareDate ? `${t.spareDate}${t.spareVenue ? `（${t.spareVenue}）` : ''}` : t.spareNote || '');

/** 縮小表示の項目（左から）。幅は CSS の --tlx-cols と同じ順 */
const COLS = ['大会名', '日程', '状態', '登録区分', '種目', '会場', '締切', '予備日', '要項', '申込用紙', 'ドロー', '結果', '備考'];

const rows = items.map((t) => {
  const e = eventForSchedule(t);
  return { t, e, date: dateText(t), buttons: eventButtons(e), notes: notes(t, e), badge: STATUS_LABEL[t.status], icons: eventIcons(t.event) };
});
// 会場名・種目名は文字の途中で折り返さない（CSS の word-break: keep-all）。
// 「／」「/」「・」の区切りの後ろと「（」の前にだけ折り返してよい位置（<wbr>）を入れる。テンプレート側で parts を <wbr> でつなぐ。
// 区切りの後ろ（／ / ・）と、開き括弧「（」の前で折り返してよい（括弧が行末に残らないように）
const parts = (text) => String(text ?? '').split(/(?<=[／/・])|(?=（)/);

---

<div class="tl tl--rows" id={id}>
  {/* ===== 縮小表示 ===== */}
  <div class="tlx" data-tlx>
    <p class="tlx__hint" aria-hidden="true"><span class="ln-arrow"></span>SCROLL</p>
    <div class="tlx__head" aria-hidden="true">
      <div class="tlx__row tlx__row--head">
        {COLS.map((c, i) => <span class:list={['tlx__cell', i === 0 && 'tlx__cell--name', i === 1 && 'tlx__cell--date']}>{c}</span>)}
      </div>
    </div>
    <div class="tlx__body" role="list" aria-label={caption}>
      {rows.map(({ t, e, date, buttons, badge }) => (
        <div
          class:list={['tlx__row', t.status === 'done' && 'tlx__row--done']}
          data-tags={`${t.status} ${t.reg}`}
          role="listitem"
        >
          <div class="tlx__cell tlx__cell--name">
            <span class="tlx__name">
              {e
                ? <a href={e.url}>{nameParts(t.name).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}</a>
                : nameParts(t.name).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}
            </span>
          </div>
          <div class="tlx__cell tlx__cell--date">
            <span class="tlx__y">{date.ymd.slice(0, 4)}</span>
            <span class="tlx__md">{date.ymd.slice(5)}</span>
            <span class="tlx__dow">{date.dow}</span>
          </div>
          <div class="tlx__cell"><span class="visually-hidden">状態：</span><span class={`badge ${badge.badge}`}>{badge.label}</span></div>
          <div class="tlx__cell"><span class="visually-hidden">登録区分：</span><span class={`reg reg--${t.reg}`}>{REG_LABEL[t.reg]}</span></div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">種目：</span>{parts(t.event).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}</div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">会場：</span><span><Venue text={t.place} breaks /></span>{date.note && <small class="tlx__sub">{date.note}</small>}</div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">締切：</span>{t.due && t.due !== '—' ? t.due : '—'}</div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">予備日：</span>{spareText(t) ? parts(spareText(t)).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>) : '—'}</div>
          {buttons.map((b) => (
            <div class="tlx__cell">
              {b.href
                ? <a class="btn btn--outline tl-btn tlx__btn" href={b.href} {...(b.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{b.label}</a>
                : <span class="btn tl-btn tl-btn--off tlx__btn" aria-disabled="true" title="準備中">{b.label}</span>}
            </div>
          ))}
          <div class="tlx__cell tlx__cell--text">
            <span class="visually-hidden">備考：</span>
            {e?.link ? <a class="ghost-link" href={e.link.url} target="_blank" rel="noopener noreferrer">{e.link.label}<span class="aw" aria-hidden="true">↗</span></a> : '—'}
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* ===== 拡大表示 ===== */}
  <div class="tl__cards" role="list" aria-label={caption}>
  {rows.map(({ t, e, date, buttons, notes, badge, icons }) => (
    <article
      class:list={['tl-item rv', t.status === 'done' && 'tl-item--done', t.status === 'open' && 'tl-item--open']}
      data-tags={`${t.status} ${t.reg}`}
      role="listitem"
    >
      <header class="tl-item__head">
        <span class="sec-head__mark" aria-hidden="true"></span>
        <h3 class="tl-item__title">
          {e ? <a href={e.url}>{t.name}</a> : t.name}
        </h3>
        <p class="tl-item__tags">
          <span class={`badge ${badge.badge}`}>{badge.label}</span>
          <span class={`reg reg--${t.reg}`}>{REG_LABEL[t.reg]}</span>
        </p>
      </header>

      {/* 1行目：日程と種目、2行目：会場とピクトグラム（種目の下） */}
      <div class="tl-item__info">
        <dl class="tl-item__meta">
          <div class="tl-item__row">
            <dt><Icon name="calendar" class="tl-item__ico" /><span class="visually-hidden">日程</span></dt>
            <dd class="tl-item__date">
              <span class="tl-item__ymd">{date.ymd}</span><span class="tl-item__dow">{date.dow}</span>
              {date.note && <span class="tl-item__date-note">{date.note}</span>}
            </dd>
          </div>
          <div class="tl-item__row">
            <dt><Icon name="pin" class="tl-item__ico" /><span class="visually-hidden">会場</span></dt>
            {/* 会場名は途中で折り返さない（.tl-item__place）。「／」「・」の区切りの後ろだけ折り返してよい（<wbr>） */}
            <dd class="tl-item__place"><Venue text={t.place} breaks /></dd>
          </div>
        </dl>
        <div class="tl-item__event">
          {icons.length > 0 && (
            <span class="tl-item__event-icons" data-n={icons.length} aria-hidden="true">
              {icons.map((ic) => <EventIcon icon={ic} />)}
            </span>
          )}
          <span class="tl-item__event-text"><Icon name="list" class="tl-item__ico" /><span class="visually-hidden">種目：</span><span class="tl-item__event-label">{parts(t.event).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}</span></span>
        </div>
      </div>

      <div class="tl-item__btns">
        {buttons.map((b) =>
          b.href
            ? <a class="btn btn--outline tl-btn" href={b.href} {...(b.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{b.label}<span class="aw" aria-hidden="true">{b.external ? '↗' : '→'}</span></a>
            : <span class="btn tl-btn tl-btn--off" aria-disabled="true" title="準備中">{b.label}</span>
        )}
      </div>

      {notes.length > 0 && (
        <div class="tl-item__note">
          <p class="tl-item__note-label">備考</p>
          <ul class="tl-item__note-list">
            {notes.map((n) => (
              <li>
                {n.href
                  ? <a class="ghost-link" href={n.href} target="_blank" rel="noopener noreferrer">{n.text}<span class="aw" aria-hidden="true">↗</span></a>
                  : n.text}
              </li>
            ))}
          </ul>
        </div>
      )}
    </article>
  ))}
  </div>
</div>
