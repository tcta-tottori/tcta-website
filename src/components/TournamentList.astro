---
// 大会一覧。src/lib/cms.js の SCHEDULE（schedule.js の形）をそのまま受け取る。
// 表示は2通り。大会情報ページの切り替えボタンで選ぶ（main.js の initViewSwitch。選んだ方を覚えておく）。
//
// ■ 縮小表示（初め。.tl--rows のとき .tlx を出す）
//   1大会1行の表。左端の「大会名」の列だけを固定し、右へ横スクロールすると
//   日程・状態・登録区分・種目・会場・締切・予備日（予備会場は「千代」「ヤマタ」のように短く）・要項／ドロー／結果 が順に見える。
//   項目名の行（.tlx__head）は下へスクロールしても画面の上端についてくる（横スクロールは本体と連動。main.js の initTlx）。
//   大会名は「第56回｜東部地区｜テニス選手権」のように意味の切れ目でだけ折り返す（nameParts と <wbr>）。
//
// ■ 拡大表示（.tl__cards）
//   トップの大会カード（TournamentCard.astro）と同じカードを、スマホは1列・タブレットは2列・PCは3列で並べる。
//   カードを押すとその大会のページへ（大会ページの無い大会は押せない）。
//
// 外部のページへ飛ばす大会（市民体育祭など。schedule.js の EXTERNAL_PAGES）は、大会名にはリンクを付けず、
// 要項の欄の「詳細」ボタンからだけそのページを別タブで開く。
// ボタンの行き先：要項 → outline-<slug>.html（申込用紙もこのページに載せる）、ドロー → draw-<slug>.html、結果 → result-<slug>.html。
// 素材の無い大会は3つとも押せない状態で出す（大会名から大会ページへは行ける）。
import { REG_LABEL, STATUS_LABEL, dateCell } from '../data/schedule.js';
import Venue from './Venue.astro';
import TournamentCard from './TournamentCard.astro';
import { siteData } from '../lib/cms.js';
import { eventButtons } from '../data/event-buttons.js';
import { CARD_STATUS } from '../data/tournaments.js';
import { winnerPhotos } from '../data/event-result.js';

const { items, id, caption } = Astro.props;
const { eventForSchedule } = await siteData(Astro);

/** 日程。トップの大会カード・個別ページと同じ「2026.10.18 ＋ SUN」。期間・祝日は一言添える。 */
function dateText(t) {
  const c = dateCell(t);
  return { ymd: `${t.date.slice(0, 4)}.${c.md}`, dow: c.dow, note: c.note };
}

/**
 * 大会名の折り返してよい位置。「第56回」「令和8年度」の後ろ、「テニス」「シングルス」などの前、「協会」の後ろ、「（」の前、空白の後ろ。
 * 例）第61回鳥取市テニス協会会長杯（春季） → 第61回｜鳥取市｜テニス協会｜会長杯｜（春季）
 * CSS（word-break: keep-all）で文字の途中では折り返さないので、ここで区切った位置でだけ行が変わる。
 */
const nameParts = (name) =>
  String(name ?? '').split(/(?<=第\d+回)|(?<=年度)|(?<=協会)|(?=（)|(?<=.)(?=テニス|シングルス|ダブルス|ミックス)|(?<=\s)/u).filter(Boolean);

/** 予備会場の短い呼び方（縮小表示の予備日の欄用）。鳥取市千代テニス場 → 千代、ヤマタスポーツパーク → ヤマタ */
const shortVenue = (v) =>
  String(v ?? '')
    .replace(/ヤマタスポーツパーク/g, 'ヤマタ')
    .replace(/^鳥取(市|県)/, '')
    .replace(/(公園)?テニス(場|コート)$/, '');

/** 予備日の欄（予備日＋短い予備会場、無ければ補足） */
const spareText = (t) => (t.spareDate ? `${t.spareDate}${t.spareVenue ? `（${shortVenue(t.spareVenue)}）` : ''}` : t.spareNote || '');

/** 縮小表示の項目（左から）。幅は CSS の --tlx-cols と同じ順 */
const COLS = ['大会名', '日程', '状態', '登録区分', '種目', '会場', '締切', '予備日', '要項', 'ドロー', '結果'];

const rows = items.map((t) => {
  const e = eventForSchedule(t);
  // 外部のページへ飛ばす大会は、要項のボタンを「詳細」にしてそのページを開く
  const buttons = eventButtons(e, { outline: t.externalUrl })
    .map((b) => (!e && t.externalUrl && b.key === 'outline' ? { ...b, label: '詳細' } : b));
  // 拡大表示のカード（トップの大会カードと同じ形。src/data/tournaments.js の buildCards を参照）
  const card = {
    date: t.date.replace(/-/g, '.'),
    title: t.name,
    event: t.event,
    venue: t.place,
    status: CARD_STATUS[t.status] ?? 'soon',
    reg: t.reg,
    due: t.due && t.due !== '—' ? t.due : '',
    action: { href: e ? e.url : null },
    buttons,
    winners: winnerPhotos(e),
  };
  return { t, e, date: dateText(t), buttons, badge: STATUS_LABEL[t.status], card };
});
// 会場名・種目名は文字の途中で折り返さない（CSS の word-break: keep-all）。
// 「／」「/」「・」の区切りの後ろと「（」の前にだけ折り返してよい位置（<wbr>）を入れる。テンプレート側で parts を <wbr> でつなぐ。
// 区切りの後ろ（／ / ・）と、開き括弧「（」の前で折り返してよい（括弧が行末に残らないように）
const parts = (text) => String(text ?? '').split(/(?<=[／/・])|(?=（)/);

---

<div class="tl tl--rows" id={id}>
  {/* ===== 縮小表示 ===== */}
  <div class="tlx" data-tlx>
    <p class="tlx__hint" aria-hidden="true"><span class="ln-arrow"></span>SCROLL</p>
    <div class="tlx__head" aria-hidden="true">
      <div class="tlx__row tlx__row--head">
        {COLS.map((c, i) => <span class:list={['tlx__cell', i === 0 && 'tlx__cell--name', i === 1 && 'tlx__cell--date']}>{c}</span>)}
      </div>
    </div>
    <div class="tlx__body" role="list" aria-label={caption}>
      {rows.map(({ t, e, date, buttons, badge }) => (
        <div
          class:list={['tlx__row', t.status === 'done' && 'tlx__row--done']}
          data-tags={`${t.status} ${t.reg}`}
          role="listitem"
        >
          <div class="tlx__cell tlx__cell--name">
            <span class="tlx__name">
              {e
                ? <a href={e.url}>{nameParts(t.name).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}</a>
                : nameParts(t.name).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}
            </span>
          </div>
          <div class="tlx__cell tlx__cell--date">
            <span class="tlx__y">{date.ymd.slice(0, 4)}</span>
            <span class="tlx__md">{date.ymd.slice(5)}</span>
            <span class="tlx__dow">{date.dow}</span>
          </div>
          <div class="tlx__cell"><span class="visually-hidden">状態：</span><span class={`badge ${badge.badge}`}>{badge.label}</span></div>
          <div class="tlx__cell"><span class="visually-hidden">登録区分：</span><span class={`reg reg--${t.reg}`}>{REG_LABEL[t.reg]}</span></div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">種目：</span>{parts(t.event).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>)}</div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">会場：</span><span><Venue text={t.place} breaks /></span></div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">締切：</span>{t.due && t.due !== '—' ? t.due : '—'}</div>
          <div class="tlx__cell tlx__cell--text"><span class="visually-hidden">予備日：</span>{spareText(t) ? parts(spareText(t)).map((part, i, arr) => <>{part}{i < arr.length - 1 && <wbr />}</>) : '—'}</div>
          {buttons.map((b) => (
            <div class="tlx__cell">
              {b.href
                ? <a class="btn btn--outline tl-btn tlx__btn" href={b.href} {...(b.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{b.label}</a>
                : <span class="btn tl-btn tl-btn--off tlx__btn" aria-disabled="true" title="準備中">{b.label}</span>}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  {/* ===== 拡大表示（トップの大会カードと同じカードを並べる） ===== */}
  <div class="tl__cards" role="list" aria-label={caption}>
    {rows.map(({ t, card }) => (
      <div class="tl__card" data-tags={`${t.status} ${t.reg}`} role="listitem">
        <TournamentCard tournament={card} />
      </div>
    ))}
  </div>
</div>
