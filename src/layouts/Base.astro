---
import SiteHeader from '../components/SiteHeader.astro';
import MobileNav from '../components/MobileNav.astro';
import Cta from '../components/Cta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteSplash from '../components/SiteSplash.astro';

interface Props {
  title: string;
  description: string;
  /** サイトを開いたときのオープニング映像を出すか（トップページのみ） */
  splash?: boolean;
  /** トップページかどうか。ナビのアンカーがページ内リンクになる */
  home?: boolean;
  /** ヘッダーナビの現在地 */
  navActive?: string;
  /** モバイルナビの現在地 */
  mobileNavActive?: string;
}

const {
  title,
  description,
  splash = false,
  home = false,
  navActive,
  mobileNavActive,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{/* 協会ロゴ（白地・黒文字）をそのままアイコンに使っている。
    差し替えるときは public/assets/img/ の3枚をまとめて作り直すこと。 */}
<link rel="icon" href="assets/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="assets/img/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Jost:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
{splash && (
  <script is:inline>
    /* オープニングを出すかどうかを、本文が描かれる前に決める。
       出す場合だけ html に .splash-on を付ける（＝JS が無効なら決して出ない）。
       ページを移動するたびに流れると煩わしいので、1セッションにつき1回だけにする。
       毎回出したい場合は、この sessionStorage の判定を外せばよい。 */
    (function () {
      var seen = false;
      try { seen = sessionStorage.getItem('tcta-splash') === 'done'; } catch (e) {}
      var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!seen && !calm) document.documentElement.classList.add('splash-on');
    })();
  </script>
)}
</head>
<body>
{splash && <SiteSplash />}

<a class="skip-link" href="#main">本文へスキップ</a>

<SiteHeader active={navActive} onHome={home} />

<MobileNav active={mobileNavActive} />

<main id="main">
  <slot />
  <Cta />
</main>

<SiteFooter />

<script src="assets/js/main.js" defer is:inline></script>
</body>
</html>
