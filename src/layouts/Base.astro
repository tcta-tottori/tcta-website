---
import SiteHeader from '../components/SiteHeader.astro';
import MobileNav from '../components/MobileNav.astro';
import Cta from '../components/Cta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteSplash from '../components/SiteSplash.astro';
import ImportantNotice from '../components/ImportantNotice.astro';
/* CSS と JS の URL に中身のハッシュを付ける。
   ファイル名を変えずに更新しているので、これが無いと古い CSS が
   ブラウザのキャッシュから使われ、新しい HTML と噛み合わずに崩れる。
   値は astro.config.mjs がビルド時に計算して __ASSET_V__ に埋め込む
   （Workers の実行時には public/ のファイルを読めないため）。 */
/* global __ASSET_V__ */
const CSS = `assets/css/style.css?v=${__ASSET_V__.css}`;
const JS = `assets/js/main.js?v=${__ASSET_V__.js}`;

interface Props {
  title: string;
  description: string;
  /** サイトを開いたときのオープニング映像を出すか（トップページのみ） */
  splash?: boolean;
  /** トップページかどうか。ナビのアンカーがページ内リンクになる */
  home?: boolean;
  /** ヘッダーナビの現在地 */
  navActive?: string;
  /** モバイルナビの現在地 */
  mobileNavActive?: string;
}

const {
  title,
  description,
  splash = false,
  home = false,
  navActive,
  mobileNavActive,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{/* 協会ロゴ（白地・黒文字）をそのままアイコンに使っている。
    差し替えるときは public/assets/img/ の3枚をまとめて作り直すこと。 */}
<link rel="icon" href="assets/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="assets/img/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Jost:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href={CSS}>
<script is:inline>
  /* メニューから別のページへ移るときの切り替え（style.css の @view-transition。対応ブラウザのみ）。
     メニューのリンクを押すと main.js が sessionStorage に印を付けてそのまま移動する。
     ブラウザは次のページが描ける状態になるまで前のページ（メニューが開いたまま）を見せ続け、
     描ける状態になったら前のページの「メニューの行・白い下地・ヘッダー」の写しを次のページの上に重ね、
     行が順にヘッダーの下へ戻る動きを流す（CSS の ::view-transition-old(mn-item-*)）。
     印が無い移動（通常のリンク・戻る）では切り替えを省き、これまでどおり即座に表示する。 */
  (function () {
    var KEY = 'tcta-mn-vt';          // メニューから
    var COURT = 'tcta-court-vt';     // コート案内の行から（値は施設の id。写真と施設名をつないで移る）
    var get = function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } };
    var del = function (k) { try { sessionStorage.removeItem(k); } catch (e) {} };
    window.addEventListener('pageswap', function (e) {
      if (e.viewTransition && get(KEY) !== '1' && !get(COURT)) e.viewTransition.skipTransition();
    });
    window.addEventListener('pagereveal', function (e) {
      if (!e.viewTransition) return;
      var court = get(COURT);
      if (get(KEY) === '1') {
        del(KEY);
        if (e.viewTransition.types) e.viewTransition.types.add('menu');
      } else if (court) {
        del(COURT);
        var art = document.getElementById(court);
        var img = art && art.querySelector('.cfac__hero-link img');
        var name = art && art.querySelector('.cfac__name');
        if (!art || !img) { e.viewTransition.skipTransition(); return; }
        art.scrollIntoView();  // 写しを撮る前に、その施設が画面に入る位置へ
        art.classList.add('on', 'cfac--vt');  // その施設はすぐ見せる（文字の滑り出しと写真のズームは流さない。style.css）
        img.style.viewTransitionName = 'court-photo';
        if (name) name.style.viewTransitionName = 'court-name';
        if (e.viewTransition.types) e.viewTransition.types.add('court');
        var clear = function () { img.style.viewTransitionName = ''; if (name) name.style.viewTransitionName = ''; };
        e.viewTransition.finished.then(clear, clear);
      } else {
        e.viewTransition.skipTransition();
      }
    });
  })();
</script>
{splash && (
  <script is:inline>
    /* オープニングを出すかどうかを、本文が描かれる前に決める。
       出す場合だけ html に .splash-on を付ける（＝JS が無効なら決して出ない）。
       ページを移動するたびに流れると煩わしいので、1セッションにつき1回だけにする。
       毎回出したい場合は、この sessionStorage の判定を外せばよい。 */
    (function () {
      var seen = false;
      try { seen = sessionStorage.getItem('tcta-splash') === 'done'; } catch (e) {}
      var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!seen && !calm) document.documentElement.classList.add('splash-on');
    })();
  </script>
)}
</head>
<body>
{splash && <SiteSplash />}

<a class="skip-link" href="#main">本文へスキップ</a>

<SiteHeader active={navActive} onHome={home} />

<ImportantNotice />

{/* 現在地の赤文字：ページが mobileNavActive を渡していなければ navActive（PC ナビの現在地）を使う */}
<MobileNav active={mobileNavActive ?? navActive} />

<main id="main">
  <slot />
  <Cta />
</main>

<SiteFooter />

<script src={JS} defer is:inline></script>
</body>
</html>
