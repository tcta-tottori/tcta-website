---
import NoticeBar from '../components/NoticeBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MobileNav from '../components/MobileNav.astro';
import Cta from '../components/Cta.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** 通知バーを表示するか */
  notice?: boolean;
  /** ヘッダーをヒーロー写真の上に透過表示するか（トップページのみ） */
  overlay?: boolean;
  /** トップページかどうか。ナビのアンカーがページ内リンクになる */
  home?: boolean;
  /** ヘッダーナビの現在地 */
  navActive?: string;
  /** モバイルナビの現在地 */
  mobileNavActive?: string;
}

const {
  title,
  description,
  notice = false,
  overlay = false,
  home = false,
  navActive,
  mobileNavActive,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">本文へスキップ</a>

{notice && <NoticeBar />}

<SiteHeader active={navActive} overlay={overlay} onHome={home} />

<MobileNav active={mobileNavActive} />

<main id="main">
  <slot />
  <Cta />
</main>

<SiteFooter />

<script src="assets/js/main.js" defer is:inline></script>
</body>
</html>
