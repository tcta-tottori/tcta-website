---
import SiteHeader from '../components/SiteHeader.astro';
import MobileNav from '../components/MobileNav.astro';
import Cta from '../components/Cta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteSplash from '../components/SiteSplash.astro';
import ImportantNotice from '../components/ImportantNotice.astro';
import { siteData } from '../lib/cms.js';
import { LINE_OFFICIAL } from '../data/links.js';
/* CSS と JS の URL に中身のハッシュを付ける。
   ファイル名を変えずに更新しているので、これが無いと古い CSS が
   ブラウザのキャッシュから使われ、新しい HTML と噛み合わずに崩れる。
   値は astro.config.mjs がビルド時に計算して __ASSET_V__ に埋め込む
   （Workers の実行時には public/ のファイルを読めないため）。 */
/* global __ASSET_V__ */
const CSS = `assets/css/style.css?v=${__ASSET_V__.css}`;
const JS = `assets/js/main.js?v=${__ASSET_V__.js}`;

interface Props {
  title: string;
  description: string;
  /** サイトを開いたときのオープニング映像を出すか（トップページのみ） */
  splash?: boolean;
  /** トップページかどうか。ナビのアンカーがページ内リンクになる */
  home?: boolean;
  /** ヘッダーナビの現在地 */
  navActive?: string;
  /** モバイルナビの現在地 */
  mobileNavActive?: string;
  /** SNS で共有したときの画像（サイト内の相対パス）。無ければ共通の画像（assets/img/ogp.jpg） */
  image?: string;
  /** og:type。大会ページなどは article */
  ogType?: string;
  /** 検索に出さない（404 など） */
  noindex?: boolean;
  /** ページ固有の構造化データ（JSON-LD。schema.org のオブジェクト）。大会ページの SportsEvent など */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  splash = false,
  home = false,
  navActive,
  mobileNavActive,
  // 本文の末尾の入会への誘い（Cta）を出すか。入会案内のページ自身では出さない
  cta = true,
  image,
  ogType,
  noindex = false,
  jsonLd,
} = Astro.props;

/* ---- 検索エンジン・SNS 向け ----
   公開アドレスは astro.config.mjs の site（本番のドメインに切り替えるときはそこだけ直す）。
   代表アドレス（canonical）は、そのページの公開アドレス。トップは / にそろえる（/index.html と同じページのため）。 */
const SITE_NAME = '鳥取市テニス協会';
const site = Astro.site ?? new URL(Astro.url.origin);
const path = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname;
const canonical = new URL(path, site).href;
const ogImage = new URL(image ?? 'assets/img/ogp.jpg', site).href;
const isHome = path === '/';
// 公開アドレス以外（独自ドメインに移ったあとの workers.dev など）で見られたページは、検索に出さない（同じ内容が2つ並ばないように）
const offSite = !!Astro.site && Astro.url.hostname !== Astro.site.hostname && !/^(localhost|127\.0\.0\.1)$/.test(Astro.url.hostname);
// 協会の公式アカウント（構造化データの sameAs）。管理画面のサイト設定の SNS と LINE 公式アカウント
let sameAs: string[] = [];
try {
  const { SOCIAL = [] } = await siteData(Astro);
  sameAs = [...SOCIAL.map((x) => x.url), LINE_OFFICIAL.url].filter((u) => /^https?:\/\//.test(String(u)));
} catch { /* 読めないときは無し */ }
const orgLd = {
  '@type': 'SportsOrganization',
  '@id': new URL('/#organization', site).href,
  name: SITE_NAME,
  alternateName: ['TOTTORI-CITY TENNIS ASSOCIATION', 'TCTA'],
  url: new URL('/', site).href,
  logo: new URL('assets/img/logo.png', site).href,
  sport: 'Tennis',
  areaServed: { '@type': 'City', name: '鳥取市' },
  address: { '@type': 'PostalAddress', addressRegion: '鳥取県', addressLocality: '鳥取市', addressCountry: 'JP' },
  ...(sameAs.length ? { sameAs } : {}),
};
const graph = [
  orgLd,
  ...(isHome ? [{
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    name: SITE_NAME,
    alternateName: 'TOTTORI-CITY TENNIS ASSOCIATION',
    url: new URL('/', site).href,
    inLanguage: 'ja',
    publisher: { '@id': orgLd['@id'] },
  }] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const ldJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>
  /* 軽量モード（ページの動きを最小限にして、スマホなどに負荷をかけにくくする）。
     オープニングの「軽量モードで見る」とトップのスイッチで切り替え、端末に覚えておく（localStorage の tcta-lite）。
     描く前に html.is-lite を付ける（style.css・main.js がこれを見る）。 */
  try { if (localStorage.getItem('tcta-lite') === '1') document.documentElement.classList.add('is-lite'); } catch (e) {}
</script>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{(noindex || offSite) && <meta name="robots" content="noindex">}
{/* SNS（LINE・X・Facebook など）で共有したときの表示 */}
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:type" content={ogType ?? (isHome ? 'website' : 'article')}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
{!image && <meta property="og:image:width" content="1200">}
{!image && <meta property="og:image:height" content="630">}
<meta property="og:image:alt" content={SITE_NAME}>
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#ffffff">
<meta name="format-detection" content="telephone=no">
{/* アイコン。協会ロゴの頭（「T.T」と赤い四角）を正方形にしたもの。小さくても読めるよう、ロゴ全体ではなくこの部分だけにしている。
    作り直すときは public/favicon.ico と public/assets/img/ の favicon-32/48/192・icon-512・apple-touch-icon をまとめて */}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="assets/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="assets/img/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{/* 構造化データ（Google が協会・サイト・大会を理解するための情報） */}
<script type="application/ld+json" set:html={ldJson} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Jost:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href={CSS}>
<script is:inline>
  /* メニューから別のページへ移るときの切り替え（style.css の @view-transition。対応ブラウザのみ）。
     メニューのリンクを押すと main.js が sessionStorage に印を付けてそのまま移動する。
     ブラウザは次のページが描ける状態になるまで前のページ（メニューが開いたまま）を見せ続け、
     描ける状態になったら前のページの「メニュー（黒地）」の写しを次のページの上に重ね、
     黒地が下へ下がって次のページが見えてくる動きを流す（CSS の ::view-transition-old(mn-sheet)）。
     印が無い移動（通常のリンク・戻る）では切り替えを省き、これまでどおり即座に表示する。 */
  (function () {
    var KEY = 'tcta-mn-vt';          // メニューから
    var COURT = 'tcta-court-vt';     // コート案内の行から（値は施設の id。写真と施設名をつないで移る）
    var LINKS = 'tcta-links-vt';     // トップのリンク集の VIEW ALL から（並べ替えたバナーを、リンク集の同じバナーへつなぐ）
    var get = function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } };
    var del = function (k) { try { sessionStorage.removeItem(k); } catch (e) {} };
    // トップのリンク集の VIEW ALL から来たとき（と、そのとき裏で読み込む測定用の iframe）は、ページの出現の動きを止めて
    // 並べ替えたバナーの位置にそのまま出す（html.is-links-arrive。style.css・main.js の initReveal）
    if (get(LINKS) === '1' || location.hash === '#lk-arrive') {
      document.documentElement.classList.add('is-links-arrive');
      if (location.hash !== '#lk-arrive') del(LINKS);
    }
    /* メニューから移るときの協会ロゴ。黒地の写し（mn-sheet）は次のページのヘッダーごと覆うので、そのままだと
       閉じ始めの一瞬ロゴが隠れる。ロゴにも写しの名前（site-logo）を付けて黒地より前に出し、
       前のページの白いロゴ（old）を黒地と同じ動きで上から削り、下から次のページの黒いロゴ（new）を見せる（style.css）。
       名前を付けたあいだはロゴの塗り分け（backdrop-filter）が効かないので、画像のロゴに差し替えておく（.is-vt-logo） */
    var logoFor = function (on) {
      var hd = document.querySelector('.site-header');
      var lg = hd && hd.querySelector('.site-header__logo');
      if (!lg) return null;
      hd.classList.toggle('is-vt-logo', on);
      lg.style.viewTransitionName = on ? 'site-logo' : '';
      return lg;
    };
    window.addEventListener('pageswap', function (e) {
      if (e.viewTransition && document.documentElement.classList.contains('is-lite')) { e.viewTransition.skipTransition(); return; } // 軽量モード
      if (e.viewTransition && get(KEY) !== '1' && !get(COURT) && !document.documentElement.classList.contains('is-lk-leaving')) e.viewTransition.skipTransition();
      else if (e.viewTransition && get(KEY) === '1' && document.querySelector('.site-header.is-menu')) logoFor(true);
    });
    // 戻る（bfcache）で前のページに帰ってきたときは元に戻す
    window.addEventListener('pageshow', function (e) { if (e.persisted) logoFor(false); });
    window.addEventListener('pagereveal', function (e) {
      if (!e.viewTransition) return;
      if (document.documentElement.classList.contains('is-lite')) { e.viewTransition.skipTransition(); return; } // 軽量モード
      var court = get(COURT);
      if (get(KEY) === '1') {
        del(KEY);
        if (e.viewTransition.types) e.viewTransition.types.add('menu');
        var lg = logoFor(true);
        if (lg) {
          // 白いロゴを削る位置を、黒地の上端と揃える（ロゴの上端から見た、黒地の上端の始まりと終わり）
          var top = lg.getBoundingClientRect().top;
          var root = document.documentElement.style;
          root.setProperty('--vt-logo-from', (-top) + 'px');
          root.setProperty('--vt-logo-to', (window.innerHeight - top) + 'px');
          var off = function () { logoFor(false); };
          e.viewTransition.finished.then(off, off);
        }
      } else if (document.documentElement.classList.contains('is-links-arrive')) {
        // トップのリンク集から：並べ替えたバナーの上に重ねた同じ見た目のページから、そのまま切り替える（動きは足さない）
        if (e.viewTransition.types) e.viewTransition.types.add('links');
      } else if (court) {
        del(COURT);
        var art = document.getElementById(court);
        var img = art && art.querySelector('.cfac__hero-link img');
        var name = art && art.querySelector('.cfac__name');
        if (!art || !img) { e.viewTransition.skipTransition(); return; }
        art.scrollIntoView();  // 写しを撮る前に、その施設が画面に入る位置へ
        art.classList.add('on', 'cfac--vt');  // その施設はすぐ見せる（文字の滑り出しと写真のズームは流さない。style.css）
        img.style.viewTransitionName = 'court-photo';
        if (name) name.style.viewTransitionName = 'court-name';
        if (e.viewTransition.types) e.viewTransition.types.add('court');
        var clear = function () { img.style.viewTransitionName = ''; if (name) name.style.viewTransitionName = ''; };
        e.viewTransition.finished.then(clear, clear);
      } else {
        e.viewTransition.skipTransition();
      }
    });
  })();
</script>
{splash && (
  <script is:inline>
    /* オープニングを出すかどうかを、本文が描かれる前に決める。
       出す場合だけ html に .splash-on を付ける（＝JS が無効なら決して出ない）。
       ページを移動するたびに流れると煩わしいので、1セッションにつき1回だけにする。
       毎回出したい場合は、この sessionStorage の判定を外せばよい。 */
    (function () {
      var seen = false;
      try { seen = sessionStorage.getItem('tcta-splash') === 'done'; } catch (e) {}
      var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var lite = document.documentElement.classList.contains('is-lite');
      if (!seen && !calm && !lite) document.documentElement.classList.add('splash-on');
    })();
  </script>
)}
</head>
<body>
{splash && <SiteSplash />}

<a class="skip-link" href="#main">本文へスキップ</a>

<SiteHeader active={navActive} onHome={home} />

<ImportantNotice />

{/* 現在地の赤文字：ページが mobileNavActive を渡していなければ navActive（PC ナビの現在地）を使う */}
<MobileNav active={mobileNavActive ?? navActive} />

<main id="main">
  <slot />
  {cta && <Cta />}
</main>

<SiteFooter />

<script src={JS} defer is:inline></script>
</body>
</html>
